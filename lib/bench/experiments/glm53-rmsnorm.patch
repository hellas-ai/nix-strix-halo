+# SPDX-License-Identifier: Apache-2.0
+"""Fuse ROCm RMSNorm's final multiplies, retaining native FP32 statistics."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _rmsnorm_multiply(X, W, INV, Y, N: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    col = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    x = tl.load(X + row * N + col, col < N, 0).to(tl.float32)
+    w = tl.load(W + col, col < N, 0).to(tl.float32)
+    inverse_rms = tl.load(INV + row)
+    tl.store(Y + row * N + col, (x * inverse_rms) * w, col < N)
+
+
+def rmsnorm(x, weight, eps):
+    # Keep the exact native reduction and rsqrt calls. Replacing these with
+    # Triton changed BF16 rounding enough to regress full-model cache checks.
+    variance = x.float().pow(2).mean(dim=-1, keepdim=True)
+    inverse_rms = torch.rsqrt(variance + eps)
+    output = torch.empty_like(x)
+    _rmsnorm_multiply[(x.shape[0], triton.cdiv(x.shape[1], 256))](
+        x,
+        weight,
+        inverse_rms,
+        output,
+        x.shape[1],
+        256,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return output
