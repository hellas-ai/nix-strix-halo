+  HIP_CHECK(hipMemcpy(&outside_width, base + operation_extent.width, 1, hipMemcpyDeviceToHost));
+  HIP_CHECK(hipMemcpy(&outside_height, base + allocation.pitch * operation_extent.height, 1,
