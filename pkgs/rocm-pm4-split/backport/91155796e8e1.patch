diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_graph_command_encoder.h b/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_graph_command_encoder.h
new file mode 100644
index 000000000000..dcadead2ec36
--- /dev/null
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_graph_command_encoder.h
@@ -0,0 +1,425 @@
+/*
