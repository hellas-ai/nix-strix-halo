+  ASSERT_EQ(encoder.dispatch_count(), 2u);
+  ASSERT_EQ(encoder.words().size(), expected.size());
+  EXPECT_TRUE(std::equal(encoder.words().begin(), encoder.words().end(), expected.begin()));
+}
