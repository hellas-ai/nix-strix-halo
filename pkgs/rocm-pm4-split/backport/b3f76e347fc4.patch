From b3f76e347fc4970ffe3a260403e0f1fcb063b72b Mon Sep 17 00:00:00 2001
From: Piotr Wilkin <piotr.wilkin@syndatis.com>
Date: Thu, 3 Sep 2026 00:08:29 +0200
Subject: [PATCH] ROCr: fix gfx1201 retained PM4 register programming

Use the GC 12.0 compute register map, batch shader register writes with SET_SH_REG_PAIRS, and fall back for unsupported GFX12 minor versions. Extend encoder and high-scratch graph coverage for the failure mode.

Assisted-by: Codex
---
 .../graph/hipGraphCollapseCorrectness.cc      |  6 +-
 .../graph/graph_command_encoder_test.cc       | 29 ++++----
 .../core/inc/amd_graph_command_encoder.h      | 66 +++++++++----------
 3 files changed, 48 insertions(+), 53 deletions(-)

diff --git a/projects/hip-tests/catch/performance/scenarios/graph/hipGraphCollapseCorrectness.cc b/projects/hip-tests/catch/performance/scenarios/graph/hipGraphCollapseCorrectness.cc
index b84d67960008..20a9ab28f93e 100644
--- a/projects/hip-tests/catch/performance/scenarios/graph/hipGraphCollapseCorrectness.cc
+++ b/projects/hip-tests/catch/performance/scenarios/graph/hipGraphCollapseCorrectness.cc
@@ -68,8 +68,8 @@ __global__ void k_add_value(int* value, int addend) { value[0] = value[0] + adde
 __global__ void k_atomic_increment(int* value) { atomicAdd(value, 1); }
 
 __global__ void k_private_increment(int* value, int selector) {
-  volatile int scratch[8];
-  const int slot = (selector + static_cast<int>(threadIdx.x)) & 7;
+  volatile int scratch[528];
+  const int slot = (selector + static_cast<int>(threadIdx.x)) % 528;
   scratch[slot] = value[0] + 1;
   if (threadIdx.x == 0) {
     value[0] = scratch[slot];
@@ -478,7 +478,7 @@ TEST_CASE("Performance_Graph_Pm4QueueScratch") {
   HIP_CHECK(hipFuncGetAttributes(&attributes,
                                  reinterpret_cast<const void*>(k_private_increment)));
   INFO("private bytes=" << attributes.localSizeBytes);
-  REQUIRE(attributes.localSizeBytes > 0);
+  REQUIRE(attributes.localSizeBytes >= 528 * sizeof(int));
 
   int* device_value = nullptr;
   HIP_CHECK(hipMalloc(&device_value, sizeof(*device_value)));
diff --git a/projects/rocr-runtime/rocrtst/suites/functional/graph/graph_command_encoder_test.cc b/projects/rocr-runtime/rocrtst/suites/functional/graph/graph_command_encoder_test.cc
