+// Keep this byte parser separate from readEnv<int>, which uses permissive atoi.
+// Do not log from the constructor: logging itself depends on env().
+static unsigned int readIbTrafficClass() {
+  const char* value = getenv("MSCCLPP_IB_TC");
+  if (value == nullptr) return 0;
+  const auto invalid = []() {
+    throw mscclpp::Error("MSCCLPP_IB_TC must be decimal digits in [0,255]", mscclpp::ErrorCode::InvalidUsage);
+  };
+  if (*value == '\0') invalid();
+  unsigned int result = 0;
+  for (const char* p = value; *p != '\0'; ++p) {
+    if (*p < '0' || *p > '9') invalid();
+    // result is at most 255 before each step, so the multiplication cannot overflow.
+    result = result * 10 + static_cast<unsigned int>(*p - '0');
+    if (result > 255) invalid();
+  }
+  return result;
+}
