@@ -82,3 +82,24 @@ def test_atomic_rank_file_manifest_and_restore(tmp_path: Path):
+def test_nonassigning_restore_streams_without_load_state_dict(
+    tmp_path: Path, monkeypatch
+):
+    model = nn.Linear(4, 3)
+    expected = {name: tensor.detach().clone() for name, tensor in model.state_dict().items()}
+    cache = _cache(tmp_path)
+    assert cache.store(model)
+
+    with torch.no_grad():
+        for parameter in model.parameters():
+            parameter.zero_()
+
+    def forbidden_load_state_dict(*args, **kwargs):
+        raise AssertionError("streamed non-assigning restore must copy directly")
+
+    monkeypatch.setattr(model, "load_state_dict", forbidden_load_state_dict)
+    assert cache.restore(model, target_device=torch.device("cpu"), assign=False)
+    for name, tensor in model.state_dict().items():
+        torch.testing.assert_close(tensor, expected[name], rtol=0, atol=0)
+
