+# SPDX-License-Identifier: Apache-2.0
+"""MiniMax H3 derived rank-local weight cache contracts."""
+
+from __future__ import annotations
+
+import json
+import multiprocessing
+from datetime import timedelta
+from pathlib import Path
+
+import pytest
+import torch
+import torch.distributed as dist
+from torch import nn
+from torch.distributed.device_mesh import init_device_mesh
+from torch.distributed.tensor import DTensor, Replicate, Shard
+
+from sglang.multimodal_gen.runtime.loader.minimax_h3_rank_weight_cache import (
+    MINIMAX_H3_RANK_WEIGHT_CACHE_ABI,
+    MINIMAX_H3_RANK_WEIGHT_CACHE_DIR_ENV,
+    MINIMAX_H3_RANK_WEIGHT_CACHE_SCHEMA,
+    MINIMAX_H3_RANK_WEIGHT_CACHE_STAGING_DIR_ENV,
+    MiniMaxH3RankWeightCache,
+    _canonical_identity,
+    _configured_root,
+    _supported_rank_launch,
+    create_minimax_h3_rank_weight_cache,
+)
+
+
+def _cache(
+    root: Path,
+    *,
+    relative: str = "unit-cache",
+    rank: int = 0,
+    world_size: int = 1,
+    read: bool = True,
+    stage: bool = True,
+) -> MiniMaxH3RankWeightCache:
+    return MiniMaxH3RankWeightCache(
+        read_root=root if read else None,
+        staging_root=root if stage else None,
+        relative_dir=Path(relative),
+        base_metadata={
+            "schema": MINIMAX_H3_RANK_WEIGHT_CACHE_SCHEMA,
+            "abi": MINIMAX_H3_RANK_WEIGHT_CACHE_ABI,
+            "model_revision": "a" * 40,
+            "component": "test",
+            "component_path": "FL2VA/test",
+            "world_size": str(world_size),
+            "dtype_policy": "float32",
+        },
+        rank=rank,
+        world_size=world_size,
+    )
+
+
+def test_atomic_rank_file_manifest_and_restore(tmp_path: Path):
+    model = nn.Linear(4, 3)
+    expected = {name: tensor.detach().clone() for name, tensor in model.state_dict().items()}
+    cache = _cache(tmp_path)
+
+    assert cache.store(model)
+    assert cache.read_dir is not None
+    entries = list(cache.read_dir.iterdir())
+    assert sum(path.name == "complete.json" for path in entries) == 1
+    assert sum(path.suffix == ".safetensors" for path in entries) == 1
+    assert not any("partial" in path.name for path in entries)
+
+    with torch.no_grad():
+        for parameter in model.parameters():
+            parameter.zero_()
+    assert cache.restore(model, target_device=torch.device("cpu"), assign=False)
+    for name, tensor in model.state_dict().items():
+        torch.testing.assert_close(tensor, expected[name], rtol=0, atol=0)
+
+
+def test_restore_moves_ordinary_state_to_explicit_target_device(tmp_path: Path):
+    model = nn.Linear(4, 3)
+    cache = _cache(tmp_path)
+
+    assert cache.store(model)
+    assert cache.restore(
+        model,
+        target_device=torch.device("meta"),
+        assign=True,
+    )
+    assert {tensor.device.type for tensor in model.state_dict().values()} == {"meta"}
+
+
+def test_manifest_mismatch_falls_back_without_touching_model(tmp_path: Path):
+    model = nn.Linear(2, 2, bias=False)
+    cache = _cache(tmp_path)
+    assert cache.store(model)
+    assert cache.read_dir is not None
+    manifest_path = cache.read_dir / "complete.json"
+    manifest = json.loads(manifest_path.read_text())
+    manifest["metadata"]["abi"] = "wrong"
+    manifest_path.write_text(json.dumps(manifest))
+
+    with torch.no_grad():
+        model.weight.fill_(17)
+    assert not cache.restore(model, target_device=torch.device("cpu"), assign=False)
+    torch.testing.assert_close(model.weight, torch.full_like(model.weight, 17))
+
+
+def test_read_only_cache_never_writes(tmp_path: Path):
+    model = nn.Linear(2, 2)
+    cache = _cache(tmp_path, read=True, stage=False)
+    assert not cache.store(model)
+    assert not (tmp_path / "unit-cache").exists()
+
+
+def test_staging_root_rejects_paths_outside_artifact_tree(monkeypatch):
+    monkeypatch.setenv(
+        MINIMAX_H3_RANK_WEIGHT_CACHE_STAGING_DIR_ENV,
+        "/models/.cache/hellas/h3-rank-shards",
+    )
+    with pytest.raises(ValueError, match="must resolve within"):
+        _configured_root(MINIMAX_H3_RANK_WEIGHT_CACHE_STAGING_DIR_ENV, write=True)
+
+
+def test_canonical_identity_preserves_snapshot_revision_for_blob_symlink(
+    tmp_path: Path,
+):
+    revision = "b" * 40
+    snapshot_component = tmp_path / "snapshots" / revision / "FL2VA" / "transformer"
+    blob = tmp_path / "blobs" / "weight"
+    snapshot_component.mkdir(parents=True)
+    blob.parent.mkdir()
+    blob.write_bytes(b"weight")
+    weight = snapshot_component / "model.safetensors"
+    weight.symlink_to(blob)
+
+    assert _canonical_identity([weight]) == (revision, "FL2VA/transformer")
+
+
+def _set_internal_rank_environment(monkeypatch, *, rank: int = 2) -> None:
+    monkeypatch.delenv("SGLANG_DIFFUSION_EXTERNAL_RANK", raising=False)
+    monkeypatch.setenv("MASTER_ADDR", "localhost")
+    monkeypatch.setenv("RANK", str(rank))
+    monkeypatch.setenv("LOCAL_RANK", str(rank))
+    monkeypatch.setenv("WORLD_SIZE", "4")
+    monkeypatch.setattr(dist, "is_initialized", lambda: True)
+    monkeypatch.setattr(dist, "get_rank", lambda: rank)
+    monkeypatch.setattr(dist, "get_world_size", lambda: 4)
+
+
+def test_internal_single_host_rank_launch_is_supported(monkeypatch):
+    _set_internal_rank_environment(monkeypatch)
+    assert _supported_rank_launch()
+
+
+def test_external_rank_launch_stays_supported(monkeypatch):
+    monkeypatch.setenv("SGLANG_DIFFUSION_EXTERNAL_RANK", "1")
+    monkeypatch.setattr(dist, "is_initialized", lambda: False)
+    assert _supported_rank_launch()
+
+
+@pytest.mark.parametrize(
+    ("name", "value"),
+    (
+        ("MASTER_ADDR", "strix-1"),
+        ("RANK", "1"),
+        ("LOCAL_RANK", "1"),
+        ("WORLD_SIZE", "8"),
+    ),
+)
+def test_internal_rank_launch_rejects_nonlocal_or_incoherent_environment(
+    monkeypatch, name: str, value: str
+):
+    _set_internal_rank_environment(monkeypatch)
+    monkeypatch.setenv(name, value)
+    assert not _supported_rank_launch()
+
+
+def test_internal_single_host_rank_can_create_h3_cache(monkeypatch, tmp_path: Path):
+    _set_internal_rank_environment(monkeypatch)
+    monkeypatch.setenv(
+        MINIMAX_H3_RANK_WEIGHT_CACHE_DIR_ENV,
+        "/models/.cache/hellas/h3-rank-shards",
+    )
+    revision = "c" * 40
+    component_path = tmp_path / "snapshots" / revision / "text_encoder"
+    component_path.mkdir(parents=True)
+    model_type = type(
+        "MiniMaxH3Qwen3VLEncoder",
+        (nn.Linear,),
+        {
+            "__module__": (
+                "sglang.multimodal_gen.runtime.models.encoders.minimax_h3_qwen3vl"
+            )
+        },
+    )
+    model = model_type(2, 2)
+
+    cache = create_minimax_h3_rank_weight_cache(
+        model,
+        component="text_encoder",
+        canonical_paths=[component_path],
+        dtype_policy=torch.bfloat16,
+    )
+
+    assert cache is not None
+    assert cache.rank == 2
+    assert cache.world_size == 4
+    assert cache.relative_dir.parts[-1] == "world-00004"
+
+
+def _gloo_worker(rank: int, rendezvous: str, root: str, results) -> None:
+    dist.init_process_group(
+        "gloo",
+        init_method=f"file://{rendezvous}",
+        rank=rank,
+        world_size=2,
+        timeout=timedelta(seconds=20),
+    )
+    try:
+        cache_root = Path(root)
+        ordinary = nn.Linear(4, 4, bias=False)
+        with torch.no_grad():
+            ordinary.weight.fill_(rank + 1)
+        ordinary_cache = _cache(
+            cache_root,
+            relative="gloo-ordinary",
+            rank=rank,
+            world_size=2,
+        )
+        assert ordinary_cache.store(ordinary)
+        with torch.no_grad():
+            ordinary.weight.zero_()
+        assert ordinary_cache.restore(
+            ordinary, target_device=torch.device("cpu"), assign=False
+        )
+        torch.testing.assert_close(
+            ordinary.weight, torch.full_like(ordinary.weight, rank + 1)
+        )
+
+        mesh = init_device_mesh(
+            "cpu",
+            mesh_shape=(1, 2),
+            mesh_dim_names=("replicate", "shard"),
+        )
+        placements = (Replicate(), Shard(0))
+        local = torch.full((2, 2), rank + 3, dtype=torch.float32)
+        distributed = DTensor.from_local(
+            local,
+            device_mesh=mesh,
+            placements=placements,
+            run_check=False,
+            shape=torch.Size((4, 2)),
+            stride=(2, 1),
+        )
+        dtensor_model = nn.Module()
+        dtensor_model.weight = nn.Parameter(distributed, requires_grad=False)
+        dtensor_cache = _cache(
+            cache_root,
+            relative="gloo-dtensor",
+            rank=rank,
+            world_size=2,
+        )
+        assert dtensor_cache.store(dtensor_model)
+
+        empty = DTensor.from_local(
+            torch.zeros_like(local),
+            device_mesh=mesh,
+            placements=placements,
+            run_check=False,
+            shape=torch.Size((4, 2)),
+            stride=(2, 1),
+        )
+        restored_model = nn.Module()
+        restored_model.weight = nn.Parameter(empty, requires_grad=False)
+        assert dtensor_cache.restore(
+            restored_model,
+            target_device=torch.device("cpu"),
+            assign=True,
+            parameter_factory=lambda _parameter, tensor: nn.Parameter(
+                tensor, requires_grad=False
+            ),
+        )
+        torch.testing.assert_close(restored_model.weight.to_local(), local)
+        full = restored_model.weight.full_tensor()
+        expected_full = torch.cat(
+            (torch.full((2, 2), 3.0), torch.full((2, 2), 4.0)), dim=0
+        )
+        torch.testing.assert_close(full, expected_full)
+
+        dist.barrier()
+        if rank == 0:
+            assert ordinary_cache.read_dir is not None
+            manifest = json.loads(
+                (ordinary_cache.read_dir / "complete.json").read_text()
+            )
+            rank_one_file = manifest["rank_files"]["1"]["file"]
+            (ordinary_cache.read_dir / rank_one_file).unlink()
+        dist.barrier()
+        with torch.no_grad():
+            ordinary.weight.fill_(99)
+        assert not ordinary_cache.restore(
+            ordinary, target_device=torch.device("cpu"), assign=False
+        )
+        torch.testing.assert_close(ordinary.weight, torch.full_like(ordinary.weight, 99))
+        results.put((rank, "ok"))
+    finally:
+        dist.destroy_process_group()
+
+
+def test_two_rank_gloo_cache_consensus_and_dtensor_restore(tmp_path: Path):
+    context = multiprocessing.get_context("fork")
+    results = context.Queue()
+    rendezvous = tmp_path / "gloo-rendezvous"
+    processes = [
+        context.Process(
+            target=_gloo_worker,
+            args=(rank, str(rendezvous), str(tmp_path), results),
+        )
+        for rank in range(2)
+    ]
+    for process in processes:
+        process.start()
+    for process in processes:
+        process.join(timeout=30)
+    hung = [process for process in processes if process.is_alive()]
+    for process in hung:
+        process.terminate()
+        process.join()
+    assert not hung, "two-rank cache test deadlocked"
+    assert [process.exitcode for process in processes] == [0, 0]
+    assert sorted(results.get(timeout=2) for _ in range(2)) == [(0, "ok"), (1, "ok")]
