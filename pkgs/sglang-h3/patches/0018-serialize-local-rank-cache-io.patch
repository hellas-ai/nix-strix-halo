+    def _serialize_local_rank_io(self) -> bool:
+        return (
+            self.world_size > 1
+            and not _truthy_environment(_EXTERNAL_RANK_ENV)
+            and os.environ.get("MASTER_ADDR", "").strip().lower()
+            in {"localhost", "127.0.0.1", "::1"}
+        )
+
+    @contextmanager
+    def _local_rank_io_lock(self):
+        """Bound rank-file residency on a single multi-GPU host.
+
+        Four 15-GiB V620 rank files otherwise enter the page cache and pinned
+        copy path together.  That can consume the entire 128-GiB host before
+        any rank reaches the final cache-hit collective.  External ranks live
+        on separate hosts and deliberately keep their parallel I/O.
+        """
+        if not self._serialize_local_rank_io():
+            yield
+            return
+        runtime_dir = Path(f"/run/user/{os.getuid()}")
+        if not runtime_dir.is_dir():
+            runtime_dir = Path("/run/lock")
+        lock_path = runtime_dir / "sglang-minimax-h3-rank-cache.lock"
+        with lock_path.open("a+b") as lock_file:
+            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
+            try:
+                yield
+            finally:
+                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+
+    @staticmethod
+    def _discard_file_cache(path: Path) -> None:
+        descriptor: int | None = None
+        try:
+            descriptor = os.open(path, os.O_RDONLY)
+            os.posix_fadvise(
+                descriptor,
+                0,
+                0,
+                os.POSIX_FADV_DONTNEED,
+            )
+        except (AttributeError, OSError):
+            pass
+        finally:
+            if descriptor is not None:
+                os.close(descriptor)
+
+    def _rank_file_sha256(self, path: Path) -> str:
+        with self._local_rank_io_lock():
+            try:
+                return _sha256_file(path)
+            finally:
+                self._discard_file_cache(path)
+
