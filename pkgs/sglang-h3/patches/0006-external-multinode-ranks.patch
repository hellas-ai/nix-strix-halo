     _kill_alive_processes(alive, _WORKER_KILL_TIMEOUT_S)
 
 
+def _external_rank_enabled() -> bool:
+    return os.environ.get("SGLANG_DIFFUSION_EXTERNAL_RANK", "0").lower() in {
+        "1",
+        "true",
+    }
+
+
+def _external_rank_values(server_args: ServerArgs) -> tuple[int, int, int]:
+    required = ("RANK", "LOCAL_RANK", "WORLD_SIZE")
+    missing = [name for name in required if name not in os.environ]
+    if missing:
+        raise RuntimeError(
+            "SGLANG_DIFFUSION_EXTERNAL_RANK requires torchrun variables: "
+            + ", ".join(missing)
+        )
+
+    rank = int(os.environ["RANK"])
+    local_rank = int(os.environ["LOCAL_RANK"])
+    world_size = int(os.environ["WORLD_SIZE"])
+    if world_size != server_args.num_gpus:
+        raise RuntimeError(
+            "External WORLD_SIZE must equal --num-gpus "
+            f"({world_size} != {server_args.num_gpus})"
+        )
+
+    expected = {
+        "tp_size": 1,
+        "dp_size": 1,
+        "cfg_parallel_degree": 1,
+        "sp_degree": world_size,
+        "ulysses_degree": world_size,
+        "ring_degree": 1,
+    }
+    mismatches = [
+        f"{name}={getattr(server_args, name)!r} (expected {value})"
+        for name, value in expected.items()
+        if getattr(server_args, name) != value
+    ]
+    if mismatches:
+        raise RuntimeError(
+            "External-rank H3 currently supports only FSDP1/Ulysses-world: "
+            + ", ".join(mismatches)
+        )
+    return rank, local_rank, world_size
+
+
+def _launch_external_rank_server(
+    server_args: ServerArgs, launch_http_server: bool
+):
+    rank, local_rank, world_size = _external_rank_values(server_args)
+    logger.info(
+        "Starting external diffusion rank %d/%d on local GPU %d",
+        rank,
+        world_size,
+        local_rank,
+    )
+
+    reader, writer = mp.Pipe(duplex=False)
+    process = mp.Process(
+        target=run_scheduler_process,
+        args=(
+            local_rank,
+            rank,
+            server_args.master_port,
+            server_args,
+            writer,
+            None,
+            None,
+            [],
+            [],
+        ),
+        name=f"sglang-diffusionExternalWorker-{rank}",
+        daemon=True,
+    )
+    process.start()
+    writer.close()
+    try:
+        data = reader.recv()
+    except EOFError:
+        process.join()
+        raise RuntimeError(
+            f"External rank {rank} scheduler exited with code {process.exitcode}"
+        ) from None
+    finally:
+        reader.close()
+
+    if data.get("status") != "ready":
+        raise RuntimeError(f"External rank {rank} failed to initialize")
+    logger.info("External diffusion rank %d is ready", rank)
+
+    if rank == 0 and launch_http_server:
+        try:
+            launch_http_server_only(server_args)
+        finally:
+            shutdown_scheduler_processes(server_args, [process])
+    else:
+        process.join()
+        if process.exitcode not in (0, None):
+            raise RuntimeError(
+                f"External rank {rank} scheduler exited with code {process.exitcode}"
+            )
+    return [process]
+
+
