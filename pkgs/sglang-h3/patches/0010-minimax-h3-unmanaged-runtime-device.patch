+    def _ensure_unmanaged_runtime_device(self, device: torch.device) -> None:
+        """Keep non-DTensor root state on the active rank device.
+
+        FSDP owns the sharded DTensors, but H3 also has TP-aware projection
+        parameters at the root.  Rank-cache state-dict restoration can leave
+        FSDP's original references for those unmanaged parameters on CPU.  Do
+        an in-place move after the FSDP pre-forward hook so its references and
+        the module's references continue to name the same Parameter object.
+        """
+
+        with torch.no_grad():
+            for module in self.modules():
+                for parameter in module._parameters.values():
+                    if (
+                        parameter is not None
+                        and not hasattr(parameter, "device_mesh")
+                        and parameter.device != device
+                    ):
+                        parameter.data = parameter.data.to(device=device)
+                for name, buffer in module._buffers.items():
+                    if buffer is not None and buffer.device != device:
+                        module._buffers[name] = buffer.to(device=device)
+
