+            local_logits = torch.cat((video_logits, audio_logits), dim=-1)
+            if os.environ.get("SGLANG_MINIMAX_H3_CPU_SP_LOGITS_GATHER") == "1":
+                # RCCL on the four local gfx1030 cards can complete every
