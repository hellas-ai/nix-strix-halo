+# SPDX-License-Identifier: Apache-2.0
+from __future__ import annotations
+
+import os
+import re
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+import torch
+from safetensors.torch import save_file
+
+from sglang.multimodal_gen.runtime.distributed import (
+    get_world_group,
+    model_parallel_is_initialized,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.schedule_batch import Req
+from sglang.multimodal_gen.runtime.pipelines_core.stages.base import (
+    PipelineStage,
+    StageParallelismType,
+)
+from sglang.multimodal_gen.runtime.server_args import ServerArgs
+
+
+MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV = (
+    "SGLANG_MINIMAX_H3_LATENT_CHECKPOINT_DIR"
+)
+MINIMAX_H3_LATENT_CHECKPOINT_SCHEMA = "hellas.minimax_h3.latents.v1"
+_SHARED_CHECKPOINT_ROOT = Path("/mnt/Home")
+_SAFE_REQUEST_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")
+
+
+def _checkpoint_directory_from_environment() -> Path | None:
+    raw = os.environ.get(MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV)
+    if raw is None or not raw.strip():
+        return None
+    requested = Path(raw.strip()).expanduser()
+    if not requested.is_absolute():
+        raise ValueError(
+            f"{MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV} must be an absolute path "
+            "below /mnt/Home"
+        )
+    checkpoint_dir = requested.resolve(strict=False)
+    shared_root = _SHARED_CHECKPOINT_ROOT.resolve(strict=False)
+    try:
+        relative = checkpoint_dir.relative_to(shared_root)
+    except ValueError as exc:
+        raise ValueError(
+            f"{MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV} must resolve below "
+            f"{shared_root}, got {checkpoint_dir}"
+        ) from exc
+    if not relative.parts:
+        raise ValueError(
+            f"{MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV} must name a directory "
+            "below /mnt/Home, not /mnt/Home itself"
+        )
+    return checkpoint_dir
+
+
+def _validate_checkpoint_tensors(
+    latents: torch.Tensor,
+    audio_latents: torch.Tensor,
+) -> None:
+    if not isinstance(latents, torch.Tensor) or latents.ndim != 5:
+        raise ValueError("MiniMax H3 checkpoint latents must be a rank-5 tensor")
+    if int(latents.shape[1]) != 24:
+        raise ValueError(
+            "MiniMax H3 checkpoint video latent channel count must be 24, "
+            f"got {int(latents.shape[1])}"
+        )
+    if not isinstance(audio_latents, torch.Tensor) or audio_latents.ndim != 3:
+        raise ValueError(
+            "MiniMax H3 checkpoint audio_latents must be a rank-3 tensor"
+        )
+    if tuple(int(dim) for dim in audio_latents.shape[:2]) != (2, 32):
+        raise ValueError(
+            "MiniMax H3 checkpoint audio latent prefix must be [2, 32], "
+            f"got {list(audio_latents.shape[:2])}"
+        )
+    if not latents.is_floating_point() or not audio_latents.is_floating_point():
+        raise ValueError("MiniMax H3 checkpoint latents must be floating-point")
+
+
+def _atomic_write_latent_checkpoint(
+    checkpoint_dir: Path,
+    *,
+    request_id: str,
+    latents: torch.Tensor,
+    audio_latents: torch.Tensor,
+    metadata: Mapping[str, Any] | None = None,
+) -> Path:
+    """Persist normalized post-denoise latents without exposing a partial file."""
+
+    if (
+        not isinstance(request_id, str)
+        or _SAFE_REQUEST_ID.fullmatch(request_id) is None
+    ):
+        raise ValueError(
+            "MiniMax H3 request_id must contain only letters, digits, '.', '_', "
+            "or '-' and be at most 128 characters"
+        )
+    _validate_checkpoint_tensors(latents, audio_latents)
+    checkpoint_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
+    final_path = checkpoint_dir / f"{request_id}.latents.safetensors"
+    partial_path = checkpoint_dir / (
+        f".{request_id}.latents.safetensors.{os.getpid()}.partial"
+    )
+    tensors = {
+        "latents": latents.detach().to(device="cpu").contiguous(),
+        "audio_latents": audio_latents.detach().to(device="cpu").contiguous(),
+    }
+    string_metadata = {
+        str(key): str(value) for key, value in (metadata or {}).items()
+    }
+    string_metadata["schema"] = MINIMAX_H3_LATENT_CHECKPOINT_SCHEMA
+    try:
+        save_file(tensors, str(partial_path), metadata=string_metadata)
+        # Make the file contents durable before making the final path visible.
+        with partial_path.open("rb") as partial_file:
+            os.fsync(partial_file.fileno())
+        os.replace(partial_path, final_path)
+        # Persist the directory entry as well. /mnt/Home is a normal persistent
+        # Linux filesystem in the supported deployment.
+        directory_fd = os.open(checkpoint_dir, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory_fd)
+        finally:
+            os.close(directory_fd)
+    except BaseException:
+        partial_path.unlink(missing_ok=True)
+        raise
+    return final_path
+
+
+def _checkpoint_metadata(batch: Req, server_args: ServerArgs) -> dict[str, str]:
+    canonical = batch.extra.get("minimax_h3_canonical_request")
+    task = canonical.get("task") if isinstance(canonical, Mapping) else None
+    model_path = str(server_args.model_path)
+    variant = server_args.model_variant or server_args.model_subfolder or "unknown"
+    return {
+        "producer": "sglang",
+        "model_revision": Path(model_path.rstrip("/")).name,
+        "model_variant": str(variant),
+        "workflow": str(task or "unknown"),
+        "request_id": str(batch.request_id),
+        "latent_height": str(int(batch.latents.shape[-2])),
+        "latent_width": str(int(batch.latents.shape[-1])),
+    }
+
+
+class MiniMaxH3LatentCheckpointStage(PipelineStage):
+    """Write one complete, normalized checkpoint before destructive VAE decode.
+
+    MiniMax H3's Ulysses model all-gathers its output rows, so every rank owns
+    complete post-denoise video and audio latents. Only world rank zero writes;
+    all ranks participate in the status broadcast so a write failure cannot
+    send peers into the following tiled-decode collectives.
+    """
+
+    def __init__(self, checkpoint_dir: Path) -> None:
+        super().__init__()
+        self.checkpoint_dir = checkpoint_dir
+
+    @classmethod
+    def from_environment(cls) -> MiniMaxH3LatentCheckpointStage | None:
+        checkpoint_dir = _checkpoint_directory_from_environment()
+        return None if checkpoint_dir is None else cls(checkpoint_dir)
+
+    @property
+    def parallelism_type(self) -> StageParallelismType:
+        return StageParallelismType.REPLICATED
+
+    def forward(self, batch: Req, server_args: ServerArgs) -> Req:
+        if batch.is_warmup:
+            return batch
+
+        world_group = get_world_group() if model_parallel_is_initialized() else None
+        is_owner = world_group is None or world_group.rank_in_group == 0
+        owner_exception: Exception | None = None
+        result: dict[str, str | None] | None = None
+        if is_owner:
+            try:
+                checkpoint_path = _atomic_write_latent_checkpoint(
+                    self.checkpoint_dir,
+                    request_id=str(batch.request_id),
+                    latents=batch.latents,
+                    audio_latents=batch.audio_latents,
+                    metadata=_checkpoint_metadata(batch, server_args),
+                )
+                result = {"error": None, "path": str(checkpoint_path)}
+            except Exception as exc:
+                owner_exception = exc
+                result = {
+                    "error": f"{type(exc).__name__}: {exc}",
+                    "path": None,
+                }
+
+        if world_group is not None:
+            result = world_group.broadcast_object(result, src=0)
+        if not isinstance(result, dict):
+            raise RuntimeError("MiniMax H3 checkpoint owner returned no status")
+        error = result.get("error")
+        if error is not None:
+            message = f"MiniMax H3 latent checkpoint failed on rank 0: {error}"
+            if owner_exception is not None:
+                raise RuntimeError(message) from owner_exception
+            raise RuntimeError(message)
+        checkpoint_path = result.get("path")
+        if not isinstance(checkpoint_path, str):
+            raise RuntimeError("MiniMax H3 checkpoint owner returned no path")
+        batch.extra["minimax_h3_latent_checkpoint_path"] = checkpoint_path
+        if is_owner:
+            self.log_info("Saved post-denoise latents to %s", checkpoint_path)
+        return batch
+
+
+__all__ = [
+    "MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV",
+    "MINIMAX_H3_LATENT_CHECKPOINT_SCHEMA",
+    "MiniMaxH3LatentCheckpointStage",
+]
