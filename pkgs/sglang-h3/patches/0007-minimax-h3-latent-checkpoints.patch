+# SPDX-License-Identifier: Apache-2.0
+"""MiniMax H3 post-denoise checkpoint persistence contract."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+from safetensors import safe_open
+
+from sglang.multimodal_gen.runtime.pipelines_core.stages.model_specific_stages.minimax_h3.stages import (
+    checkpointing as checkpointing_module,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.stages.model_specific_stages.minimax_h3.stages.checkpointing import (
+    MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV,
+    MINIMAX_H3_LATENT_CHECKPOINT_SCHEMA,
+    MiniMaxH3LatentCheckpointStage,
+    _atomic_write_latent_checkpoint,
+    _checkpoint_directory_from_environment,
+)
+
+
+def _latents(value: float) -> tuple[torch.Tensor, torch.Tensor]:
+    return (
+        torch.full((1, 24, 2, 4, 6), value, dtype=torch.float32),
+        torch.full((2, 32, 5), value, dtype=torch.float32),
+    )
+
+
+class _FakeWorldGroup:
+    def __init__(self, rank: int, received=None):
+        self.rank_in_group = rank
+        self.received = received
+        self.sent = None
+
+    def broadcast_object(self, obj, src=0):
+        assert src == 0
+        self.sent = obj
+        return obj if self.rank_in_group == src else self.received
+
+
+def _checkpoint_stage() -> MiniMaxH3LatentCheckpointStage:
+    stage = object.__new__(MiniMaxH3LatentCheckpointStage)
+    stage.checkpoint_dir = Path("/mnt/Home/checkpoints")
+    return stage
+
+
+def _batch():
+    video, audio = _latents(1.0)
+    return SimpleNamespace(
+        is_warmup=False,
+        request_id="broadcast-test",
+        latents=video,
+        audio_latents=audio,
+        extra={},
+    )
+
+
+def _server_args():
+    return SimpleNamespace(
+        model_path="/mnt/Home/models/MiniMax-H3",
+        model_variant="fl2va",
+        model_subfolder=None,
+    )
+
+
+def test_atomic_checkpoint_round_trip_and_replace(tmp_path: Path):
+    video, audio = _latents(1.0)
+    path = _atomic_write_latent_checkpoint(
+        tmp_path,
+        request_id="video-test_1",
+        latents=video,
+        audio_latents=audio,
+        metadata={"workflow": "fl2va"},
+    )
+    replacement_video, replacement_audio = _latents(2.0)
+    replacement_path = _atomic_write_latent_checkpoint(
+        tmp_path,
+        request_id="video-test_1",
+        latents=replacement_video,
+        audio_latents=replacement_audio,
+        metadata={"workflow": "fl2va"},
+    )
+
+    assert replacement_path == path
+    assert {entry.name for entry in tmp_path.iterdir()} == {path.name}
+    with safe_open(path, framework="pt", device="cpu") as checkpoint:
+        assert checkpoint.metadata()["schema"] == MINIMAX_H3_LATENT_CHECKPOINT_SCHEMA
+        assert checkpoint.metadata()["workflow"] == "fl2va"
+        torch.testing.assert_close(
+            checkpoint.get_tensor("latents"), replacement_video, rtol=0, atol=0
+        )
+        torch.testing.assert_close(
+            checkpoint.get_tensor("audio_latents"),
+            replacement_audio,
+            rtol=0,
+            atol=0,
+        )
+
+
+def test_checkpoint_environment_is_opt_in(monkeypatch):
+    monkeypatch.delenv(MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV, raising=False)
+    assert _checkpoint_directory_from_environment() is None
+
+
+def test_checkpoint_environment_rejects_non_shared_path(monkeypatch):
+    monkeypatch.setenv(MINIMAX_H3_LATENT_CHECKPOINT_DIR_ENV, "/var/empty/h3")
+    with pytest.raises(ValueError, match="below /mnt/Home"):
+        _checkpoint_directory_from_environment()
+
+
+def test_owner_checkpoint_failure_is_published(monkeypatch):
+    group = _FakeWorldGroup(rank=0)
+    monkeypatch.setattr(
+        checkpointing_module, "model_parallel_is_initialized", lambda: True
+    )
+    monkeypatch.setattr(checkpointing_module, "get_world_group", lambda: group)
+
+    def fail_write(*args, **kwargs):
+        raise OSError("disk full")
+
+    monkeypatch.setattr(
+        checkpointing_module, "_atomic_write_latent_checkpoint", fail_write
+    )
+    with pytest.raises(RuntimeError, match="OSError: disk full"):
+        _checkpoint_stage().forward(_batch(), _server_args())
+
+    assert group.sent == {"error": "OSError: disk full", "path": None}
+
+
+def test_peer_receives_owner_checkpoint_failure_without_writing(monkeypatch):
+    group = _FakeWorldGroup(
+        rank=1, received={"error": "OSError: disk full", "path": None}
+    )
+    monkeypatch.setattr(
+        checkpointing_module, "model_parallel_is_initialized", lambda: True
+    )
+    monkeypatch.setattr(checkpointing_module, "get_world_group", lambda: group)
+
+    def unexpected_write(*args, **kwargs):
+        pytest.fail("a non-owner rank tried to write the checkpoint")
+
+    monkeypatch.setattr(
+        checkpointing_module, "_atomic_write_latent_checkpoint", unexpected_write
+    )
+    with pytest.raises(RuntimeError, match="OSError: disk full"):
+        _checkpoint_stage().forward(_batch(), _server_args())
+
+    assert group.sent is None
+
+
+@pytest.mark.parametrize("request_id", ["../escape", "/absolute", "", "a" * 129])
+def test_checkpoint_rejects_unsafe_request_id(tmp_path: Path, request_id: str):
+    video, audio = _latents(1.0)
+    with pytest.raises(ValueError, match="request_id"):
+        _atomic_write_latent_checkpoint(
+            tmp_path,
+            request_id=request_id,
+            latents=video,
+            audio_latents=audio,
+        )
