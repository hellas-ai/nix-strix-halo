+def _prefetch_checkpoint_file(
+    file_path: str, block_size: int = 16 * 1024 * 1024
+) -> None:
+    """Warm one checkpoint shard in the OS page cache.
+
+    H3 workers otherwise fault remote NVMe/RDMA-backed mmap pages in small,
+    model-dependent reads.  A bounded sequential pass immediately before
+    ``safe_open`` gives Linux a predictable readahead stream without copying
+    the complete checkpoint into an additional Python buffer.
+    """
+    with open(file_path, "rb") as stream:
+        while stream.read(block_size):
+            pass
+
