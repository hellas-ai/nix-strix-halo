+                owner_output = self._output_batch(
+                    batch, visual_frames, audio_payload, server_args
+                )
+            except Exception as exc:
+                owner_exception = exc
+                owner_error = f"{type(exc).__name__}: {exc}"
+
+        # Keep every denoiser rank in this small control collective until the
+        # sole VAE owner completes.  Do not broadcast decoded frames/audio: only
+        # world rank zero materializes and returns the final result.
