+# SPDX-License-Identifier: Apache-2.0
+"""MiniMax H3 rank-zero-only VAE placement and decode contracts."""
+
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+import torch
+
+from sglang.multimodal_gen.configs.pipeline_configs.minimax_h3 import (
+    MiniMaxH3PipelineConfig,
+)
+from sglang.multimodal_gen.runtime.loader.component_loaders import vae_loader
+from sglang.multimodal_gen.runtime.loader.component_loaders.vae_loader import (
+    RankZeroVAEPlaceholder,
+    VAELoader,
+    minimax_h3_uses_rank0_vae,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.schedule_batch import OutputBatch
+from sglang.multimodal_gen.runtime.pipelines_core.stages.model_specific_stages.minimax_h3.stages import (
+    decoding,
+)
+from sglang.multimodal_gen.runtime.pipelines_core.stages.model_specific_stages.minimax_h3.stages.decoding import (
+    MiniMaxH3DecodingStage,
+)
+
+
+class _FakeWorldGroup:
+    def __init__(self, rank: int, received=None):
+        self.rank_in_group = rank
+        self.received = received
+        self.sent = None
+
+    def broadcast_object(self, obj, src=0):
+        assert src == 0
+        self.sent = obj
+        return obj if self.rank_in_group == src else self.received
+
+
+def _server_args(*, parallel_decode: bool, num_gpus: int = 4):
+    pipeline_config = MiniMaxH3PipelineConfig()
+    pipeline_config.vae_config.use_parallel_decode = parallel_decode
+    return SimpleNamespace(
+        num_gpus=num_gpus,
+        pipeline_config=pipeline_config,
+        model_paths={},
+    )
+
+
+def test_rank_zero_vae_topology_is_explicit_and_multirank_only():
+    assert minimax_h3_uses_rank0_vae(_server_args(parallel_decode=False, num_gpus=4))
+    assert not minimax_h3_uses_rank0_vae(_server_args(parallel_decode=True, num_gpus=4))
+    assert not minimax_h3_uses_rank0_vae(
+        _server_args(parallel_decode=False, num_gpus=1)
+    )
+
+
+@pytest.mark.parametrize(
+    ("component_name", "config_attr"),
+    [("video_vae", "vae_config"), ("audio_vae", "audio_vae_config")],
+)
+def test_nonowner_vae_loader_reads_config_but_skips_weights(
+    monkeypatch, component_name, config_attr
+):
+    server_args = _server_args(parallel_decode=False)
+    component_config = getattr(server_args.pipeline_config, config_attr)
+    update = mock.Mock()
+    post_init = mock.Mock()
+    monkeypatch.setattr(component_config, "update_model_arch", update)
+    monkeypatch.setattr(component_config, "post_init", post_init)
+    monkeypatch.setattr(
+        vae_loader,
+        "get_diffusers_component_config",
+        lambda **_kwargs: {"_class_name": "UnusedVAE", "latent_channels": 24},
+    )
+    monkeypatch.setattr(vae_loader, "resolve_component_precision", lambda *_args: None)
+    monkeypatch.setattr(vae_loader, "model_parallel_is_initialized", lambda: True)
+    monkeypatch.setattr(vae_loader, "get_world_group", lambda: _FakeWorldGroup(rank=2))
+
+    def unexpected_weight_scan(*_args, **_kwargs):
+        pytest.fail("a non-owner rank scanned VAE weight shards")
+
+    monkeypatch.setattr(vae_loader, "_list_safetensors_files", unexpected_weight_scan)
+    component = VAELoader().load_customized(
+        "/models/MiniMax-H3/FL2VA/" + component_name,
+        server_args,
+        component_name,
+    )
+
+    assert isinstance(component, RankZeroVAEPlaceholder)
+    assert component.component_name == component_name
+    assert component.parallel_tiling is False
+    update.assert_called_once_with({"latent_channels": 24})
+    post_init.assert_called_once_with()
+
+
+def _decode_stage():
+    stage = object.__new__(MiniMaxH3DecodingStage)
+    stage.video_vae = RankZeroVAEPlaceholder("video_vae")
+    stage.audio_vae = RankZeroVAEPlaceholder("audio_vae")
+    return stage
+
+
+def _decode_batch():
+    return SimpleNamespace(metrics=SimpleNamespace())
+
+
+def test_decode_peer_waits_for_status_without_touching_vae(monkeypatch):
+    group = _FakeWorldGroup(rank=3, received=None)
+    monkeypatch.setattr(decoding, "model_parallel_is_initialized", lambda: True)
+    monkeypatch.setattr(decoding, "get_world_group", lambda: group)
+    stage = _decode_stage()
+    stage._decode_video = mock.Mock(side_effect=AssertionError("peer decoded video"))
+    stage._decode_audio = mock.Mock(side_effect=AssertionError("peer decoded audio"))
+
+    result = stage._forward_rank_zero_vae(
+        _decode_batch(),
+        torch.zeros(1),
+        torch.zeros(1),
+        _server_args(parallel_decode=False),
+    )
+
+    assert isinstance(result, OutputBatch)
+    assert result.output is None
+    assert result.audio is None
+    stage._decode_video.assert_not_called()
+    stage._decode_audio.assert_not_called()
+    assert group.sent is None
+
+
+def test_decode_owner_failure_is_broadcast_and_reraised(monkeypatch):
+    group = _FakeWorldGroup(rank=0)
+    monkeypatch.setattr(decoding, "model_parallel_is_initialized", lambda: True)
+    monkeypatch.setattr(decoding, "get_world_group", lambda: group)
+    stage = _decode_stage()
+    stage._decode_video = mock.Mock(side_effect=RuntimeError("decoder exploded"))
+    stage._decode_audio = mock.Mock()
+
+    with pytest.raises(RuntimeError, match="decoder exploded"):
+        stage._forward_rank_zero_vae(
+            _decode_batch(),
+            torch.zeros(1),
+            torch.zeros(1),
+            _server_args(parallel_decode=False),
+        )
+
+    assert group.sent == "RuntimeError: decoder exploded"
+    stage._decode_audio.assert_not_called()
+
+
+def test_decode_peer_receives_owner_failure(monkeypatch):
+    group = _FakeWorldGroup(rank=1, received="RuntimeError: decoder exploded")
+    monkeypatch.setattr(decoding, "model_parallel_is_initialized", lambda: True)
+    monkeypatch.setattr(decoding, "get_world_group", lambda: group)
+    stage = _decode_stage()
+
+    with pytest.raises(RuntimeError, match="failed on rank 0.*decoder exploded"):
+        stage._forward_rank_zero_vae(
+            _decode_batch(),
+            torch.zeros(1),
+            torch.zeros(1),
+            _server_args(parallel_decode=False),
+        )
+
+
+def test_decode_owner_returns_output_without_payload_broadcast(monkeypatch):
+    group = _FakeWorldGroup(rank=0)
+    monkeypatch.setattr(decoding, "model_parallel_is_initialized", lambda: True)
+    monkeypatch.setattr(decoding, "get_world_group", lambda: group)
+    stage = _decode_stage()
+    visual = torch.zeros((1, 3, 2, 4, 4))
+    audio = {"waveform": torch.zeros((2, 1, 32)), "sample_rate": 32000}
+    expected = OutputBatch(output=visual, audio=audio["waveform"])
+    stage._decode_video = mock.Mock(return_value=visual)
+    stage._decode_audio = mock.Mock(return_value=audio)
+    stage._output_batch = mock.Mock(return_value=expected)
+
+    result = stage._forward_rank_zero_vae(
+        _decode_batch(),
+        torch.zeros(1),
+        torch.zeros(1),
+        _server_args(parallel_decode=False),
+    )
+
+    assert result is expected
+    assert group.sent is None
