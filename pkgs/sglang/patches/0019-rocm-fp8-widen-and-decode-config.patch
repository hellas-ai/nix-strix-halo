+@triton.jit
+def widen_e4m3fn_to_fp16(x):
+    """Exact widening without gfx1151 generic FP8 conversion sequence."""
+    bits = x.to(tl.uint8, bitcast=True).to(tl.uint16)
+    magnitude = bits & 0x7F
+    normal = (magnitude << 7) + 0x2000
+    subnormal = ((magnitude & 7).to(tl.float32) * 0.001953125).to(tl.float16).to(tl.uint16, bitcast=True)
+    value = tl.where(magnitude < 8, subnormal, normal)
+    value = tl.where(magnitude == 0x7F, 0x7E00, value).to(tl.uint16)
+    value = value | ((bits & 0x80) << 8)
+    return value.to(tl.float16, bitcast=True)
