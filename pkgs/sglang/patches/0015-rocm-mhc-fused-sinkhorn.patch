+def _mhc_pre_hip(
+    residual: torch.Tensor,
+    fn: torch.Tensor,
+    hc_scale: torch.Tensor,
+    hc_base: torch.Tensor,
+    rms_eps: float,
+    hc_pre_eps: float,
+    hc_sinkhorn_eps: float,
+    hc_post_mult_value: float,
+    sinkhorn_repeat: int,
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """FP32 projection and fused Sinkhorn for the ROCm torch fallback."""
+    assert hc_pre_eps == hc_sinkhorn_eps and hc_post_mult_value == 2.0
+    s, n, h = residual.shape
+    x_flat = residual.reshape(s, n * h).float()
+    inv_rms = torch.rsqrt(x_flat.square().mean(-1, keepdim=True) + rms_eps)
+    mixes = torch.nn.functional.linear(x_flat, fn) * inv_rms
+    pre, post, comb = _hc_split_sinkhorn_triton(
+        mixes.unsqueeze(0), hc_scale, hc_base, n, sinkhorn_repeat, hc_sinkhorn_eps
+    )
+    layer_input = (pre.reshape(s, n, 1) * residual.float()).sum(dim=1)
+    return (
+        post.reshape(s, n, 1),
+        comb.reshape(s, n, n),
+        layer_input.to(residual.dtype),
+    )
+
