+def rotate_activation_128(x: torch.Tensor) -> torch.Tensor:
+    """Use the pooled key rotation for queries too, without a CUDA extension."""
+    assert x.shape[-1] == 128
+    flat = x.contiguous().view(-1, 128)
+    output = torch.empty_like(flat)
+    if flat.shape[0]:
+        _rotate_activation_128_kernel[(flat.shape[0],)](flat, output, num_warps=4)
+    return output.view(x.shape)
+
+
+@triton.jit
+def _rotate_activation_128_kernel(X, Y):
+    offsets = tl.program_id(0) * 128 + tl.arange(0, 128)
+    values = tl.load(X + offsets).to(tl.float32)
+    tl.store(Y + offsets, _hadamard128(values))
