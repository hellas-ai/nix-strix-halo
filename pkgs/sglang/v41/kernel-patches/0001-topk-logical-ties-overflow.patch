+// A coarse bucket can exceed the shared index scratch. Never infer its
+// exact score threshold from a truncated subset: this exceptional path scans
+// the original row for every FP32 radix digit, without storing input indices.
+__device__ void radix_topk_rescan(
+    const float* input, int32_t* output, uint32_t length, uint32_t topk,
+    const int32_t* ids, uint32_t block_bits, uint32_t logical_length) {
+  __shared__ uint32_t histogram[256];
+  __shared__ uint32_t prefix, remaining, cutoff_count, emitted;
+  const uint32_t tx = threadIdx.x;
+  if (tx == 0) { prefix = 0; remaining = topk; emitted = 0; }
+  __syncthreads();
+  for (uint32_t round = 0; round < 4; ++round) {
+    if (tx < 256) histogram[tx] = 0;
+    __syncthreads();
+    const uint32_t shift = 24 - 8 * round;
+    const uint32_t mask = round == 0 ? 0u : (~0u << (32 - 8 * round));
+    for (uint32_t idx = tx; idx < length; idx += kBlockSize) {
+      const uint32_t key = convert_to_uint32(input[idx]);
+      if ((key & mask) == prefix) ::atomicAdd(&histogram[(key >> shift) & 255u], 1);
+    }
+    __syncthreads();
+    if (tx == 0) {
+      uint32_t above = 0;
+      for (int bin = 255; bin >= 0; --bin) {
+        const uint32_t count = histogram[bin];
+        if (above + count >= remaining) {
+          prefix |= static_cast<uint32_t>(bin) << shift;
+          remaining -= above;
+          cutoff_count = count;
+          break;
+        }
+        above += count;
+      }
+    }
+    __syncthreads();
+  }
+  const bool ambiguous = cutoff_count > remaining;
+  for (uint32_t idx = tx; idx < length; idx += kBlockSize) {
+    const uint32_t key = convert_to_uint32(input[idx]);
+    if (key > prefix || (!ambiguous && key == prefix)) {
+      output[::atomicAdd(&emitted, 1)] = static_cast<int32_t>(idx);
+    }
+  }
+  __syncthreads();
+  if (ambiguous) {
+    emit_logical_cutoff_ties(input, output, length, prefix, remaining,
+                            topk - remaining, ids, block_bits, logical_length);
+  }
+}
