+// Return the logical token ID, excluding rounded-up newest-block padding.
+__device__ __forceinline__ bool logical_tie_id(
+    uint32_t idx, const int32_t* ids, uint32_t block_bits, uint32_t logical_length, uint32_t& logical) {
+  if (ids == nullptr) {
+    logical = idx;
+    return true;
+  }
+  const int32_t block = ids[idx >> block_bits];
+  if (block < 0) return false;
+  const uint64_t value = (static_cast<uint64_t>(block) << block_bits) | (idx & ((1u << block_bits) - 1u));
+  if (value >= logical_length) return false;
+  logical = static_cast<uint32_t>(value);
+  return true;
+}
