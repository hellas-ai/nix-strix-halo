+// Refine only an oversubscribed EXACT score cutoff. Larger complemented ID
+// keys mean smaller logical IDs. The original row is scanned, so candidate
+// publication order and the shared score-radix scratch order cannot pick ties.
+__device__ void emit_logical_cutoff_ties(
+    const float* input, int32_t* output, uint32_t length, uint32_t score_key,
+    uint32_t need, uint32_t output_base, const int32_t* ids,
+    uint32_t block_bits, uint32_t logical_length) {
+  __shared__ uint32_t histogram[256];
+  __shared__ uint32_t prefix, remaining, emitted;
+  const uint32_t tx = threadIdx.x;
+  if (tx == 0) { prefix = 0; remaining = need; emitted = 0; }
+  __syncthreads();
+  for (uint32_t round = 0; round < 4; ++round) {
+    if (tx < 256) histogram[tx] = 0;
+    __syncthreads();
+    const uint32_t shift = 24 - 8 * round;
+    const uint32_t mask = round == 0 ? 0u : (~0u << (32 - 8 * round));
+    for (uint32_t idx = tx; idx < length; idx += kBlockSize) {
+      uint32_t logical;
+      if (convert_to_uint32(input[idx]) == score_key && logical_tie_id(idx, ids, block_bits, logical_length, logical)) {
+        const uint32_t key = ~logical;
+        if ((key & mask) == prefix) ::atomicAdd(&histogram[(key >> shift) & 255u], 1);
+      }
+    }
+    __syncthreads();
+    if (tx == 0) {
+      uint32_t above = 0;
+      for (int bin = 255; bin >= 0; --bin) {
+        const uint32_t count = histogram[bin];
+        if (above + count >= remaining) {
+          prefix |= static_cast<uint32_t>(bin) << shift;
+          remaining -= above;
+          break;
+        }
+        above += count;
+      }
+    }
+    __syncthreads();
+  }
+  // Unique logical IDs make this exactly `need` members. Existing output
+  // sorting still decides presentation order; strict-score picks are untouched.
+  for (uint32_t idx = tx; idx < length; idx += kBlockSize) {
+    uint32_t logical;
+    if (convert_to_uint32(input[idx]) == score_key && logical_tie_id(idx, ids, block_bits, logical_length, logical) &&
+        ~logical >= prefix) {
+      const auto pos = ::atomicAdd(&emitted, 1);
+      output[output_base + pos] = static_cast<int32_t>(idx);
+    }
+  }
+  __syncthreads();
+}
