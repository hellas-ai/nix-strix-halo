@@ -0,0 +1,84 @@
+"""Per-generation, TP-wide Engram failure status for opt-in preflight.
+
+The first serving arm checks this status on the host *before* model execution.
+That check is intentionally a correctness scaffold, not the zero-host hot path.
+Future device-gated graphs may read ``device_status`` only until ``retire``.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from sglang.srt.distributed.parallel_state import inplace_all_reduce
+
+
+class EngramPreflightError(RuntimeError):
+    def __init__(self, generation: int, status: tuple[tuple[int, int], ...]):
+        self.generation = generation
+        self.status = status
+        super().__init__(f"Engram preflight generation {generation} failed: {status}")
+
+
+class EngramPreflightStatus:
+    """Stable [TP rank, layer] int32 buffer; one outstanding forward per rank.
+
+    Each rank writes only its own two cells. Integer TP sum therefore retains
+    the exact rank/layer/code, including simultaneous failures. The caller must
+    wait for all local gather writers before ``finish`` and must call it on every
+    rank in the same TP order, even after a local file error. No retry follows a
+    failed generation: the service stops as one TP group.
+    """
+
+    def __init__(self, *, device, tp_rank: int, tp_size: int, group_name: str):
+        if not (1 <= tp_size <= 4 and 0 <= tp_rank < tp_size):
+            raise ValueError("Engram preflight supports TP1-4 and a valid local rank")
+        self.tp_rank = tp_rank
+        self.tp_size = tp_size
+        self.group_name = group_name
+        self.device_status = torch.zeros((tp_size, 2), dtype=torch.int32, device=device)
+        self.generation = 0
+        self.active_generation: int | None = None
+        self.finished = False
+
+    def begin(self) -> int:
+        if self.active_generation is not None:
+            raise RuntimeError("previous Engram preflight generation was not retired")
+        self.generation += 1
+        self.active_generation = self.generation
+        self.finished = False
+        self.device_status.zero_()
+        return self.generation
+
+    def local_layer_word(self, layer: int) -> torch.Tensor:
+        if self.active_generation is None or self.finished or layer not in (0, 1):
+            raise RuntimeError("Engram layer status requested outside live preflight")
+        return self.device_status[self.tp_rank, layer : layer + 1]
+
+    def set_local_failure(self, layer: int, code: int) -> None:
+        """CPU-known local failure; native GPU gather writes the same cell."""
+        if not 1 <= code <= 127:
+            raise ValueError("Engram status code must fit the bounded ABI")
+        self.local_layer_word(layer).fill_(code)
+
+    def finish(self, generation: int) -> torch.Tensor:
+        if self.active_generation != generation or self.finished:
+            raise RuntimeError("stale or duplicate Engram status collective")
+        # Local gather completion is the caller's stream/event dependency.
+        if self.tp_size > 1:
+            inplace_all_reduce(self.device_status, group_name=self.group_name)
+        self.finished = True
+        return self.device_status
+
+    def check_before_model(self, generation: int) -> None:
+        """Safe, deliberately synchronizing scaffold; no model write preceded it."""
+        if self.active_generation != generation or not self.finished:
+            raise RuntimeError("Engram preflight status was not reduced")
+        snapshot = self.device_status.to(device="cpu").tolist()
+        result = tuple((int(row[0]), int(row[1])) for row in snapshot)
+        if any(code for row in result for code in row):
+            raise EngramPreflightError(generation, result)
+
+    def retire(self, generation: int) -> None:
+        if self.active_generation != generation or not self.finished:
+            raise RuntimeError("stale or unfinished Engram status retirement")
+        self.active_generation = None
