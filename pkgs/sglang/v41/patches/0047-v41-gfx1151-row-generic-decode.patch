+"""Row-count policy of the native gfx1151 DeepSeek-V4.1 decode kernels (pure Python: no torch, no triton).
+
+The native FP8 GEMVs (``deepseek_v41_gemv``) and the mHC post-residual kernel (``native_hc_post``) are row generic: ROWS is a
+compile-time constant of 1..8 token rows and a row's result does not depend on how many rows are in the call.  Dispatch sites ask
+this module which row counts may take a native kernel, so one switch controls every site.
+
+``SGLANG_DSV41_NATIVE_ROWS``
+    unset, ``all``  every row count 1..8 (default)
+    ``legacy``, ``0``, ``off``  the dispatch of patches 0014..0041: GEMV rows 1,2,4,8 (indexer wq_b 1,2,3,4,8 with its padded 3-row
+                    path), HC post rows 1,2,4 (plus the prefill row counts 512, 1306, 1536 of patch 0036)
+    ``1,2,3-5``  exactly these rows (lists and ranges, each 1..8); every other row count takes the generic path.  The mHC post
+                    kernel is also native for every row count above 8 (prefill tails of any size), whatever the list
+
+``SGLANG_DSV41_NATIVE_C1_ROWS``
+    ``4`` (default, the qualified kernel) or ``8``: output rows per program of the one-token GEMV.  For the three projections whose
+    BLOCK_K is 256 or 64 (wq_b, indexer wq_b, shared down) the 4-row tile reduces each 32-element block with a different lane
+    layout than the 8-row tile of the 2..8-token kernels, so a token's last bf16 bit can differ between one row and two or more
+    rows.  ``8`` makes the one-token result bitwise the multi-token one (full batch invariance 1..8) at the cost of a different
+    grid; it changes the numerics of those three projections at one row, so it is opt-in.
+"""
+import functools
+import os
+
+ENV = "SGLANG_DSV41_NATIVE_ROWS"
+MAX_ROWS = 8
+
+# Block-FP8 (32x32 weight blocks, UE8M0 activation scales) projections served by the row-generic entry point
+# ``deepseek_v41_gemv.native_gemv_rows`` and by the ``native_gemv_rows=True`` opt-in of ``triton_w8a8_block_fp8_linear``:
+# (N, K) -> BLOCK_K of the qualified kernels.  The first seven are the target model's TP4 projections (Engram wkv, wo_b, wqkv_a,
+# wq_b, shared gate/up, shared down, indexer wq_b), the last three the DSpark draft stages' unflagged linears (wq_a, wkv,
+# stage-0 main_proj).  K must be a multiple of BLOCK_K.
+PROJECTION_BLOCK_K = {
+    (25600, 6144): 512, (5120, 2048): 512, (1792, 5120): 512, (8192, 1280): 256,
+    (1152, 5120): 512, (5120, 576): 64, (4096, 1280): 256,
+    (1280, 5120): 512, (512, 5120): 512, (5120, 15360): 512,
+}
+HC_POST_PREFILL_ROWS = (512, 1306, 1536)   # the prefill row counts of the legacy (patch 0036) whitelist
+_ALL = frozenset(range(1, MAX_ROWS + 1))
+_LEGACY_GEMV = frozenset((1, 2, 4, 8))
+_LEGACY_IDX = frozenset((1, 2, 3, 4, 8))
+_LEGACY_HC_POST = frozenset((1, 2, 4))
+_LEGACY_WORDS = ("legacy", "0", "off", "false", "no")
+
+
+@functools.lru_cache(maxsize=None)
+def _parse(value: str):
+    """-> (is_legacy, rows frozenset or None for the defaults)."""
+    text = value.strip().lower()
+    if text in ("", "all", "1-8", "default", "on", "true", "yes"):
+        return False, None
+    if text in _LEGACY_WORDS:
+        return True, None
+    rows = set()
+    for part in text.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        low, _, high = part.partition("-")
+        low, high = int(low), int(high or low)
+        if not 1 <= low <= high <= MAX_ROWS:
+            raise ValueError(f"{ENV}: rows must lie in 1..{MAX_ROWS}, got {part!r}")
+        rows.update(range(low, high + 1))
+    if not rows:
+        raise ValueError(f"{ENV}: empty row list {value!r}")
+    return False, frozenset(rows)
+
+
+def _policy():
+    return _parse(os.environ.get(ENV, ""))
+
+
+def is_legacy() -> bool:
+    return _policy()[0]
+
+
+def gemv_rows() -> frozenset:
+    """Row counts the attention / shared-expert / Engram FP8 GEMVs may serve natively."""
+    legacy, rows = _policy()
+    return _LEGACY_GEMV if legacy else (_ALL if rows is None else rows)
+
+
+def idx_wqb_rows() -> frozenset:
+    """Row counts the indexer wq_b FP8 GEMV may serve natively."""
+    legacy, rows = _policy()
+    return _LEGACY_IDX if legacy else (_ALL if rows is None else rows)
+
+
+def hc_post_native(m: int) -> bool:
+    """Whether the native mHC post kernel serves ``m`` token rows.
+
+    Default: every ``m`` >= 1 (the kernel's grid z is the row count, no row constexpr; ``native_hc_post_c2`` chunks launches above
+    65535 rows).  ``legacy``: rows 1, 2, 4 and the prefill rows 512, 1306, 1536 only.  A row list restricts only the decode rows
+    1..8.  ``m`` < 1 never takes the native kernel."""
+    if m < 1:
+        return False
+    legacy, rows = _policy()
+    if legacy:
+        return m in _LEGACY_HC_POST or m in HC_POST_PREFILL_ROWS
+    if m > MAX_ROWS or rows is None:
+        return True
+    return m in rows
+
+
