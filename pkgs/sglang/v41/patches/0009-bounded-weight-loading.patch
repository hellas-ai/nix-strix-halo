+def _bounded_weight_iterator(weights, futures, *, max_pending: int):
+    """Keep source tensors owned until their blocking copy callbacks return.
+
+    V4 submits at most one copy per yielded checkpoint tensor. Reap completed
+    copies before obtaining the next tensor, so CPU dequantization cannot run
+    arbitrarily far ahead of H2D. Worker errors propagate at the next drain;
+    the enclosing executor still joins pending copies during error unwinding.
+    """
+    if max_pending < 1:
+        raise ValueError("max_pending must be positive")
+    iterator = iter(weights)
+    while True:
+        if len(futures) >= max_pending:
+            done, pending = concurrent.futures.wait(
+                futures, return_when=concurrent.futures.FIRST_COMPLETED
+            )
+            for future in done:
+                future.result()
+            futures[:] = pending
+        try:
+            item = next(iterator)
+        except StopIteration:
+            return
+        yield item
+
