+@triton.jit
+def _e2m1_bf16(code):
+    mag = code & 7
+    bits = tl.where(mag >= 2, (mag << 6) + 0x3F00, tl.where(mag == 1, 0x3F00, 0))
+    # E2M1 magnitudes 1..7 map to .5, 1, 1.5, 2, 3, 4, 6 exactly.
+    return (bits | ((code & 8) << 12)).to(tl.uint16).to(tl.bfloat16, bitcast=True)
+
