+"""Native V4.1 FP8 GEMV for one or two tokens on gfx1151.
+
+The existing activation quantizer supplies E4M3FN values and decoded E8M0
+scales. Native 32x32 weight blocks are reduced in FP32 and stored as BF16.
+Model-specific dispatch guards select the supported projection shapes.
+"""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _native_fp8_gemv_c1(Q, QS, W, WS, Y, N: tl.constexpr, K: tl.constexpr,
+                    ROWS: tl.constexpr, BLOCK_K: tl.constexpr):
+    first = tl.program_id(0) * ROWS
+    rows = first + tl.arange(0, ROWS)
+    cols = tl.arange(0, BLOCK_K)
+    groups = tl.arange(0, BLOCK_K // 32)
+    accumulator = tl.zeros((ROWS,), tl.float32)
+    for start in range(0, K, BLOCK_K):
+        q = tl.load(Q + start + cols).to(tl.float32)
+        w = tl.load(W + rows[:, None] * K + start + cols[None, :]).to(tl.float32)
+        products = w * q[None, :]
+        dots = tl.sum(tl.reshape(products, (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale = tl.load(QS + start // 32 + groups)
+        # ROWS=4 divides the native 32-output-row scale block. One scale vector
+        # is shared by all four output rows in this program.
+        w_scale = tl.load(WS + (first // 32) * (K // 32) + start // 32 + groups)
+        scaled = (dots * a_scale[None, :]) * w_scale[None, :]
+        accumulator = accumulator + tl.sum(scaled, axis=1)
+    tl.store(Y + rows, accumulator.to(tl.bfloat16))
+
+
+@triton.jit
+def _native_c2_gemv(Q, QS, W, WS, Y, N: tl.constexpr, K: tl.constexpr,
+                    ROWS: tl.constexpr, BLOCK_K: tl.constexpr):
+    first = tl.program_id(0) * ROWS
+    rows = first + tl.arange(0, ROWS)
+    cols = tl.arange(0, BLOCK_K)
+    groups = tl.arange(0, BLOCK_K // 32)
+    accumulator0 = tl.zeros((ROWS,), tl.float32)
+    accumulator1 = tl.zeros((ROWS,), tl.float32)
+    for start in range(0, K, BLOCK_K):
+        # One native weight tile and one weight-scale vector feed both rows.
+        w = tl.load(W + rows[:, None] * K + start + cols[None, :]).to(tl.float32)
+        w_scale = tl.load(WS + (first // 32) * (K // 32) + start // 32 + groups)
+        q0 = tl.load(Q + start + cols).to(tl.float32)
+        dots0 = tl.sum(tl.reshape(w * q0[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale0 = tl.load(QS + start // 32 + groups)
+        scaled0 = (dots0 * a_scale0[None, :]) * w_scale[None, :]
+        accumulator0 = accumulator0 + tl.sum(scaled0, axis=1)
+        q1 = tl.load(Q + K + start + cols).to(tl.float32)
+        dots1 = tl.sum(tl.reshape(w * q1[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale1 = tl.load(QS + K // 32 + start // 32 + groups)
+        scaled1 = (dots1 * a_scale1[None, :]) * w_scale[None, :]
+        accumulator1 = accumulator1 + tl.sum(scaled1, axis=1)
+    tl.store(Y + rows, accumulator0.to(tl.bfloat16))
+    tl.store(Y + N + rows, accumulator1.to(tl.bfloat16))
+
+
+def engram_gemv(q, qs, w, ws):
+    """Exact-shape Engram entry point, output [1,25600] BF16.
+
+No content validation/readback or new requantization is performed. Scales must
+come from the existing native loader and unchanged activation quantizer.
+"""
+    expected = ((q, (1, 6144), torch.float8_e4m3fn),
+                (qs, (1, 192), torch.float32),
+                (w, (25600, 6144), torch.float8_e4m3fn),
+                (ws, (800, 192), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError('Engram C1 GEMV requires exact native contiguous operands')
+        if tensor.device != q.device or tensor.device.type != 'cuda':
+            raise ValueError('Engram C1 GEMV requires one HIP device')
+    if not torch.version.hip or not torch.cuda.get_device_properties(q.device).gcnArchName.startswith('gfx1151'):
+        raise ValueError('Engram C1 GEMV is gfx1151-only')
+    output = torch.empty((1, 25600), dtype=torch.bfloat16, device=q.device)
+    _native_fp8_gemv_c1[(25600 // 4,)](q, qs, w, ws, output, 25600, 6144, 4, 512,
+                                  num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
+
+
+def native_wob_gemv(q, qs, w, ws):
+    """Native E4M3FN/E8M0 operands only; output [1,5120] BF16."""
+    expected = ((q, (1, 2048), torch.float8_e4m3fn),
+                (qs, (1, 64), torch.float32),
+                (w, (5120, 2048), torch.float8_e4m3fn),
+                (ws, (160, 64), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError('wo_b C1 GEMV requires exact native contiguous operands')
+        if tensor.device != q.device or tensor.device.type != 'cuda':
+            raise ValueError('wo_b C1 GEMV requires one HIP device')
+    if not torch.version.hip or torch.cuda.get_device_properties(q.device).gcnArchName.split(':')[0] != 'gfx1151':
+        raise ValueError('wo_b C1 GEMV is gfx1151-only')
+    output = torch.empty((1, 5120), dtype=torch.bfloat16, device=q.device)
+    _native_fp8_gemv_c1[(5120 // 4,)](q, qs, w, ws, output, 5120, 2048, 4, 512,
+                                     num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
+
+
+def native_wqkv_a_gemv(q, qs, w, ws):
+    """Only native E4M3FN/E8M0 `[1,5120] x [1792,5120]` operands."""
+    expected = ((q, (1, 5120), torch.float8_e4m3fn),
+                (qs, (1, 160), torch.float32),
+                (w, (1792, 5120), torch.float8_e4m3fn),
+                (ws, (56, 160), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError('fused wqkv_a C1 GEMV requires exact native contiguous operands')
+        if tensor.device != q.device or tensor.device.type != 'cuda':
+            raise ValueError('fused wqkv_a C1 GEMV requires one HIP device')
+    if not torch.version.hip or torch.cuda.get_device_properties(q.device).gcnArchName.split(':')[0] != 'gfx1151':
+        raise ValueError('fused wqkv_a C1 GEMV is gfx1151-only')
+    output = torch.empty((1, 1792), dtype=torch.bfloat16, device=q.device)
+    _native_fp8_gemv_c1[(1792 // 4,)](q, qs, w, ws, output, 1792, 5120, 4, 512,
+                                        num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
+
+
+def native_wqb_gemv(q, qs, w, ws):
+    """Only native E4M3FN/E8M0 `[1,1280] x [8192,1280]` operands."""
+    expected = ((q, (1, 1280), torch.float8_e4m3fn),
+                (qs, (1, 40), torch.float32),
+                (w, (8192, 1280), torch.float8_e4m3fn),
+                (ws, (256, 40), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError('wq_b C1 GEMV requires exact native contiguous operands')
+        if tensor.device != q.device or tensor.device.type != 'cuda':
+            raise ValueError('wq_b C1 GEMV requires one HIP device')
+    if not torch.version.hip or torch.cuda.get_device_properties(q.device).gcnArchName.split(':')[0] != 'gfx1151':
+        raise ValueError('wq_b C1 GEMV is gfx1151-only')
+    output = torch.empty((1, 8192), dtype=torch.bfloat16, device=q.device)
+    _native_fp8_gemv_c1[(8192 // 4,)](q, qs, w, ws, output, 8192, 1280, 4, 256,
+                                      num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
+
+
+def native_c2_gemv(q, qs, w, ws):
+    """Call only on the existing four flagged native V4.1 shapes."""
+    shapes = {
+        (25600, 6144): (800, 192, 512),
+        (5120, 2048): (160, 64, 512),
+        (1792, 5120): (56, 160, 512),
+        (8192, 1280): (256, 40, 256),
+    }
+    if w.shape not in shapes:
+        raise ValueError('C2 native GEMV requires one exact V4.1 weight shape')
+    n, k = w.shape
+    scale_n, scale_k, block_k = shapes[(n, k)]
+    expected = ((q, (2, k), torch.float8_e4m3fn),
+                (qs, (2, scale_k), torch.float32),
+                (w, (n, k), torch.float8_e4m3fn),
+                (ws, (scale_n, scale_k), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError('C2 native GEMV requires exact contiguous native operands')
+        if tensor.device != q.device or tensor.device.type != 'cuda':
+            raise ValueError('C2 native GEMV requires one HIP device')
+    if not torch.version.hip or torch.cuda.get_device_properties(q.device).gcnArchName.split(':')[0] != 'gfx1151':
+        raise ValueError('C2 native GEMV is gfx1151-only')
+    output = torch.empty((2, n), dtype=torch.bfloat16, device=q.device)
+    _native_c2_gemv[(n // 4,)](q, qs, w, ws, output, n, k, 4, block_k,
+                               num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
