+    def _mark_native_wq_b(self, config, quant_config) -> None:
+        """Native gfx1151 GEMV opt-in for this replicated [1280 -> 4096] FP8 projection.
+
+        The generic block-FP8 matmul tiles 64 rows, so a 1-4 row decode batch
+        spends its time decoding padded activations in software. The exact
+        shape, quantizer and layer checks mirror the attention ``wq_b`` opt-in.
+        """
+        import functools
+
+        from sglang.srt.layers.quantization.fp8 import Fp8Config, Fp8LinearMethod
+        from sglang.srt.layers.quantization.fp8_utils import (
+            triton_w8a8_block_fp8_linear,
+        )
+
+        method = self.wq_b.quant_method
+        block_linear = getattr(method, "w8a8_block_fp8_linear", None)
+        if (
+            getattr(config, "model_type", None) == "deepseek_v41"
+            and isinstance(quant_config, Fp8Config)
+            and isinstance(method, Fp8LinearMethod)
+            and quant_config.is_checkpoint_fp8_serialized
+            and quant_config.activation_scheme == "dynamic"
+            and quant_config.weight_block_size == [32, 32]
+            and quant_config.scale_fmt == "ue8m0"
+            and not method.use_mxfp8
+            and not method.block_fp8_as_mxfp8
+            and self.wq_b.input_size == 1280
+            and self.wq_b.output_size == self.n_heads * self.index_head_dim == 4096
+            and self.wq_b.bias is None
+            and isinstance(block_linear, functools.partial)
+            and block_linear.func is triton_w8a8_block_fp8_linear
+            and block_linear.keywords == {"act_scale_ue8m0": True}
+        ):
+            method.w8a8_block_fp8_linear = functools.partial(
+                block_linear, native_idx_wqb=True
+            )
+
