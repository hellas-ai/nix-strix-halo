+def native_idx_wqb_gemv(q, qs, w, ws):
+    """Indexer ``wq_b``: native E4M3FN/E8M0 ``[m,1280] x [4096,1280]``, m in 1, 2, 3, 4, 8.
+
+    Same per-token reduction as the attention ``wq_b`` kernels (K is also 1280):
+    a row's result does not depend on how many other rows are present. Three
+    rows run the four-row kernel on a zero-padded copy and return the first three.
+    """
+    n, k = 4096, 1280
+    if q.ndim != 2 or q.shape[0] not in (1, 2, 3, 4, 8):
+        raise ValueError("indexer wq_b GEMV requires 1, 2, 3, 4 or 8 token rows")
+    m = q.shape[0]
+    expected = ((q, (m, k), torch.float8_e4m3fn),
+                (qs, (m, k // 32), torch.float32),
+                (w, (n, k), torch.float8_e4m3fn),
+                (ws, (n // 32, k // 32), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError("indexer wq_b GEMV requires exact native contiguous operands")
+        if tensor.device != q.device or tensor.device.type != "cuda":
+            raise ValueError("indexer wq_b GEMV requires one HIP device")
+    if (not torch.version.hip or
+        torch.cuda.get_device_properties(q.device).gcnArchName.split(":")[0] != "gfx1151"):
+        raise ValueError("indexer wq_b GEMV is gfx1151-only")
+    rows = m
+    if m == 3:
+        q4 = torch.zeros((4, k), dtype=q.dtype, device=q.device)
+        qs4 = torch.ones((4, k // 32), dtype=qs.dtype, device=q.device)
+        q4[:3] = q
+        qs4[:3] = qs
+        q, qs, m = q4, qs4, 4
+    output = torch.empty((m, n), dtype=torch.bfloat16, device=q.device)
+    if m == 1:
+        _native_fp8_gemv_c1[(n // 4,)](q, qs, w, ws, output, n, k, 4, 256,
+                                       num_warps=4, num_stages=1, enable_fp_fusion=False)
+    elif m == 2:
+        _native_c2_gemv[(n // 8,)](q, qs, w, ws, output, n, k, 8, 256,
+                                   num_warps=4, num_stages=1, enable_fp_fusion=False)
+    else:
+        _native_c4_c8_gemv[(n // 8,)](q, qs, w, ws, output, n, k, m, 8, 256,
+                                      num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output[:rows]
