+
+_DRAFT_NATIVE_ROWS = 8
+
+
+def _draft_row_chunks(block_linear):
+    """Block-FP8 linear that serves 9..16 rows as chunks of at most eight rows (see _enable_native_projections)."""
+
+    def linear(input, weight, block_size, weight_scale, input_scale=None, bias=None):
+        rows = input.shape[0]
+        if (
+            input.ndim != 2
+            or bias is not None
+            or not _DRAFT_NATIVE_ROWS < rows <= 2 * _DRAFT_NATIVE_ROWS
+        ):
+            return block_linear(
+                input=input,
+                weight=weight,
+                block_size=block_size,
+                weight_scale=weight_scale,
+                input_scale=input_scale,
+                bias=bias,
+            )
+        return torch.cat(
+            [
+                block_linear(
+                    input=input[start : start + _DRAFT_NATIVE_ROWS],
+                    weight=weight,
+                    block_size=block_size,
+                    weight_scale=weight_scale,
+                    input_scale=(
+                        None
+                        if input_scale is None
+                        else input_scale[start : start + _DRAFT_NATIVE_ROWS]
+                    ),
+                    bias=None,
+                )
+                for start in range(0, rows, _DRAFT_NATIVE_ROWS)
+            ]
+        )
+
+    return linear
