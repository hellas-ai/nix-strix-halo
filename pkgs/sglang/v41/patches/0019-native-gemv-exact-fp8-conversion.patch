 @triton.jit
+def _e4m3fn_to_fp32(value):
+    """Decode every native E4M3FN code exactly, including signed zero and NaN."""
+    code = value.to(tl.uint8, bitcast=True).to(tl.uint32)
+    magnitude = code & 0x7F
+    normal_bits = (magnitude << 20) + 0x3C000000
+    # Every E4M3FN subnormal is an exactly representable normal FP32 value.
+    subnormal_bits = (magnitude.to(tl.float32) * 0.001953125).to(
+        tl.uint32, bitcast=True
+    )
+    magnitude_bits = tl.where(magnitude < 8, subnormal_bits, normal_bits)
+    # The existing cast emits signed canonical quiet NaNs for codes 0x7f/0xff.
+    magnitude_bits = tl.where(magnitude == 0x7F, 0x7FC00000, magnitude_bits)
+    return (magnitude_bits | ((code & 0x80) << 24)).to(tl.float32, bitcast=True)
+
