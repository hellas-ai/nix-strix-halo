+    def check_after_result_copy(
+        self, generation: int, host_status: torch.Tensor
+    ) -> None:
+        """Check the existing result D2H after copy_done, then permit reuse.
+
+        Any failure leaves the generation active. The caller must fail-stop the
+        whole TP service; there is no request retry or state rollback.
+        """
+        if self.active_generation != generation or not self.finished:
+            raise RuntimeError("stale or unfinished Engram result status")
+        if (
+            host_status is None
+            or host_status.is_cuda
+            or host_status.dtype != torch.int32
+            or host_status.shape != self.device_status.shape
+        ):
+            raise RuntimeError("missing or invalid Engram result status copy")
+        result = tuple(
+            (int(row[0]), int(row[1])) for row in host_status.tolist()
+        )
+        if any(code for row in result for code in row):
+            raise EngramPreflightError(generation, result)
+        self.retire(generation)
+
     def retire(self, generation: int) -> None:
         if self.active_generation != generation or not self.finished:
             raise RuntimeError("stale or unfinished Engram status retirement")
