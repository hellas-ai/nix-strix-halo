@@ -0,0 +1,76 @@
+"""Device-side count of the live rows of a padded decode CUDA-graph replay.
+
+A decode graph captured for `bs` request slots replays for any smaller batch by padding (C3 -> the
+C4 graph, 5..7 -> C8, a DSpark verify batch of 3 requests -> the 4-slot graph).  The padded rows are
+dead: nothing reads their outputs.  The kernels that read weights per *route* (the routed-expert
+MoE) should not spend bandwidth on them, but a captured graph cannot bake the live count in as a
+Python constant: it must read a device value that the replay path refreshes.
+
+`LiveRows` owns that value (one int32 on the device, a stable pointer for the lifetime of the
+runner); the graph runner
+
+  * assigns the padded row count while it warms up / captures a bucket (`set_capture`),
+  * publishes the live row count right before every replay (`publish`, a no-op when it did not
+    change, which is every step without padding), and
+  * exposes the tensor to the model code through `scope`, which is active only while capturing.
+
+Consumers call `active()`: a tensor during capture, `None` in eager execution (and outside any
+runner), where every row is live.  The row-count value is `bs * tokens_per_request`: padded rows are
+always the tail of the batch.
+
+`SGLANG_DSV41_MASK_PADDED_ROWS=0` disables the mechanism (nothing is allocated, `active()` is None).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+from typing import Optional
+
+import torch
+
+_OFF = ("0", "false", "off", "no")
+
+_ACTIVE: Optional[torch.Tensor] = None
+
+
+def enabled() -> bool:
+    return os.environ.get("SGLANG_DSV41_MASK_PADDED_ROWS", "1").strip().lower() not in _OFF
+
+
+def active() -> Optional[torch.Tensor]:
+    """The live-row tensor of the graph being captured, else None (eager: all rows are live)."""
+    return _ACTIVE
+
+
+@contextlib.contextmanager
+def scope(tensor: Optional[torch.Tensor]):
+    global _ACTIVE
+    previous = _ACTIVE
+    _ACTIVE = tensor
+    try:
+        yield
+    finally:
+        _ACTIVE = previous
+
+
+class LiveRows:
+    """One runner's device-side live row count."""
+
+    def __init__(self, capacity: int, device) -> None:
+        assert capacity >= 1
+        self.tensor = torch.full((1,), capacity, dtype=torch.int32, device=device)
+        self._host = capacity
+
+    def set_capture(self, rows: int) -> None:
+        """Before warming up / capturing a bucket of `rows` rows: every row of the capture is live."""
+        self._assign(rows)
+
+    def publish(self, rows: int) -> None:
+        """Before a replay: `rows` leading rows are live.  Stream-ordered with the replay (same stream)."""
+        self._assign(rows)
+
+    def _assign(self, rows: int) -> None:
+        if rows != self._host:
+            self.tensor.fill_(rows)
+            self._host = rows
