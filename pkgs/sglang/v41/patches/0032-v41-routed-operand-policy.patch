+def _official_routed_operand(x: torch.Tensor) -> torch.Tensor:
+    """Use the qualified group32 FP8 operand through the native W4A16 GEMM."""
+    from sglang.kernels.ops.quantization.fp8_kernel import (
+        sglang_per_token_group_quant_fp8,
+    )
+
+    q, scales = sglang_per_token_group_quant_fp8(
+        x.contiguous(), 32, eps=1e-4, column_major_scales=False,
+        scale_tma_aligned=False, scale_ue8m0=True, fuse_silu_and_mul=False,
+    )
+    # Power-of-two scales; no additional quantization of packed expert weights.
+    return (
+        q.float().reshape(*q.shape[:-1], -1, 32) * scales.unsqueeze(-1)
+    ).reshape(q.shape).to(torch.bfloat16)
+
