+    def _dsv41_hc_stats_overlap_eligible(self, x, forward_batch) -> bool:
+        if not (
+            _dsv41_hc_stats_overlap_enabled
+            and _is_hip
+            and self.config.model_type == "deepseek_v41"
+            and self.hc_stats_stream is None
+            and forward_batch is not None
+            and forward_batch.forward_mode == ForwardMode.EXTEND
+            and x.is_cuda
+            and x.dtype == torch.bfloat16
+            and x.is_contiguous()
+            and 64 <= x.shape[0] <= 65536
+            and x.shape[1:] == (self.hc_mult, 5120)
+            and self.hc_mult == 4
+            and not self.dsa_enable_prefill_cp
+            and not get_is_capture_mode()
+            and not torch.cuda.is_current_stream_capturing()
+        ):
+            return False
+        parallel = get_parallel()
+        return (
+            parallel.tp_size == parallel.attn_tp_size == 4
+            and parallel.attn_dp_size == 1
+            and not get_forward().sp_active
+            and torch.cuda.get_device_properties(x.device).gcnArchName.split(":")[0]
+            == "gfx1151"
+        )
+
+    def _dsv41_fork_hc_stats(self, x, callback):
+        """Run the unchanged generic HIP stats kernels beside a sublayer."""
+        if self._dsv41_hc_stats_overlap_stream is None:
+            self._dsv41_hc_stats_overlap_stream = torch.cuda.Stream(device=x.device)
+        side = self._dsv41_hc_stats_overlap_stream
+        main = torch.cuda.current_stream()
+        side.wait_stream(main)
+        x.record_stream(side)
+        with torch.cuda.stream(side):
+            coefficients = callback()
+            done = side.record_event()
+        for coefficient in coefficients:
+            coefficient.record_stream(main)
+        if not self._dsv41_hc_stats_overlap_logged:
+            logger.info(
+                "DSV41 mHC prefill stats overlap active: layer=%s rows=%s",
+                self.layer_id, x.shape[0],
+            )
+            self._dsv41_hc_stats_overlap_logged = True
+        return coefficients, done
+
