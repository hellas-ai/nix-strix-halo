+"""Default-off, blocking Engram preflight before target ModelRunner writes.
+
+This correctness arm stages the existing native file bytes before ModelRunner
+enters its COW/graph/model work. Its per-forward D2H and status host check are
+intentional temporary costs; it is *not* the mapped zero-host serving path.
+ForwardBatch construction, scheduler bookkeeping and draft proposal may already
+have happened. Routine lookup faults join the TP status collective; catastrophic
+GPU/collective errors require a fail-stop of the whole TP group, not retry.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+
+import torch
+
+from sglang.srt.layers.engram_preflight_status import EngramPreflightStatus
+from sglang.srt.layers.engram_store import ROW_BYTES
+
+
+logger = logging.getLogger(__name__)
+
+
+class EngramNativePreflight:
+    def __init__(self, *, model, device, tp_rank: int, tp_size: int, group_name: str):
+        if model.engram_hasher is None:
+            raise ValueError("Engram preflight requires the canonical hasher")
+        layers = {}
+        for layer in model.layers:
+            engram = getattr(layer, "engram", None)
+            if engram is not None:
+                layers[engram.layer_hash_index] = engram.embed.file_store
+        if set(layers) != {0, 1} or any(store is None for store in layers.values()):
+            raise ValueError("Engram preflight requires both native file shards")
+        self.hasher = model.engram_hasher
+        self.stores = (layers[0], layers[1])
+        self.device = device
+        self.status = EngramPreflightStatus(
+            device=device, tp_rank=tp_rank, tp_size=tp_size, group_name=group_name
+        )
+        fault = os.environ.get("SGLANG_ENGRAM_PREFLIGHT_FAULT", "")
+        self.fault = None
+        if fault:
+            try:
+                rank, layer, generation = map(int, fault.split(":"))
+            except ValueError as exc:
+                raise ValueError("Engram fault must be rank:layer:generation") from exc
+            if not (0 <= rank < tp_size and layer in (0, 1) and generation > 0):
+                raise ValueError("Engram fault rank/layer/generation is out of range")
+            self.fault = (rank, layer, generation)
+
+    def prepare(self, forward_batch) -> None:
+        if forward_batch.engram_packed_rows is not None:
+            raise RuntimeError("Engram preflight received already prepared rows")
+        mode = forward_batch.forward_mode
+        if not (mode.is_decode() or mode.is_target_verify() or mode.is_extend()):
+            raise ValueError("Engram preflight requires decode, verify or extend")
+        rows = int(forward_batch.input_ids.numel())
+        if rows <= 0:
+            raise ValueError("Engram preflight requires at least one live token")
+        generation = self.status.begin()
+        packed = None
+        target = None
+        try:
+            packed = torch.zeros(
+                (rows, 2, 24, ROW_BYTES), dtype=torch.uint8,
+                pin_memory=torch.cuda.is_available(),
+            )
+            target = packed.numpy()
+        except Exception:
+            logger.exception("Engram staging allocation failed on TP rank %d", self.status.tp_rank)
+            self.status.set_local_failure(0, 4)
+            self.status.set_local_failure(1, 4)
+        pending = None
+        ids_cpu = None
+        try:
+            ids, pending = self.hasher(
+                forward_batch.input_ids, forward_batch, defer_commit=True
+            )
+            if ids.shape != (rows, 2, 24):
+                raise ValueError("canonical Engram hash dimensions changed")
+            ids_cpu = ids.to(device="cpu")
+        except Exception:
+            logger.exception("Engram hash preflight failed on TP rank %d", self.status.tp_rank)
+            self.status.set_local_failure(0, 1)
+            self.status.set_local_failure(1, 1)
+
+        if ids_cpu is not None and target is not None:
+            for layer_index, store in enumerate(self.stores):
+                try:
+                    values = store.lookup(ids_cpu[:, layer_index].reshape(-1)).packed
+                    if values.shape != (rows * 24, ROW_BYTES):
+                        raise ValueError("native Engram packed row layout changed")
+                    target[:, layer_index] = values.reshape(rows, 24, ROW_BYTES)
+                except Exception:
+                    logger.exception(
+                        "Engram row preflight failed on TP rank %d layer %d",
+                        self.status.tp_rank, layer_index,
+                    )
+                    self.status.set_local_failure(layer_index, 2)
+        device_rows = None
+        if packed is not None:
+            try:
+                device_rows = packed.to(device=self.device, non_blocking=True)
+            except Exception:
+                logger.exception("Engram packed H2D preflight failed on TP rank %d", self.status.tp_rank)
+                self.status.set_local_failure(0, 3)
+                self.status.set_local_failure(1, 3)
+
+        if self.fault is not None:
+            fault_rank, fault_layer, fault_generation = self.fault
+            if (fault_rank, fault_generation) == (self.status.tp_rank, generation):
+                self.status.set_local_failure(fault_layer, 5)
+
+        # Every rank joins even after a local lookup error. The status copy is
+        # deliberately synchronizing and occurs before any model state write.
+        self.status.finish(generation)
+        try:
+            self.status.check_before_model(generation)
+        finally:
+            self.status.retire(generation)
+        if device_rows is None or pending is None:
+            raise RuntimeError("Engram preflight succeeded without rows/history")
+        self.hasher.commit_preflight(pending)
+        forward_batch.engram_packed_rows = device_rows
