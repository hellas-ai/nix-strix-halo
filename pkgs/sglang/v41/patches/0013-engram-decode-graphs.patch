+"""Bounded decode-graph input staging for file-backed DeepSeek V4.1 Engram.
+
+The model's existing GPU hasher remains the sole owner of hash arithmetic and
+request-history commits.  This module moves its two native-row reads out of the
+captured forward.  It intentionally supports only exact C1/C2 decode buckets.
+"""
+
+import torch
+
+from sglang.srt.layers.engram_store import ROW_BYTES
+
+
+class NativeEngramGraphPrestage:
+    def __init__(self, model, max_bs: int, device):
+        if max_bs != 2 or model.engram_hasher is None:
+            raise ValueError("Engram graph prestage requires C1/C2 and a hasher")
+        layers = {}
+        for layer in model.layers:
+            engram = getattr(layer, "engram", None)
+            if engram is not None:
+                layers[engram.layer_hash_index] = engram.embed.file_store
+        if set(layers) != {0, 1} or any(store is None for store in layers.values()):
+            raise ValueError("Engram graph prestage requires two native file stores")
+        self.hasher = model.engram_hasher
+        self.stores = (layers[0], layers[1])
+        self.gpu_rows = torch.zeros((2, 2, 24, ROW_BYTES), dtype=torch.uint8, device=device)
+        # Two frames bound page-locked memory even if the next decode arrives
+        # before the previous frame's H2D copy has completed.
+        self.host_frames = [
+            torch.empty((2, 2, 24, ROW_BYTES), dtype=torch.uint8, pin_memory=True)
+            for _ in range(2)
+        ]
+        self.frame_done = [torch.cuda.Event() for _ in range(2)]
+        self.frame_inflight = [False, False]
+        self.graph_done = torch.cuda.Event()
+        self.gpu_inflight = False
+        self.active_generation = None
+        self.generation = 0
+        self.pending = None
+
+    def prepare(self, forward_batch, graph_bs: int) -> int:
+        if self.pending is not None or self.active_generation is not None:
+            raise RuntimeError("previous Engram graph generation was not retired")
+        bs = forward_batch.batch_size
+        if (
+            not forward_batch.forward_mode.is_decode()
+            or bs not in (1, 2)
+            or graph_bs != bs
+            or forward_batch.input_ids.shape != (bs,)
+            or forward_batch.positions.shape != (bs,)
+            or forward_batch.req_pool_indices.shape != (bs,)
+            or forward_batch.out_cache_loc.shape != (bs,)
+            or forward_batch.engram_packed_rows is not None
+        ):
+            raise ValueError("Engram graph prestage requires a fresh exact C1/C2 decode")
+
+        # This call also commits the canonical per-request GPU history.  Once
+        # attempted, any failure must terminate the worker rather than retry.
+        self.generation += 1
+        generation = self.generation
+        ids = self.hasher(forward_batch.input_ids, forward_batch)
+        if ids.shape != (bs, 2, 24):
+            raise RuntimeError("unexpected canonical Engram hash layout")
+        ids_cpu = ids.to(device="cpu")  # one D2H synchronization for both layers
+
+        frame_index = (generation - 1) % 2
+        if self.frame_inflight[frame_index]:
+            self.frame_done[frame_index].synchronize()  # H2D still owns this frame
+            self.frame_inflight[frame_index] = False
+        frame = self.host_frames[frame_index]
+        frame.zero_()
+        target = frame.numpy()
+        for layer_index, store in enumerate(self.stores):
+            packed = store.lookup(ids_cpu[:, layer_index].reshape(-1)).packed
+            if packed.shape != (bs * 24, ROW_BYTES):
+                raise RuntimeError("native Engram lookup returned an invalid layout")
+            target[:bs, layer_index] = packed.reshape(bs, 24, ROW_BYTES)
+        self.pending = (generation, bs, frame_index)
+        return generation
+
+    def install(self, forward_batch, generation: int) -> None:
+        if self.pending is None or self.pending[0] != generation:
+            raise RuntimeError("stale or missing Engram graph generation")
+        _, bs, frame_index = self.pending
+        if forward_batch.batch_size != bs or forward_batch.engram_packed_rows is not None:
+            raise RuntimeError("Engram graph batch changed after preparation")
+        if self.gpu_inflight:
+            torch.cuda.current_stream().wait_event(self.graph_done)
+            self.gpu_inflight = False
+        self.gpu_rows[:bs].copy_(self.host_frames[frame_index][:bs], non_blocking=True)
+        self.frame_done[frame_index].record(torch.cuda.current_stream())
+        self.frame_inflight[frame_index] = True
+        forward_batch.engram_packed_rows = self.gpu_rows[:bs]
+        self.pending = None
+        self.active_generation = generation
+
+    def retire_after_replay(self, generation: int) -> None:
+        if self.active_generation != generation:
+            raise RuntimeError("Engram graph completion has a stale generation")
+        self.graph_done.record(torch.cuda.current_stream())
+        self.gpu_inflight = True
+        self.active_generation = None
