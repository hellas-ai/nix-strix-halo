+    This compresses the entire network path and performs the TP sum in FP32.
+    The per-rank quantization precedes the sum, so this is a separate numerical
+    policy from the default exact collective and the shard-compressed variant.
+    """
+    world = group.world_size
+    blocks = hidden_states.contiguous().view(-1, _DSV41_COMPRESSED_MOE_AR_BLOCK)
+    scales = blocks.abs().amax(dim=1).clamp_min(1.0e-12) / 127.0
+    encoded = torch.round(blocks / scales[:, None]).clamp_(-127, 127).to(torch.int8)
+    encoded = encoded.contiguous().view(-1)
+
+    gathered = torch.empty(
+        encoded.numel() * world, dtype=torch.int8, device=encoded.device
+    )
+    gathered_scales = torch.empty(
+        scales.numel() * world, dtype=torch.float32, device=encoded.device
+    )
+    group.all_gather_into_tensor(gathered, encoded)
+    group.all_gather_into_tensor(gathered_scales, scales)
+    decoded = gathered.view(world, -1, _DSV41_COMPRESSED_MOE_AR_BLOCK).float()
+    decoded = decoded * gathered_scales.view(world, -1, 1)
+    return decoded.sum(dim=0).view_as(hidden_states)
