+def _dsv41_compressed_moe_all_reduce(
+    hidden_states: torch.Tensor, group
+) -> torch.Tensor:
+    """FP32 TP sum, then block-scaled int8 transfer of each reduced shard.
+
+    Only the all-gather leg is lossy. The FP32 reduce-scatter preserves the
+    model's policy of summing expert outputs before the final BF16 cast.
+    """
+    world = group.world_size
+    flat = hidden_states.contiguous().view(-1)
+    shard = torch.empty(flat.numel() // world, dtype=torch.float32, device=flat.device)
+    group.reduce_scatter_tensor(shard, flat)
+
+    blocks = shard.view(-1, _DSV41_COMPRESSED_MOE_AR_BLOCK)
+    scales = blocks.abs().amax(dim=1).clamp_min(1.0e-12) / 127.0
+    encoded = torch.round(blocks / scales[:, None]).clamp_(-127, 127).to(torch.int8)
+    encoded = encoded.contiguous().view(-1)
+
+    gathered = torch.empty_like(flat, dtype=torch.int8)
+    gathered_scales = torch.empty(
+        scales.numel() * world, dtype=torch.float32, device=flat.device
+    )
+    group.all_gather_into_tensor(gathered, encoded)
+    group.all_gather_into_tensor(gathered_scales, scales)
+    return (
+        gathered.view(-1, _DSV41_COMPRESSED_MOE_AR_BLOCK).float()
+        * gathered_scales[:, None]
+    ).view_as(hidden_states)
+
