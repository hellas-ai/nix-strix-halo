+"""Opt-in prefill-only TP4 compressed ring for DeepSeek V4.1.
+
+The two callers gate model, parallel layout, dtype and rows. This module also
+fails closed on non-TP4/global-four, graph capture and unsupported layouts.
+Decode takes the unchanged exact collective path.
+"""
+
+import os
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+import torch
+import torch.distributed as dist
+
+_BLOCK = 256
+_MIN_ROWS = int(os.environ.get("SGLANG_DSV41_COMPRESSED_RING_MIN_ROWS", "0"))
+_PREFILL = ContextVar("dsv41_compressed_prefill", default=False)
+
+
+@contextmanager
+def dsv41_compressed_prefill_scope(enabled: bool):
+    token = _PREFILL.set(bool(enabled))
+    try:
+        yield
+    finally:
+        _PREFILL.reset(token)
+
+
+def is_dsv41_compressed_prefill() -> bool:
+    return _PREFILL.get()
+
+
+def compressed_ring_enabled_for_rows(rows: int) -> bool:
+    return _MIN_ROWS > 0 and rows >= max(64, _MIN_ROWS)
+
+
+def can_use_compressed_ring(x: torch.Tensor, group, dtype: torch.dtype) -> bool:
+    return (
+        x.ndim == 2
+        and is_dsv41_compressed_prefill()
+        and compressed_ring_enabled_for_rows(x.shape[0])
+        and x.device.type == "cuda"
+        and torch.version.hip is not None
+        and x.dtype == dtype
+        and x.shape[1] == 5120
+        and x.is_contiguous()
+        and x.numel() % (4 * _BLOCK) == 0
+        and group.world_size == 4
+        and dist.is_initialized()
+        and dist.get_world_size() == 4
+        and group.rank_in_group == dist.get_rank()
+        and not torch.cuda.is_current_stream_capturing()
+    )
+
+
+def _pack(values: torch.Tensor) -> torch.Tensor:
+    blocks = values.float().reshape(-1, _BLOCK)
+    scales = blocks.abs().amax(dim=1).clamp_min(1.0e-12) / 127.0
+    encoded = torch.round(blocks / scales[:, None]).clamp_(-127, 127).to(torch.int8)
+    return torch.cat(
+        (encoded.reshape(-1).view(torch.uint8), scales.contiguous().view(torch.uint8))
+    )
+
+
+def _unpack(packet: torch.Tensor, count: int) -> torch.Tensor:
+    encoded = packet[:count].view(torch.int8).float().reshape(-1, _BLOCK)
+    scales = packet[count:].view(torch.float32).reshape(-1, 1)
+    return (encoded * scales).reshape(-1)
+
+
+def compressed_ring_all_reduce(x: torch.Tensor, group) -> torch.Tensor:
+    """Reduce-scatter and gather with six 1-byte-plus-scale TP4 ring hops.
+
+    Every reduce-scatter hop decodes into FP32, adds that rank's local
+    contribution, then requantizes. The completed owner's shard is packaged
+    once more and circulated unchanged through the all-gather ring.
+    """
+    world, rank = group.world_size, group.rank_in_group
+    assert world == 4 and x.numel() % (world * _BLOCK) == 0
+    chunks = x.contiguous().view(-1).chunk(world)
+    count = chunks[0].numel()
+    partials = {rank: chunks[rank]}
+    prev_rank, next_rank = (rank - 1) % world, (rank + 1) % world
+
+    for step in range(world - 1):
+        send_idx = (rank - step) % world
+        recv_idx = (rank - step - 1) % world
+        send = _pack(partials[send_idx])
+        recv = torch.empty_like(send)
+        ops = [
+            dist.P2POp(dist.isend, send, next_rank, group.device_group),
+            dist.P2POp(dist.irecv, recv, prev_rank, group.device_group),
+        ]
+        for work in dist.batch_isend_irecv(ops):
+            work.wait()
+        partials[recv_idx] = _unpack(recv, count) + chunks[recv_idx].float()
+
+    owned_idx = (rank + 1) % world
+    packets = {owned_idx: _pack(partials[owned_idx])}
+    for step in range(world - 1):
+        send_idx = (rank - step + 1) % world
+        recv_idx = (rank - step) % world
+        send = packets[send_idx]
+        recv = torch.empty_like(send)
+        ops = [
+            dist.P2POp(dist.isend, send, next_rank, group.device_group),
+            dist.P2POp(dist.irecv, recv, prev_rank, group.device_group),
+        ]
+        for work in dist.batch_isend_irecv(ops):
+            work.wait()
+        packets[recv_idx] = recv
+
+    result = torch.cat([_unpack(packets[i], count) for i in range(world)])
+    return result.view_as(x).to(x.dtype)
