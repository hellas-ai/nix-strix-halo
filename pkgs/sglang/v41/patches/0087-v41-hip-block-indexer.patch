index 0000000..c477170
--- /dev/null
+++ b/sglang/kernels/ops/attention/dsv4/dsv41_indexer_block.hip.cpp
@@ -0,0 +1,262 @@
+// DSv4.1 FP4 paged indexer (gfx1151): out[row][pos] = WEIGHT_SCALE * sum_h w[row][h] * relu( sum_g qscale[row][h][g] * kscale[pos][g] * dot_g )
+// where dot_g is the E2M1 dot product of the row's head-h query and the position's key over scale group g (32 of the 128 dims).
+//
+// One workgroup = 8 consecutive query rows (one wave each) x one stripe of 64-position pages. The K page is decoded once per workgroup
+// (E2M1 -> int8 holding value*2, through a v_perm byte lookup) into LDS and used by all eight rows. Each row's 32 heads are two 16-row WMMA M tiles
+// held in registers as int8 A fragments; v_wmma_i32_16x16x16_iu8 computes the exact integer dot products of each 32-dim scale group (|sum| <= 4608).
+// The group scales are powers of two, so the four group sums are combined EXACTLY in the integer domain: shift each by (qe - qlo) + (ke - klo)
+// (both small), add, and apply the common factor 2^(qlo + klo - 256) once. The guard (qhi - qlo) + (khi - klo) <= 16 keeps the int32 sums in
+// range (the Triton kernel's fp32 path needs <= 8). Then relu, the head weights and the head sum.
+// Pages outside the guarded scale range, and pages where the rows of the workgroup disagree on the page, take a scalar fp32 path.
+#include <hip/hip_runtime.h>
+#include <stdint.h>
+
+typedef int v4i __attribute__((ext_vector_type(4)));
+typedef int v8i __attribute__((ext_vector_type(8)));
+typedef float f32x4 __attribute__((ext_vector_type(4)));
+typedef unsigned int u32x4 __attribute__((ext_vector_type(4)));
+
+#define WAVES 8
+#define NT (WAVES * 32)
+#define KPITCH 144  // bytes per position row of the decoded K page in LDS: 128 int8 + 16 pad
+
+__device__ __forceinline__ unsigned perm(unsigned s0, unsigned s1, unsigned sel) { return __builtin_amdgcn_perm(s0, s1, sel); }
+
+// 8 packed E2M1 nibbles (dims 8j..8j+7, low nibble = even dim) -> 8 int8 (value * 2) in dim order, as two dwords.
+__device__ __forceinline__ void fp4_to_i8(unsigned d, unsigned& o0, unsigned& o1) {
+  const unsigned em = d & 0x07070707u, om = (d >> 4) & 0x07070707u;
+  const unsigned emask = ((d >> 3) & 0x01010101u) * 0xFFu, omask = ((d >> 7) & 0x01010101u) * 0xFFu;
+  const unsigned ep = perm(0x0C080604u, 0x03020100u, em), en = perm(0xF4F8FAFCu, 0xFDFEFF00u, em);
+  const unsigned op = perm(0x0C080604u, 0x03020100u, om), on = perm(0xF4F8FAFCu, 0xFDFEFF00u, om);
+  const unsigned E = ep ^ ((ep ^ en) & emask), O = op ^ ((op ^ on) & omask);
+  o0 = perm(O, E, 0x05010400u);
+  o1 = perm(O, E, 0x07030602u);
+}
+
+__device__ __forceinline__ float e2m1_value(unsigned code) {  // scalar fallback: the same table as the Triton _e2m1
+  const float mag[8] = {0.f, 0.5f, 1.f, 1.5f, 2.f, 3.f, 4.f, 6.f};
+  const float v = mag[code & 7];
+  return (code & 8) ? -v : v;
+}
+
+__device__ __forceinline__ float scale_f32(unsigned byte) { return __builtin_bit_cast(float, byte << 23); }
+
+struct Smem {
+  alignas(16) uint8_t ktile[2][64 * KPITCH];
+  alignas(16) unsigned keb[2][64];   // the four scale bytes of each position
+  unsigned krange[2][WAVES][2];   // per buffer, per wave: min and max of the scale bytes it decoded
+  int rowlen[WAVES];
+};
+
+__global__ void __launch_bounds__(NT, 1)
+indexer_kernel(const uint8_t* __restrict__ q, long q_stride, const uint8_t* __restrict__ qs, long qs_stride,
+               const uint8_t* __restrict__ k, const uint8_t* __restrict__ ks, const __bf16* __restrict__ wgt, long w_stride,
+               const int* __restrict__ pt, long pt_stride, const int* __restrict__ lens, float* __restrict__ out,
+               int rows, int width, int page_cols, int pages, float weight_scale, int force_slow) {
+  __shared__ Smem sm;
+  const int tid = threadIdx.x, w = tid >> 5, lane = tid & 31, h = lane >> 4, col = lane & 15;
+  const int row = blockIdx.x * WAVES + w;
+  const bool row_ok = row < rows;
+  const float NEG_INF = __builtin_bit_cast(float, 0xFF800000u);
+  const int len = row_ok ? min(lens[row], width) : 0;
+  const long out_row = (long)row * width;
+
+  // ---- per-row query state: int8 A fragments (2 M tiles of 16 heads x 8 chunks of 16 dims), packed scale codes, head weights ----
+  v4i afr[2][8];
+  unsigned qraw[2][8];  // the four group scale codes of head 16m + 2r + h, one per byte
+  float wv[2][8];
+  unsigned qlo = 255, qhi = 0;
+  if (row_ok) {
+#pragma unroll
+    for (int m = 0; m < 2; ++m) {
+      const u32x4* qp = (const u32x4*)(q + (long)row * q_stride + (16 * m + col) * 64);
+      unsigned dd[16];
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const u32x4 v = qp[i];
+        dd[4 * i] = v[0]; dd[4 * i + 1] = v[1]; dd[4 * i + 2] = v[2]; dd[4 * i + 3] = v[3];
+      }
+#pragma unroll
+      for (int c = 0; c < 8; ++c) {
+        unsigned a0, a1, a2, a3;
+        fp4_to_i8(dd[2 * c], a0, a1);
+        fp4_to_i8(dd[2 * c + 1], a2, a3);
+        afr[m][c] = (v4i){(int)a0, (int)a1, (int)a2, (int)a3};
+      }
+#pragma unroll
+      for (int r = 0; r < 8; ++r) {
+        const int head = 16 * m + 2 * r + h;
+        unsigned packed = 0;
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+          const unsigned qe = qs[(long)row * qs_stride + g * 64 + (head % 16) * 4 + head / 16];
+          packed |= qe << (8 * g);
+          qlo = min(qlo, qe); qhi = max(qhi, qe);
+        }
+        qraw[m][r] = packed;
+        wv[m][r] = (float)wgt[(long)row * w_stride + head];
+      }
+    }
+    // the other half-wave holds the other parity of heads
+    qlo = min(qlo, (unsigned)__builtin_amdgcn_permlanex16(0, qlo, 0x76543210u, 0xFEDCBA98u, false, false));
+    qhi = max(qhi, (unsigned)__builtin_amdgcn_permlanex16(0, qhi, 0x76543210u, 0xFEDCBA98u, false, false));
+  }
+  unsigned qsh[2][8];
+#pragma unroll
+  for (int m = 0; m < 2; ++m)
+#pragma unroll
+    for (int r = 0; r < 8; ++r) qsh[m][r] = qraw[m][r] - qlo * 0x01010101u;
+  // ---- tail: -inf for positions at and past the row length (disjoint from the live stores) ----
+  if (row_ok) {
+    for (int start = blockIdx.y * 1024; start < width; start += gridDim.y * 1024)
+      for (int i = lane; i < 1024; i += 32) {
+        const int pos = start + i;
+        if (pos < width && pos >= len) out[out_row + pos] = NEG_INF;
+      }
+  }
+  // ---- workgroup extent ----
+  if (lane == 0) sm.rowlen[w] = len;
+  __syncthreads();
+  int maxlen = 0;
+  for (int i = 0; i < WAVES; ++i) maxlen = max(maxlen, sm.rowlen[i]);
+  const int nblk = (maxlen + 63) / 64;
+  const int row_ref = min(rows - 1, blockIdx.x * WAVES + WAVES - 1);
+
+  // decode of one 64-position page by the whole workgroup: thread = (group g, position p)
+  const int dg = tid >> 6, dp = tid & 63;
+  auto fetch = [&](int blk, u32x4& raw, unsigned& keb, int& pg) {
+    pg = blk < page_cols ? pt[(long)row_ref * pt_stride + blk] : -1;
+    if (pg >= 0 && pg < pages) {
+      raw = *(const u32x4*)(k + (long)pg * 4096 + dg * 1024 + dp * 16);
+      keb = ks[(long)pg * 256 + dg * 64 + (dp % 16) * 4 + dp / 16];
+    } else {
+      raw = (u32x4){0, 0, 0, 0};
+      keb = 127;
+    }
+  };
+  auto store_decoded = [&](int buf, u32x4 raw, unsigned keb, int p0n) {
+    unsigned o[8];
+    fp4_to_i8(raw[0], o[0], o[1]);
+    fp4_to_i8(raw[1], o[2], o[3]);
+    fp4_to_i8(raw[2], o[4], o[5]);
+    fp4_to_i8(raw[3], o[6], o[7]);
+    u32x4* dst = (u32x4*)&sm.ktile[buf][dp * KPITCH + dg * 32];
+    dst[0] = (u32x4){o[0], o[1], o[2], o[3]};
+    dst[1] = (u32x4){o[4], o[5], o[6], o[7]};
+    // the four group bytes of a position share one dword
+    ((uint8_t*)&sm.keb[buf][dp])[dg] = (uint8_t)keb;
+    // scale range of this wave's 32 (group, position) entries, restricted to positions below the longest row of the workgroup
+    const bool live_pos = (p0n + dp) < maxlen;
+    unsigned lo = live_pos ? keb : 255u, hi = live_pos ? keb : 0u;
+    for (int o = 1; o < 16; o <<= 1) {
+      lo = min(lo, (unsigned)__shfl_xor((int)lo, o)); hi = max(hi, (unsigned)__shfl_xor((int)hi, o));
+    }
+    lo = min(lo, (unsigned)__builtin_amdgcn_permlanex16(0, lo, 0x76543210u, 0xFEDCBA98u, false, false));
+    hi = max(hi, (unsigned)__builtin_amdgcn_permlanex16(0, hi, 0x76543210u, 0xFEDCBA98u, false, false));
+    if (lane == 0) { sm.krange[buf][w][0] = lo; sm.krange[buf][w][1] = hi; }
+  };
+
+  int first = blockIdx.y;
+  if (first < nblk) {
+    u32x4 raw; unsigned keb; int pg;
+    fetch(first, raw, keb, pg);
+    store_decoded(0, raw, keb, first * 64);
+  }
+  __syncthreads();
+
+  int it = 0;
+  for (int blk = first; blk < nblk; blk += gridDim.y, ++it) {
+    const int buf = it & 1;
+    const int next = blk + gridDim.y;
+    u32x4 raw_n = (u32x4){0, 0, 0, 0}; unsigned keb_n = 127; int pg_n = -1;
+    if (next < nblk) fetch(next, raw_n, keb_n, pg_n);
+
+    const int p0 = blk * 64;
+    if (row_ok && p0 < len) {
+      const int my_page = blk < page_cols ? pt[(long)row * pt_stride + blk] : -1;
+      const int live_n = min(64, len - p0);                      // live positions in this page for this row
+      float* orow = out + out_row + p0;
+      if (my_page < 0 || my_page >= pages) {
+        for (int i = lane; i < live_n; i += 32) orow[i] = NEG_INF;
+      } else {
+        bool fast = !force_slow && my_page == (blk < page_cols ? pt[(long)row_ref * pt_stride + blk] : -2);
+        unsigned klo = 255, khi = 0;
+        if (fast) {
+#pragma unroll
+          for (int i = 0; i < WAVES; ++i) { klo = min(klo, sm.krange[buf][i][0]); khi = max(khi, sm.krange[buf][i][1]); }
+          fast = (qlo >= 2) & (qhi <= 252) & (klo >= 2) & (khi <= 252) & (qlo + klo >= 130) & (qhi + khi <= 368) & ((qhi - qlo) + (khi - klo) <= 16);
+        }
+        if (fast) {
+          const unsigned kb4 = klo * 0x01010101u;
+          const float cscale = __builtin_bit_cast(float, (qlo + klo - 129u) << 23);   // 2^(qlo + klo - 256)
+#pragma unroll
+          for (int t = 0; t < 4; ++t) {
+            if (t * 16 >= live_n) break;
+            const uint8_t* kb = &sm.ktile[buf][(t * 16 + col) * KPITCH];
+            const unsigned kshp = sm.keb[buf][t * 16 + col] - kb4;
+            v4i bfr[8];
+#pragma unroll
+            for (int c = 0; c < 8; ++c) bfr[c] = *(const v4i*)(kb + 16 * c);
+            float score = 0.f;
+#pragma unroll
+            for (int m = 0; m < 2; ++m) {
+              v8i acc[4];
+#pragma unroll
+              for (int g = 0; g < 4; ++g) {
+                acc[g] = (v8i){0, 0, 0, 0, 0, 0, 0, 0};
+                acc[g] = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true, afr[m][2 * g], true, bfr[2 * g], acc[g], false);
+                acc[g] = __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true, afr[m][2 * g + 1], true, bfr[2 * g + 1], acc[g], false);
+              }
+#pragma unroll
+              for (int r = 0; r < 8; ++r) {
+                const unsigned sh = qsh[m][r] + kshp;
+                const int tot = ((acc[0][r] << (sh & 31)) + (acc[1][r] << ((sh >> 8) & 31))) + ((acc[2][r] << ((sh >> 16) & 31)) + (acc[3][r] << ((sh >> 24) & 31)));
+                score = __builtin_fmaf((float)max(tot, 0), wv[m][r], score);
+              }
+            }
+            score += __shfl_xor(score, 16);   // the other half-wave holds the odd heads
+            const int pos_in = t * 16 + col;
+            if (h == 0 && pos_in < live_n) orow[pos_in] = score * cscale * weight_scale;
+          }
+        } else {
+          // scalar fp32 path (unusual scales, or the rows of this workgroup do not share the page): every lane scores one or two positions
+          for (int pp = lane; pp < live_n; pp += 32) {
+            const int off = pp;
+            float ksc[4];
+            const uint8_t* kpg = k + (long)my_page * 4096;
+            for (int g = 0; g < 4; ++g) ksc[g] = scale_f32(ks[(long)my_page * 256 + g * 64 + (off % 16) * 4 + off / 16]);
+            float score = 0.f;
+            for (int head = 0; head < 32; ++head) {
+              float dot = 0.f;
+              for (int g = 0; g < 4; ++g) {
+                const float qsc = scale_f32(qs[(long)row * qs_stride + g * 64 + (head % 16) * 4 + head / 16]);
+                for (int dd = 0; dd < 32; ++dd) {
+                  const unsigned kb = kpg[g * 1024 + off * 16 + dd / 2], qb = q[(long)row * q_stride + head * 64 + g * 16 + dd / 2];
+                  const float kv = e2m1_value((kb >> ((dd & 1) * 4)) & 15) * ksc[g];
+                  const float qv = e2m1_value((qb >> ((dd & 1) * 4)) & 15) * qsc;
+                  dot += kv * qv;
+                }
+              }
+              score += fmaxf(dot, 0.f) * (float)wgt[(long)row * w_stride + head];
+            }
+            orow[pp] = score * weight_scale;
+          }
+        }
+      }
+    }
+    // next page into the other buffer; everyone is done reading buffer `buf` of the previous iteration after the barrier below
+    if (next < nblk) store_decoded(buf ^ 1, raw_n, keb_n, next * 64);
+    __syncthreads();
+  }
+}
+
+extern "C" int dsv41_fp4_indexer(const void* q, long q_stride, const void* qs, long qs_stride, const void* k, const void* ks, const void* w, long w_stride,
+                                 const int* pt, long pt_stride, const int* lens, float* out, int rows, int width, int page_cols, int pages,
+                                 float weight_scale, int splits, int force_slow, void* stream) {
+  if (rows <= 0) return 0;
+  if (splits < 1) splits = 1;
+  hipLaunchKernelGGL(indexer_kernel, dim3((rows + WAVES - 1) / WAVES, splits), dim3(NT), 0, (hipStream_t)stream, (const uint8_t*)q, q_stride,
+                     (const uint8_t*)qs, qs_stride, (const uint8_t*)k, (const uint8_t*)ks, (const __bf16*)w, w_stride, pt, pt_stride, lens, out, rows, width,
+                     page_cols, pages, weight_scale, force_slow);
+  return (int)hipGetLastError();
+}
diff --git a/sglang/kernels/ops/attention/dsv4/fp4_indexer_block_hip.py b/sglang/kernels/ops/attention/dsv4/fp4_indexer_block_hip.py
new file mode 100644
index 0000000..38ed6d3
--- /dev/null
+++ b/sglang/kernels/ops/attention/dsv4/fp4_indexer_block_hip.py
@@ -0,0 +1,68 @@
+"""Hand-written WMMA FP4 indexer for the V4.1 prefill (gfx1151, 32 heads, head_dim 128).
+
+One workgroup scores eight consecutive query rows of one request against 64-key pages: each page of E2M1 keys is decoded once into LDS (int8
+holding value*2) and used by all eight rows; the per-scale-group dot products run on the int8 matrix cores (exact integers) and the power-of-two
+group scales are combined exactly in the integer domain (shift and add) before one conversion to fp32. relu, the head weights and the head sum
+follow. The installed Triton kernel decodes the queries again for every 32 keys and every row; this one is 4.5-6.6x faster on the dumped real
+layers at 16K and 49K context, and agrees with it to within 2 fp32 ulps (the head-sum order differs); the top-512 sets are identical.
+
+Default off: SGLANG_DSV41_HIP_INDEXER=1. Used only when the caller proves from CPU metadata that all rows belong to one request (single-request
+EXTEND), because the workgroup shares each decoded key page between its rows; if the rows of a workgroup nevertheless disagree on a page the kernel
+scores those rows on a (slow) scalar fp32 path, so the result stays correct.
+"""
+from __future__ import annotations
+
+import ctypes
+import os
+from pathlib import Path
+
+import torch
+
+_ENABLED = os.environ.get("SGLANG_DSV41_HIP_INDEXER") == "1"
+_lib = None
+
+
+def enabled() -> bool:
+    return _ENABLED
+
+
+def _load():
+    global _lib
+    if _lib is None:
+        path = os.environ.get("SGLANG_DSV41_HIP_INDEXER_SO") or str(Path(__file__).with_name("libdsv41_indexer_block.so"))
+        lib = ctypes.CDLL(path)
+        lib.dsv41_fp4_indexer.restype = ctypes.c_int
+        _lib = lib
+    return _lib
+
+
+def _ptr(x: torch.Tensor):
+    return ctypes.c_void_p(x.data_ptr())
+
+
+def supported(q, q_scale, k, k_scale, weights, page_table, lengths, out) -> bool:
+    return (
+        q.shape[1] == 32 and q.shape[2] == 64 and q.stride(2) == 1 and q.stride(1) == 64
+        and weights.dtype == torch.bfloat16 and weights.stride(1) == 1
+        and page_table.dtype == torch.int32 and lengths.dtype == torch.int32
+        and out.dtype == torch.float32 and out.is_contiguous() and out.shape[0] == q.shape[0]
+        and k.dtype in (torch.uint8, torch.float4_e2m1fn_x2) and k_scale.dtype == torch.uint8
+    )
+
+
+def paged_logits_block(q, q_scale, k, k_scale, weights, page_table, lengths, weight_scale, out) -> torch.Tensor:
+    rows = q.shape[0]
+    q8 = q.view(torch.uint8)
+    k8 = k.view(torch.uint8)
+    width = out.shape[1]
+    groups = (rows + 7) // 8
+    splits = max(1, min((width + 63) // 64, -(-320 // groups)))
+    rc = _load().dsv41_fp4_indexer(
+        _ptr(q8), ctypes.c_long(q8.stride(0)), _ptr(q_scale), ctypes.c_long(q_scale.stride(0)), _ptr(k8), _ptr(k_scale),
+        _ptr(weights), ctypes.c_long(weights.stride(0)), _ptr(page_table), ctypes.c_long(page_table.stride(0)), _ptr(lengths), _ptr(out),
+        ctypes.c_int(rows), ctypes.c_int(width), ctypes.c_int(page_table.shape[1]), ctypes.c_int(k8.shape[0]), ctypes.c_float(weight_scale),
+        ctypes.c_int(splits), ctypes.c_int(0), ctypes.c_void_p(torch.cuda.current_stream().cuda_stream),
+    )
+    if rc != 0:
+        raise RuntimeError(f"dsv41_fp4_indexer launch failed: hip error {rc}")
+    return out
