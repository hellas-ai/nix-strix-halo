     if rows == 0:
         return out
+    if single_request_rows and heads == 32 and os.environ.get("SGLANG_DSV41_HIP_INDEXER") == "1":
+        from sglang.kernels.ops.attention.dsv4 import fp4_indexer_block_hip
+
+        if (fp4_indexer_block_hip.supported(q, q_scale, k, k_scale, weights, page_table, lengths, out)
+                and q.device.type == "cuda" and use_gfx1151_indexer(q.device)):
+            return fp4_indexer_block_hip.paged_logits_block(
+                q, q_scale, k, k_scale, weights, page_table, lengths, weight_scale, out
+            )
     # Only a CPU-proven same-request full M1536 prefill may pair rows.
     # V4.1 C1/C2 uses 64-page buckets of 64 keys; the tested end contexts
     # span 12,288..65,536 key columns. M1/M4 and mixed requests fall back.
