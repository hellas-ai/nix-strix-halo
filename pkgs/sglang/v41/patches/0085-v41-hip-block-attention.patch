+++ b/sglang/kernels/ops/attention/nsa_triton_decode/dsv41_hip_attention.py
@@ -0,0 +1,140 @@
+"""Hand-written WMMA sparse attention for the V4.1 prefill (gfx1151, 16 heads per rank, head_dim 512).
+
+One workgroup per query row. The kernel gathers the selected keys straight from the paged fp8 KV cache (main scope, extra scope),
+dequantises them to bf16 exactly (fp8 * 2^k is exact in bf16), and runs QK^T, the online softmax (with the attention sink) and PV on
+the matrix cores. The installed Triton kernel does the same work one query at a time with eight [16, 64] fp32 accumulators and spills
+heavily; this kernel keeps the 16x512 accumulator across the four waves of the workgroup (128 output dims each).
+
+Default off: SGLANG_DSV41_HIP_ATTENTION=1 enables it for calls with at least SGLANG_DSV41_HIP_ATTENTION_MIN_ROWS rows (default 17, so the
+decode and DSpark verify shapes keep the installed split-K kernels). SGLANG_DSV41_HIP_ATTENTION_DECODE=1 additionally routes 1..16 rows, where
+one workgroup per query would leave the GPU idle: the key tiles of each query are divided over 8 (<= 8 rows), 4 (<= 16) or 2 (<= 32) workgroups
+and merged by a second small kernel (33-52 us per call against 145-230 us for the installed split-K path).
+Anything the kernel does not cover (other head counts, page sizes, dtypes, non-gfx1151) falls back to the installed path.
+
+Results are not bit-identical to the Triton kernel (different fp32 summation order inside the matrix-core accumulators); they agree to
+bf16 rounding (see tests/hip-block-attention-gpu.py).
+"""
+from __future__ import annotations
+
+import ctypes
+import logging
+import os
+from functools import lru_cache
+from pathlib import Path
+from typing import Optional, Tuple
+
+import torch
+
+_ENABLED = os.environ.get("SGLANG_DSV41_HIP_ATTENTION") == "1"
+_DECODE = os.environ.get("SGLANG_DSV41_HIP_ATTENTION_DECODE") == "1"
+_MIN_ROWS = int(os.environ.get("SGLANG_DSV41_HIP_ATTENTION_MIN_ROWS", "17"))
+_lib = None
+_seen = set()
+
+
+def enabled() -> bool:
+    return _ENABLED or _DECODE
+
+
+@lru_cache(maxsize=None)
+def _is_gfx1151(device: torch.device) -> bool:
+    return (
+        device.type == "cuda"
+        and bool(torch.version.hip)
+        and torch.cuda.get_device_properties(device).gcnArchName.split(":")[0] == "gfx1151"
+    )
+
+
+def _load():
+    global _lib
+    if _lib is None:
+        path = os.environ.get("SGLANG_DSV41_HIP_ATTENTION_SO") or str(Path(__file__).with_name("libdsv41_attn_block.so"))
+        lib = ctypes.CDLL(path)
+        lib.dsv41_attn_block.restype = ctypes.c_int
+        _lib = lib
+    return _lib
+
+
+def _paged_fp8(cache: torch.Tensor) -> bool:
+    page = cache.shape[1] if cache.ndim == 4 else 0
+    return (
+        cache.ndim == 4 and cache.shape[2] == 1 and cache.shape[3] == 528 and cache.element_size() == 1
+        and cache.stride(3) == 1 and cache.stride(1) == 528 and cache.stride(0) >= page * 528
+        and page > 0 and (page & (page - 1)) == 0
+    )
+
+
+def supported(q, k_cache, indices, topk_length, extra_k_cache, extra_indices, extra_topk_length, attn_sink, s_q) -> bool:
+    rows = q.shape[0] * q.shape[1] if q.ndim == 4 else 0
+    if rows <= 0 or not ((rows <= 16 and _DECODE) or (rows > 16 and _ENABLED and rows >= _MIN_ROWS)):
+        return False
+    if not (q.ndim == 4 and s_q == 1 and q.shape[1] == 1 and q.shape[2:] == (16, 512) and q.dtype == torch.bfloat16 and q.stride(3) == 1):
+        return False
+    if not _paged_fp8(k_cache) or indices.dtype != torch.int32 or indices.shape[0] != rows:
+        return False
+    if (extra_k_cache is None) != (extra_indices is None):
+        return False
+    if extra_k_cache is not None and (not _paged_fp8(extra_k_cache) or extra_indices.dtype != torch.int32 or extra_indices.shape[0] != rows):
+        return False
+    if attn_sink is not None and (attn_sink.dtype != torch.float32 or attn_sink.numel() != 16 or not attn_sink.is_contiguous()):
+        return False
+    for ln in (topk_length, extra_topk_length):
+        if ln is not None and (ln.dtype != torch.int32 or ln.numel() != rows):
+            return False
+    return _is_gfx1151(q.device)
+
+
+def _ptr(x: Optional[torch.Tensor]):
+    return ctypes.c_void_p(x.data_ptr() if x is not None else 0)
+
+
+def attention(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    indices: torch.Tensor,
+    topk_length: Optional[torch.Tensor],
+    extra_k_cache: Optional[torch.Tensor],
+    extra_indices: Optional[torch.Tensor],
+    extra_topk_length: Optional[torch.Tensor],
+    attn_sink: Optional[torch.Tensor],
+    sm_scale: float,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """q [T,1,16,512] bf16; returns (out [T,1,16,512] bf16, lse [T,1,16] fp32), same conventions as triton_fp8_attention_fwd."""
+    rows = q.shape[0]
+    q3 = q.reshape(rows, 16, 512)
+    out = torch.empty(rows, 16, 512, dtype=torch.bfloat16, device=q.device)
+    lse = torch.empty(rows, 16, dtype=torch.float32, device=q.device)
+    splits = 8 if rows <= 8 else 4 if rows <= 16 else 2 if rows <= 32 else 1
+    key = (rows if rows <= 16 else 17, splits, extra_k_cache is not None, attn_sink is not None)
+    if key not in _seen:
+        _seen.add(key)
+        logging.getLogger(__name__).info(
+            "DSV41 HIP attention active: rows=%s splits=%s extra=%s sink=%s", rows, splits, key[2], key[3]
+        )
+    if splits > 1:
+        part_o = torch.empty(rows, splits, 16, 512, dtype=torch.float32, device=q.device)
+        part_m = torch.empty(rows, splits, 16, dtype=torch.float32, device=q.device)
+        part_l = torch.empty(rows, splits, 16, dtype=torch.float32, device=q.device)
+    else:
+        part_o = part_m = part_l = None
+    scopes = []
+    for cache, idx, ln in ((k_cache, indices, topk_length), (extra_k_cache, extra_indices, extra_topk_length)):
+        if cache is None:
+            scopes.append((None, None, None, 0, 0, 0, 0))
+            continue
+        idx2 = idx.reshape(rows, -1).contiguous()
+        ln1 = ln.reshape(-1).contiguous() if ln is not None else None
+        scopes.append((cache, idx2, ln1, idx2.stride(0), idx2.shape[1], cache.stride(0), cache.shape[1]))
+    args = []
+    for cache, idx2, ln1, sidx, topk, pstride, page in scopes:
+        args += [_ptr(cache), _ptr(idx2), _ptr(ln1), ctypes.c_long(sidx), ctypes.c_int(topk), ctypes.c_long(pstride), ctypes.c_int(page)]
+    rc = _load().dsv41_attn_block(
+        _ptr(q3), ctypes.c_long(q3.stride(0)), ctypes.c_long(q3.stride(1)), *args,
+        _ptr(attn_sink), _ptr(out), ctypes.c_long(out.stride(0)), ctypes.c_long(out.stride(1)),
+        _ptr(lse), ctypes.c_long(lse.stride(0)), ctypes.c_float(sm_scale), ctypes.c_int(rows),
+        ctypes.c_int(splits), _ptr(part_o), _ptr(part_m), _ptr(part_l),
+        ctypes.c_void_p(torch.cuda.current_stream().cuda_stream),
+    )
+    if rc != 0:
+        raise RuntimeError(f"dsv41_attn_block launch failed: hip error {rc}")
+    return out.view(rows, 1, 16, 512), lse.view(rows, 1, 16)
