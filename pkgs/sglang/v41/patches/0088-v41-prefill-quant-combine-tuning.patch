+@triton.jit
+def _per_token_group_quant_8bit_ue8m0_rowmajor_blocked(
+    x_ptr,
+    q_ptr,
+    s_ptr,
+    n_groups,
+    group_size: tl.constexpr,
+    eps: tl.constexpr,
+    fp8_min: tl.constexpr,
+    fp8_max: tl.constexpr,
+    GROUPS: tl.constexpr,
+):
+    # Same arithmetic per group as `_per_token_group_quant_8bit_ue8m0_rowmajor`, but one program owns GROUPS consecutive groups
+    # (GROUPS * group_size contiguous values) instead of one: the one-group programs read 64-byte pieces and are launch-bound
+    # (0.6 ms for a [1536, 5120] bf16 tensor, 15% of the memory bandwidth).
+    first = tl.program_id(0) * GROUPS
+    g = first + tl.arange(0, GROUPS)
+    cols = tl.arange(0, group_size)
+    offs = g[:, None] * group_size + cols[None, :]
+    live = (g < n_groups)[:, None]
+    x = tl.load(x_ptr + offs, mask=live, other=0).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(x), 1), eps)
+    scale = tl.exp2(tl.ceil(tl.log2(amax / fp8_max)))
+    q = tl.clamp(x / scale[:, None], fp8_min, fp8_max).to(q_ptr.dtype.element_ty)
+    tl.store(q_ptr + offs, q, mask=live)
+    tl.store(s_ptr + g, scale, mask=g < n_groups)
+
+
