+# Opt-in tile (SGLANG_DSV41_COMBINE_TILE="BM,BN,WARPS", e.g. "2,1024,8"). The default (4, 256, 4) moves 512-byte pieces and reaches ~27% of
+# the memory bandwidth on the 1536-row call; the arithmetic order is per element, so every tile gives bit-identical results.
+def _combine_tile() -> tuple[int, int, int]:
+    value = os.environ.get("SGLANG_DSV41_COMBINE_TILE", "")
+    if not value:
+        return 4, 256, 4
+    bm, bn, warps = (int(x) for x in value.split(","))
+    if bm not in (1, 2, 4, 8) or bn not in (128, 256, 512, 1024, 2048) or warps not in (1, 2, 4, 8):
+        raise ValueError(f"SGLANG_DSV41_COMBINE_TILE={value!r}: BM in 1,2,4,8, BN in 128..2048, WARPS in 1,2,4,8")
+    return bm, bn, warps
+
+
+_COMBINE_TILE = _combine_tile()
+
