+def native_shared_expert_gemv(q, qs, w, ws, kind: str):
+    """Only native V4.1 TP4 shared gate/up or down, one or two BF16 rows."""
+    shapes = {
+        "gate_up": (1152, 5120, 36, 160, 512),
+        "down": (5120, 576, 160, 18, 64),
+    }
+    if kind not in shapes:
+        raise ValueError("shared expert GEMV requires an exact projection kind")
+    n, k, scale_n, scale_k, block_k = shapes[kind]
+    if q.ndim != 2 or q.shape[0] not in (1, 2):
+        raise ValueError("shared expert GEMV requires one or two token rows")
+    m = q.shape[0]
+    expected = ((q, (m, k), torch.float8_e4m3fn),
+                (qs, (m, scale_k), torch.float32),
+                (w, (n, k), torch.float8_e4m3fn),
+                (ws, (scale_n, scale_k), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError("shared expert GEMV requires exact native contiguous operands")
+        if tensor.device != q.device or tensor.device.type != "cuda":
+            raise ValueError("shared expert GEMV requires one HIP device")
+    if (not torch.version.hip or
+        torch.cuda.get_device_properties(q.device).gcnArchName.split(":")[0] != "gfx1151"):
+        raise ValueError("shared expert GEMV is gfx1151-only")
+    output = torch.empty((m, n), dtype=torch.bfloat16, device=q.device)
+    if m == 1:
+        _native_fp8_gemv_c1[(n // 4,)](
+            q, qs, w, ws, output, n, k, 4, block_k,
+            num_warps=4, num_stages=1, enable_fp_fusion=False)
+    else:
+        _native_c2_gemv[(n // 4,)](
+            q, qs, w, ws, output, n, k, 4, block_k,
+            num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
