+@triton.jit
+def _per_token_group_quant_8bit_ue8m0_rowmajor(
+    x_ptr,
+    q_ptr,
+    s_ptr,
+    group_size: tl.constexpr,
+    eps: tl.constexpr,
+    fp8_min: tl.constexpr,
+    fp8_max: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    # Portable ROCm fallback for V4.1's FP32-stored E8M0 activation scales.
+    # Each program owns one contiguous 32-value activation group and one scale.
+    group = tl.program_id(0)
+    cols = tl.arange(0, BLOCK)
+    x = tl.load(x_ptr + group * group_size + cols, mask=cols < group_size, other=0).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(x), 0), eps)
+    scale = tl.exp2(tl.ceil(tl.log2(amax / fp8_max)))
+    q = tl.clamp(x / scale, fp8_min, fp8_max).to(q_ptr.dtype.element_ty)
+    tl.store(q_ptr + group * group_size + cols, q, mask=cols < group_size)
+    tl.store(s_ptr + group, scale)
+
+
