+++ b/sglang/kernels/ops/moe/dsv41_prefill_combine.py
@@ -0,0 +1,102 @@
+"""Opt-in DeepSeek V4.1 prefill route combine with final TP-sharded shared add.
+
+The context exists only while one official MoE call is executing. It carries
+the side-stream shared result through the existing FusedMoE quantization ABI;
+default and decode paths never install it.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+
+@dataclass
+class _CombineState:
+    shared: torch.Tensor
+    ready: torch.cuda.Event
+    used: bool = False
+
+
+_current: ContextVar[_CombineState | None] = ContextVar(
+    "dsv41_prefill_combine", default=None
+)
+
+
+@contextmanager
+def prefill_combine_scope(shared: torch.Tensor, ready: torch.cuda.Event):
+    state = _CombineState(shared, ready)
+    token = _current.set(state)
+    try:
+        yield state
+    finally:
+        _current.reset(token)
+
+
+def current_combine_state() -> _CombineState | None:
+    return _current.get()
+
+
+@triton.jit
+def _combine_routes_shared(
+    ROUTED, ORDER, SHARED, OUT,
+    M: tl.constexpr, H: tl.constexpr,
+    BM: tl.constexpr, BN: tl.constexpr,
+):
+    row = tl.program_id(0) * BM + tl.arange(0, BM)
+    col = tl.program_id(1) * BN + tl.arange(0, BN)
+    live = (row[:, None] < M) & (col[None, :] < H)
+    acc = tl.full((BM, BN), 0, tl.float32)
+    # The deployed path starts from FP32 zero, then issues six independent
+    # in-place additions in stable ascending expert-ID order. No tree sum.
+    for slot in tl.static_range(6):
+        route = tl.load(ORDER + row * 6 + slot, row < M, other=0).to(tl.int32)
+        value = tl.load(
+            ROUTED + (row * 6 + route)[:, None] * H + col[None, :],
+            live, other=0,
+        ).to(tl.float32)
+        acc = acc + value
+    shared = tl.load(SHARED + row[:, None] * H + col[None, :],
+                     live, other=0).to(tl.float32)
+    acc = acc + shared
+    tl.store(OUT + row[:, None] * H + col[None, :], acc, live)
+
+
+def try_combine_routes_shared(
+    routed: torch.Tensor, topk_ids: torch.Tensor, state: _CombineState | None
+) -> torch.Tensor | None:
+    """Return a new FP32 tensor only when the complete V4.1 ABI is present."""
+    if state is None or state.used:
+        return None
+    shared = state.shared
+    if not (
+        routed.is_cuda and routed.is_contiguous() and routed.dtype == torch.bfloat16
+        and routed.ndim == 3 and routed.shape[1:] == (6, 5120)
+        and 64 <= routed.shape[0] <= 1536
+        and topk_ids.is_cuda and topk_ids.is_contiguous()
+        and topk_ids.dtype == torch.int32
+        and topk_ids.shape == (routed.shape[0], 6)
+        and shared.is_cuda and shared.is_contiguous()
+        and shared.dtype == torch.bfloat16
+        and shared.shape == (routed.shape[0], 5120)
+        and routed.device == topk_ids.device == shared.device
+        and not torch.cuda.is_current_stream_capturing()
+    ):
+        return None
+    main = torch.cuda.current_stream(routed.device)
+    main.wait_event(state.ready)
+    # Matches torch.argsort(..., stable=True), including repeated IDs.
+    order = torch.argsort(topk_ids, dim=1, stable=True)
+    output = torch.empty((routed.shape[0], 5120), device=routed.device,
+                         dtype=torch.float32)
+    _combine_routes_shared[
+        (triton.cdiv(routed.shape[0], 4), triton.cdiv(5120, 256))
+    ](routed, order, shared, output, routed.shape[0], 5120, 4, 256,
+      num_warps=4, enable_fp_fusion=False)
+    state.used = True
+    return output
