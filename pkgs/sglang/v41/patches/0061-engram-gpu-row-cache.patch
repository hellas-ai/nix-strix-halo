+"""Bounded exact-byte GPU row cache for immutable file-backed Engram shards.
+
+The canonical GPU hasher still owns IDs and history. This cache only changes
+where native packed bytes are read after the IDs are known. Unowned IDs map to
+a permanent zero row; global OOB IDs remain errors. It never evicts an in-flight
+row, and a full cache makes the caller use its existing native-file path.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import torch
+import threading
+
+from sglang.srt.layers.engram_store import ROW_BYTES
+
+
+class EngramGpuRowCacheFull(Exception):
+    pass
+
+
+class NativeEngramGpuRowCache:
+    def __init__(self, store, device, capacity_rows=262144):
+        if not 1 <= capacity_rows <= 1048576:
+            raise ValueError("Engram GPU row cache capacity outside bounded range")
+        self.store = store
+        self.device = device
+        self.capacity_rows = capacity_rows
+        self.rows = torch.zeros(
+            (capacity_rows + 1, ROW_BYTES), dtype=torch.uint8, device=device
+        )
+        self.stream = torch.cuda.Stream(device=device)
+        # The zero slot is initialized on the model's stream. A background
+        # cache fill must not race that initialization on a new HIP stream.
+        self.latest_ready = torch.cuda.Event()
+        self.latest_ready.record(torch.cuda.current_stream(device))
+        self.stream.wait_event(self.latest_ready)
+        self._pending_hosts = []
+        self.next_slot = 1
+        self.slots: dict[int, int] = {}
+        self._lock = threading.Lock()
+
+    def stage_slots(self, ids_cpu: torch.Tensor):
+        with self._lock:
+            return self._stage_slots_locked(ids_cpu)
+
+    def _stage_slots_locked(self, ids_cpu: torch.Tensor):
+        """Return exact CPU slot IDs and an event protecting any newly filled rows.
+
+        The caller must only use CPU IDs whose pinned D2H completion it has
+        observed. Calls for the same cache are serialized by its owning model
+        scheduler; prefill has one worker per distinct Engram layer. The lock
+        also covers a decode step that overlaps an outstanding prefill fill.
+        """
+        if ids_cpu.device.type != "cpu" or ids_cpu.dtype != torch.int64:
+            raise ValueError("Engram GPU cache needs complete CPU int64 hash IDs")
+        # Keep each pinned H2D source alive until its HIP event completes.
+        self._pending_hosts = [
+            (event, host)
+            for event, host in self._pending_hosts
+            if not event.query()
+        ]
+        ids = ids_cpu.contiguous().numpy().reshape(-1)
+        store = self.store
+        if np.any((ids < 0) | (ids >= store.num_embeddings)):
+            raise IndexError("active Engram ID outside the table")
+        owned = (ids >= store.row_start) & (ids < store.row_end)
+        unique = np.unique(ids[owned])
+        missing = [int(value) for value in unique if int(value) not in self.slots]
+        if self.next_slot + len(missing) > self.capacity_rows + 1:
+            raise EngramGpuRowCacheFull()
+
+        if missing:
+            packed = np.concatenate(
+                [
+                    store.lookup(np.asarray(missing[first : first + store.max_batch_rows], dtype=np.int64)).packed
+                    for first in range(0, len(missing), store.max_batch_rows)
+                ],
+                axis=0,
+            )
+            if packed.shape != (len(missing), ROW_BYTES):
+                raise RuntimeError("Engram native store returned wrong packed row layout")
+            first_slot = self.next_slot
+            pinned = self._pin_rows(packed)
+            with torch.cuda.stream(self.stream):
+                self.rows[first_slot : first_slot + len(missing)].copy_(
+                    pinned, non_blocking=True
+                )
+                self.latest_ready = torch.cuda.Event()
+                self.latest_ready.record(self.stream)
+            self._pending_hosts.append((self.latest_ready, pinned))
+            for offset, value in enumerate(missing):
+                self.slots[value] = first_slot + offset
+            self.next_slot += len(missing)
+
+        result = np.zeros(ids.shape, dtype=np.int64)
+        result[owned] = np.fromiter(
+            (self.slots[int(value)] for value in ids[owned]),
+            dtype=np.int64,
+            count=int(owned.sum()),
+        )
+        # A second caller can hit keys published by a still-running H2D fill.
+        # It must inherit the same completion dependency, even with no misses.
+        return torch.from_numpy(result.reshape(ids_cpu.shape)), self.latest_ready
+
+    @staticmethod
+    def _pin_rows(packed):
+        return torch.from_numpy(packed).pin_memory()
+
+    def gather(self, slots_cpu: torch.Tensor, ready=None):
+        """Gather packed bytes on GPU; main-stream order protects graph inputs."""
+        if ready is not None:
+            torch.cuda.current_stream(self.device).wait_event(ready)
+        slots = slots_cpu.to(device=self.device, dtype=torch.int64)
+        return self.rows.index_select(0, slots.reshape(-1)).reshape(
+            *slots.shape, ROW_BYTES
+        )
