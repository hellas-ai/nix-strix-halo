+def _read_prefetched_engram_rows(host_ids, ready_event, cache):
+    """Fill one layer's GPU row cache after its pinned hash IDs arrive."""
+    while not ready_event.query():
+        time.sleep(0.0001)
+    try:
+        slots, rows_ready = cache.stage_slots(host_ids)
+        return slots, rows_ready, None
+    except EngramGpuRowCacheFull:
+        # Full cache is a performance fallback, never a correctness failure.
+        flat = host_ids.reshape(-1).numpy()
+        parts = [
+            cache.store.lookup(flat[first : first + cache.store.max_batch_rows]).packed
+            for first in range(0, flat.size, cache.store.max_batch_rows)
+        ]
+        return None, None, torch.from_numpy(
+            np.concatenate(parts).reshape(*host_ids.shape, ROW_BYTES)
+        )
+
