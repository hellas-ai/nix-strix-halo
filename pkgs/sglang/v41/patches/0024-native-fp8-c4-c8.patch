+            accumulator5 = accumulator5 + tl.sum(scaled5, axis=1)
+            q6 = _e4m3fn_to_fp32(tl.load(Q + 6 * K + start + cols))
+            dots6 = tl.sum(tl.reshape(w * q6[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+            a_scale6 = tl.load(QS + 6 * (K // 32) + start // 32 + groups)
+            scaled6 = (dots6 * a_scale6[None, :]) * w_scale[None, :]
