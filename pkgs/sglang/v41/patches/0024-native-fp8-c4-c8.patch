+def native_c4_c8_gemv(q, qs, w, ws):
+    """Only the six flagged native TP4 projection shapes, exactly four/eight rows."""
+    shapes = {
+        (25600, 6144): 512, (5120, 2048): 512,
+        (1792, 5120): 512, (8192, 1280): 256,
+        (1152, 5120): 512, (5120, 576): 64,
+    }
+    if w.shape not in shapes or q.ndim != 2 or q.shape[0] not in (4, 8):
+        raise ValueError("C4/C8 native GEMV requires an exact supported projection")
+    n, k = w.shape
+    m = q.shape[0]
+    expected = ((q, (m, k), torch.float8_e4m3fn),
+                (qs, (m, k // 32), torch.float32),
+                (w, (n, k), torch.float8_e4m3fn),
+                (ws, (n // 32, k // 32), torch.float32))
+    for tensor, shape, dtype in expected:
+        if tensor.shape != shape or tensor.dtype != dtype or not tensor.is_contiguous():
+            raise ValueError("C4/C8 native GEMV requires contiguous native operands")
+        if tensor.device != q.device or tensor.device.type != "cuda":
+            raise ValueError("C4/C8 native GEMV requires one HIP device")
+    if (not torch.version.hip or
+        torch.cuda.get_device_properties(q.device).gcnArchName.split(":")[0] != "gfx1151"):
+        raise ValueError("C4/C8 native GEMV is gfx1151-only")
+    output = torch.empty((m, n), dtype=torch.bfloat16, device=q.device)
+    _native_c4_c8_gemv[(n // 8,)](
+        q, qs, w, ws, output, n, k, m, 8, shapes[(n, k)],
+        num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return output
