+@triton.jit
+def _native_c4_c8_gemv(Q, QS, W, WS, Y, N: tl.constexpr, K: tl.constexpr,
+                       TOKENS: tl.constexpr, ROWS: tl.constexpr, BLOCK_K: tl.constexpr):
+    # Preserve the qualified per-token reduction; reuse each weight tile for all
+    # live tokens without a second launch or cross-token arithmetic.
+    first = tl.program_id(0) * ROWS
+    rows = first + tl.arange(0, ROWS)
+    cols = tl.arange(0, BLOCK_K)
+    groups = tl.arange(0, BLOCK_K // 32)
+    accumulator0 = tl.zeros((ROWS,), tl.float32)
+    accumulator1 = tl.zeros((ROWS,), tl.float32)
+    accumulator2 = tl.zeros((ROWS,), tl.float32)
+    accumulator3 = tl.zeros((ROWS,), tl.float32)
+    if TOKENS == 8:
+        accumulator4 = tl.zeros((ROWS,), tl.float32)
+        accumulator5 = tl.zeros((ROWS,), tl.float32)
+        accumulator6 = tl.zeros((ROWS,), tl.float32)
+        accumulator7 = tl.zeros((ROWS,), tl.float32)
+    for start in range(0, K, BLOCK_K):
+        w = _e4m3fn_to_fp32(tl.load(W + rows[:, None] * K + start + cols[None, :]))
+        w_scale = tl.load(WS + (first // 32) * (K // 32) + start // 32 + groups)
+        q0 = _e4m3fn_to_fp32(tl.load(Q + 0 * K + start + cols))
+        dots0 = tl.sum(tl.reshape(w * q0[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale0 = tl.load(QS + 0 * (K // 32) + start // 32 + groups)
+        scaled0 = (dots0 * a_scale0[None, :]) * w_scale[None, :]
+        accumulator0 = accumulator0 + tl.sum(scaled0, axis=1)
+        q1 = _e4m3fn_to_fp32(tl.load(Q + 1 * K + start + cols))
+        dots1 = tl.sum(tl.reshape(w * q1[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale1 = tl.load(QS + 1 * (K // 32) + start // 32 + groups)
+        scaled1 = (dots1 * a_scale1[None, :]) * w_scale[None, :]
+        accumulator1 = accumulator1 + tl.sum(scaled1, axis=1)
+        q2 = _e4m3fn_to_fp32(tl.load(Q + 2 * K + start + cols))
+        dots2 = tl.sum(tl.reshape(w * q2[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale2 = tl.load(QS + 2 * (K // 32) + start // 32 + groups)
+        scaled2 = (dots2 * a_scale2[None, :]) * w_scale[None, :]
+        accumulator2 = accumulator2 + tl.sum(scaled2, axis=1)
+        q3 = _e4m3fn_to_fp32(tl.load(Q + 3 * K + start + cols))
+        dots3 = tl.sum(tl.reshape(w * q3[None, :], (ROWS, BLOCK_K // 32, 32)), axis=2)
+        a_scale3 = tl.load(QS + 3 * (K // 32) + start // 32 + groups)
+        scaled3 = (dots3 * a_scale3[None, :]) * w_scale[None, :]
+        accumulator3 = accumulator3 + tl.sum(scaled3, axis=1)
+        if TOKENS == 8:
+            q4 = _e4m3fn_to_fp32(tl.load(Q + 4 * K + start + cols))
