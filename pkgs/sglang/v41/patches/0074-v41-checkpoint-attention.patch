+def _score_checkpoint(Q, Main, MainIds, Extra, ExtraIds, P, Alpha, Scale, LSE, Out,
+                      Sink, MainLength, ExtraLength,
+                      MAIN_K: tl.constexpr, EXTRA_K: tl.constexpr,
+                      MAIN_PAGE: tl.constexpr, EXTRA_PAGE: tl.constexpr,
+                      MAIN_STRIDE: tl.constexpr, EXTRA_STRIDE: tl.constexpr,
+                      HAS_SINK: tl.constexpr, HAS_MAIN_LENGTH: tl.constexpr,
+                      HAS_EXTRA_LENGTH: tl.constexpr, SM_SCALE,
