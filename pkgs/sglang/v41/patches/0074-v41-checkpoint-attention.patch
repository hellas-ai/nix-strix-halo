+@triton.jit
+def _load_v41_tile(base, data_offset, scale_offset, valid_2d, lanes, piece):
+    values = tl.load(
+        base[:, None] + data_offset[:, None] + piece * 64 + lanes[None, :],
+        mask=valid_2d, other=0,
+    ).to(_KV_FP8_TY, bitcast=True)
+    codes = tl.load(
+        base[:, None] + scale_offset[:, None] + piece * 2 + lanes[None, :] // 32,
+        mask=valid_2d, other=127,
+    ).to(tl.uint8)
+    scales = tl.math.exp2(codes.to(tl.float32) - 127.0).to(tl.bfloat16)
+    values = (values.to(tl.bfloat16) * scales).to(tl.bfloat16)
+    return tl.where(valid_2d, values, 0.0)
+
+
+@triton.jit
+def _score_block(
+    # KV cache parameters
+    kv_block_base,
+    nope_rope_offset,
+    scale_base_offset,
+    valid,
+    valid_2d,
+    # Query pointer and row; stream one 64-column piece at a time.
+    Q,
+    row,
+    # Accumulators (passed by reference via return)
+    # Softmax state
+    m_i,
+    l_i,
+    # Other parameters
+    offs_tile,
+    sm_scale,
+    # Constants
+    TILE_SIZE: tl.constexpr,
+    D_NOPE: tl.constexpr,
+    LOG2E: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    KV_V41: tl.constexpr = False,
+):
+    """
+    Process one block of KV tokens with batch loading.
+    Key optimization: Load all KV tiles first, then process them.
+    """
+    NEG_INF = float("-inf")
+
+    if KV_V41:
+        qk = tl.zeros([BLOCK_H, BLOCK_N], dtype=tl.float32)
+        kv_0 = _load_v41_tile(kv_block_base, nope_rope_offset, scale_base_offset, valid_2d, offs_tile, 0)
+        q_0 = tl.load(Q + row * 8192 + tl.arange(0, BLOCK_H)[:, None] * 512 + 0 + offs_tile[None, :], volatile=True).to(tl.bfloat16)
+        qk += tl.dot(q_0, tl.trans(kv_0)).to(tl.float32)
+        kv_1 = _load_v41_tile(kv_block_base, nope_rope_offset, scale_base_offset, valid_2d, offs_tile, 1)
+        q_1 = tl.load(Q + row * 8192 + tl.arange(0, BLOCK_H)[:, None] * 512 + 64 + offs_tile[None, :], volatile=True).to(tl.bfloat16)
+        qk += tl.dot(q_1, tl.trans(kv_1)).to(tl.float32)
+        kv_2 = _load_v41_tile(kv_block_base, nope_rope_offset, scale_base_offset, valid_2d, offs_tile, 2)
+        q_2 = tl.load(Q + row * 8192 + tl.arange(0, BLOCK_H)[:, None] * 512 + 128 + offs_tile[None, :], volatile=True).to(tl.bfloat16)
+        qk += tl.dot(q_2, tl.trans(kv_2)).to(tl.float32)
