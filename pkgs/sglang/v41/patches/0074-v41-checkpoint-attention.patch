+            indices = MainIds
+            TOPK = MAIN_K
+            PAGE = MAIN_PAGE
+            STRIDE = MAIN_STRIDE
+            OFFSET = 0
+            length = MAIN_K
+            if HAS_MAIN_LENGTH:
+                length = tl.load(MainLength + row)
+        else:
+            cache = Extra
+            indices = ExtraIds
+            TOPK = EXTRA_K
+            PAGE = EXTRA_PAGE
+            STRIDE = EXTRA_STRIDE
+            OFFSET = ((MAIN_K + BLOCK_N - 1) // BLOCK_N)
+            length = EXTRA_K
+            if HAS_EXTRA_LENGTH:
+                length = tl.load(ExtraLength + row)
+        for j in range(((TOPK + BLOCK_N - 1) // BLOCK_N)):
+            block = OFFSET + j
+            if j * BLOCK_N < length:
+                pos = j * BLOCK_N + n
+                idx = tl.load(indices + row * TOPK + pos, pos < TOPK, other=-1)
+                valid = (pos < TOPK) & (pos < length) & (idx != -1)
+                safe = tl.maximum(idx, 0).to(tl.int64)
