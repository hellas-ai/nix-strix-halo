+        q_4 = tl.load(Q + row * 8192 + tl.arange(0, BLOCK_H)[:, None] * 512 + 256 + offs_tile[None, :], volatile=True).to(tl.bfloat16)
+        qk += tl.dot(q_4, tl.trans(kv_4)).to(tl.float32)
+        kv_5 = _load_v41_tile(kv_block_base, nope_rope_offset, scale_base_offset, valid_2d, offs_tile, 5)
+        q_5 = tl.load(Q + row * 8192 + tl.arange(0, BLOCK_H)[:, None] * 512 + 320 + offs_tile[None, :], volatile=True).to(tl.bfloat16)
+        qk += tl.dot(q_5, tl.trans(kv_5)).to(tl.float32)
+        kv_6 = _load_v41_tile(kv_block_base, nope_rope_offset, scale_base_offset, valid_2d, offs_tile, 6)
+        q_6 = tl.load(Q + row * 8192 + tl.arange(0, BLOCK_H)[:, None] * 512 + 384 + offs_tile[None, :], volatile=True).to(tl.bfloat16)
+        qk += tl.dot(q_6, tl.trans(kv_6)).to(tl.float32)
