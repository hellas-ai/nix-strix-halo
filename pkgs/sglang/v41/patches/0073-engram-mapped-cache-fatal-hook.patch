+"""Bounded GPU-ID Engram row cache backed by pinned, immutable file rows.
+
+This module is only used by the opt-in fatal-result-gate arm. A cache error is
+reported through the per-generation TP status and terminates the serving group;
+there is no row eviction or request-level recovery. The row store owns the
+original checkpoint FD; the native cache duplicates it for its entire life.
+"""
+
+from __future__ import annotations
+
+import ctypes
+from pathlib import Path
+
+import torch
+
+
+_HEADER_BYTES = 4096
+_ROW_BYTES = 264
+_ERROR_BYTES = 512
+
+
+class EngramMappedCache:
+    def __init__(self, store, *, capacity: int, workers: int):
+        if not (1 <= capacity <= 1_000_000 and 1 <= workers <= 16):
+            raise ValueError("bounded Engram mapped cache capacity/workers invalid")
+        if getattr(store, "_closed", True):
+            raise ValueError("Engram mapped cache requires an open immutable store")
+        if not (0 <= store.row_start < store.row_end <= store.num_embeddings):
+            raise ValueError("Engram mapped cache store partition invalid")
+
+        lib = ctypes.CDLL(str(Path(__file__).with_name("libengram_mapped_cache.so")))
+        lib.engram_mapped_create.argtypes = [
+            ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_uint64,
+            ctypes.c_int64, ctypes.c_int64, ctypes.c_int64,
+            ctypes.c_int, ctypes.c_int, ctypes.c_int,
+            ctypes.POINTER(ctypes.c_void_p), ctypes.c_char_p, ctypes.c_size_t,
+        ]
+        lib.engram_mapped_create.restype = ctypes.c_int
+        lib.engram_mapped_launch.argtypes = [
+            ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int,
+            ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int,
+            ctypes.c_char_p, ctypes.c_size_t,
+        ]
+        lib.engram_mapped_launch.restype = ctypes.c_int
+        lib.engram_mapped_destroy.argtypes = [ctypes.c_void_p]
+        lib.engram_mapped_destroy.restype = None
+
+        packed = bool(store._packed)
+        handle = ctypes.c_void_p()
+        error = ctypes.create_string_buffer(_ERROR_BYTES)
+        code = lib.engram_mapped_create(
+            int(store._wfd), int(-1 if packed else store._sfd),
+            int(_HEADER_BYTES if packed else store._woff),
+            int(0 if packed else store._soff),
+            int(store.num_embeddings), int(store.row_start), int(store.row_end),
+            int(capacity), int(workers), int(packed),
+            ctypes.byref(handle), error, len(error),
+        )
+        if code or not handle.value:
+            raise RuntimeError(f"Engram mapped cache create: {error.value.decode(errors='replace')}")
+        self._lib = lib
+        self._handle = handle
+        self.device = torch.device("cuda", torch.cuda.current_device())
+
+    def close(self) -> None:
+        handle = getattr(self, "_handle", None)
+        if handle is not None and handle.value:
+            self._handle = ctypes.c_void_p()
+            self._lib.engram_mapped_destroy(handle)
+
+    def __del__(self):
+        self.close()
+
+    def gather(
+        self, ids: torch.Tensor, status_word: torch.Tensor, *, wait_ms: int
+    ) -> torch.Tensor:
+        rows = torch.empty((*ids.shape, _ROW_BYTES), dtype=torch.uint8, device=ids.device)
+        self.gather_into(ids, rows, status_word, wait_ms=wait_ms)
+        return rows
