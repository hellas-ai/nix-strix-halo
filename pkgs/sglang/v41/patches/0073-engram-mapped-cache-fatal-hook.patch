+    while (!stop.load(std::memory_order_acquire)) {
+      const int bound = std::min(
+          std::atomic_ref<int>(counter->next_slot).load(std::memory_order_acquire),
+          capacity);
+      int index = claimed.load(std::memory_order_relaxed);
+      if (index >= bound) {
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+        continue;
+      }
+      if (!claimed.compare_exchange_weak(index, index + 1,
+                                         std::memory_order_acq_rel))
+        continue;
+      Ticket& ticket = tickets[index];
+      const auto publish_deadline = std::chrono::steady_clock::now() +
+                                    std::chrono::seconds(30);
+      int state = 0;
+      while ((state = std::atomic_ref<int>(ticket.state).load(
+                  std::memory_order_acquire)) == 0 &&
+             std::chrono::steady_clock::now() < publish_deadline &&
+             !stop.load(std::memory_order_acquire)) {
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+      }
+      if (state != 1) continue;
+      int expected = 1;
+      if (!std::atomic_ref<int>(ticket.state).compare_exchange_strong(
+              expected, 3, std::memory_order_acq_rel))
+        continue;
+      try {
+        const int64_t id = ticket.id;
+        if (id < row_start || id >= row_end)
+          throw std::runtime_error("Engram worker received invalid owned ID");
+        uint8_t* dst = static_cast<uint8_t*>(rows->host) +
+                       static_cast<size_t>(index) * kRowBytes;
+        if (packed) {
+          read_exact(wfd, dst, kRowBytes,
+                     weight_offset + static_cast<uint64_t>(id - row_start) * kRowBytes);
+        } else {
+          read_exact(wfd, dst, kWeightBytes,
+                     weight_offset + static_cast<uint64_t>(id) * kWeightBytes);
+          read_exact(sfd, dst + kWeightBytes, kScaleBytes,
+                     scale_offset + static_cast<uint64_t>(id) * kScaleBytes);
+        }
+        expected = 3;
+        (void)std::atomic_ref<int>(ticket.state).compare_exchange_strong(
+            expected, 2, std::memory_order_release);
+      } catch (...) {
+        expected = 3;
+        (void)std::atomic_ref<int>(ticket.state).compare_exchange_strong(
+            expected, -1, std::memory_order_release);
+      }
+    }
+  }
+
+  void launch(const int64_t* ids, int count, uint8_t* output,
+              int output_token_stride_rows,
+              int* status_cell, hipStream_t stream, int wait_ms) {
+    if (ids == nullptr || output == nullptr || status_cell == nullptr ||
+        count < 0 || count > 65536 || count % 24 != 0 ||
+        output_token_stride_rows < 24 || output_token_stride_rows > 1024 ||
+        wait_ms < 1 || wait_ms > 60000)
+      throw std::runtime_error("invalid bounded Engram gather launch");
+    if (count == 0) return;
+    const auto timeout_ticks = static_cast<unsigned long long>(
+        static_cast<double>(wall_clock_khz) * static_cast<double>(wait_ms));
+    hipLaunchKernelGGL(publish_kernel, dim3((count + 127) / 128), dim3(128), 0,
+                       stream, ids, count, global_rows, row_start, row_end,
+                       dense, static_cast<Counter*>(counter_mem->device),
+                       static_cast<Ticket*>(controls->device), status_cell,
+                       capacity);
+    check(hipPeekAtLastError(), "Engram mapped publish launch");
+    hipLaunchKernelGGL(gather_kernel, dim3((count + 127) / 128), dim3(128), 0,
+                       stream, ids, count, global_rows, row_start, row_end,
+                       dense, static_cast<Ticket*>(controls->device),
+                       static_cast<const uint8_t*>(rows->device), output,
+                       output_token_stride_rows, status_cell,
+                       timeout_ticks);
+    check(hipPeekAtLastError(), "Engram mapped gather launch");
+  }
+};
+}  // namespace
+
+extern "C" int engram_mapped_create(
+    int weight_fd, int scale_fd, uint64_t weight_offset,
+    uint64_t scale_offset, int64_t global_rows, int64_t row_start,
+    int64_t row_end, int capacity, int workers, int packed,
+    void** out, char* error, size_t error_bytes) noexcept {
+  if (out == nullptr) return 1;
+  *out = nullptr;
+  try {
+    *out = new Cache(weight_fd, scale_fd, weight_offset, scale_offset,
+                     global_rows, row_start, row_end, capacity, workers,
+                     packed != 0);
+    error_text(error, error_bytes, "");
+    return 0;
+  } catch (const std::exception& exc) {
+    error_text(error, error_bytes, exc.what());
+    return 1;
+  }
+}
+
+extern "C" int engram_mapped_launch(
+    void* handle, const void* ids, int count, void* output,
+    int output_token_stride_rows, void* status_cell, void* stream, int wait_ms,
+    char* error, size_t error_bytes) noexcept {
+  if (handle == nullptr) {
+    error_text(error, error_bytes, "Engram mapped cache is unavailable");
+    return 1;
+  }
+  try {
+    static_cast<Cache*>(handle)->launch(
+        static_cast<const int64_t*>(ids), count,
+        static_cast<uint8_t*>(output), output_token_stride_rows,
+        static_cast<int*>(status_cell),
+        reinterpret_cast<hipStream_t>(stream), wait_ms);
+    error_text(error, error_bytes, "");
+    return 0;
+  } catch (const std::exception& exc) {
+    error_text(error, error_bytes, exc.what());
+    return 1;
+  }
+}
+
+extern "C" void engram_mapped_destroy(void* handle) noexcept {
+  delete static_cast<Cache*>(handle);
+}
+
+// Diagnostic-only; never called by serving's per-forward hot path.
+extern "C" int engram_mapped_slots_used(void* handle) noexcept {
+  if (handle == nullptr) return -1;
+  auto* cache = static_cast<Cache*>(handle);
+  return std::atomic_ref<int>(cache->counter->next_slot).load(
+      std::memory_order_acquire);
+}
