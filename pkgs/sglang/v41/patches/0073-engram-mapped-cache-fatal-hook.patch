+            ctypes.c_void_p(rows.data_ptr()), int(rows.stride(0) // _ROW_BYTES),
+            ctypes.c_void_p(status_word.data_ptr()),
+            ctypes.c_void_p(torch.cuda.current_stream().cuda_stream),
+            int(wait_ms), error, len(error),
+        )
+        if code:
+            raise RuntimeError(f"Engram mapped gather launch: {error.value.decode(errors='replace')}")
