+// Bounded, no-eviction Engram mapped-row cache for gfx1151.
+// This library is not enabled by default. A caller must reduce its device
+// status across TP and fail-stop before output/cache publication on error.
+#include <hip/hip_runtime.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+constexpr int kRowBytes = 264;
+constexpr int kWeightBytes = 256;
+constexpr int kScaleBytes = 8;
+constexpr int kMaxCapacity = 1000000;
+std::atomic<size_t> g_reserved_pinned_bytes{0};
+
+void check(hipError_t code, const char* where) {
+  if (code != hipSuccess)
+    throw std::runtime_error(std::string(where) + ": " + hipGetErrorString(code));
+}
+
+void error_text(char* out, size_t bytes, const char* value) noexcept {
+  if (out == nullptr || bytes == 0) return;
+  std::snprintf(out, bytes, "%s", value);
+}
+
+struct Registered {
+  void* host = nullptr;
+  void* device = nullptr;
+  size_t bytes = 0;
+
+  explicit Registered(size_t requested) {
+    const long page_query = sysconf(_SC_PAGESIZE);
+    if (page_query <= 0) throw std::runtime_error("Engram page size unavailable");
+    const size_t page = static_cast<size_t>(page_query);
+    bytes = (requested + page - 1) / page * page;
+    host = mmap(nullptr, bytes, PROT_READ | PROT_WRITE,
+                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (host == MAP_FAILED) {
+      host = nullptr;
+      throw std::runtime_error("Engram mmap failed");
+    }
+    try {
+      std::memset(host, 0, bytes);
+      check(hipHostRegister(host, bytes, hipHostRegisterMapped | hipExtHostRegisterUncached),
+            "Engram hipHostRegisterMapped|Uncached");
+      try {
+        check(hipHostGetDevicePointer(&device, host, 0),
+              "Engram hipHostGetDevicePointer");
+      } catch (...) {
+        (void)hipHostUnregister(host);
+        throw;
+      }
+    } catch (...) {
+      munmap(host, bytes);
+      host = nullptr;
+      throw;
+    }
+  }
+
+  ~Registered() {
+    if (host != nullptr) {
+      (void)hipHostUnregister(host);
+      munmap(host, bytes);
+    }
+  }
+  Registered(const Registered&) = delete;
+  Registered& operator=(const Registered&) = delete;
+};
+
+struct alignas(64) Ticket {
+  int state;  // 0 unused, 1 published, 3 I/O, 2 ready, -1 I/O error, -2 canceled
+  int64_t id;
+  uint8_t pad[48];
+};
+static_assert(sizeof(Ticket) == 64);
+
+struct alignas(64) Counter {
+  int next_slot;
+  uint8_t pad[60];
+};
+static_assert(sizeof(Counter) == 64);
+
+void read_exact(int fd, void* dst, size_t len, uint64_t offset) {
+  size_t done = 0;
+  while (done < len) {
+    const ssize_t n = pread(fd, static_cast<uint8_t*>(dst) + done,
+                            len - done, static_cast<off_t>(offset + done));
+    if (n <= 0) throw std::runtime_error("Engram pread failed or short");
+    done += static_cast<size_t>(n);
+  }
+}
+
+// Phase one must not spin on a dense entry or ticket: a losing lane can share
+// a wave with the winning lane, and a waiting CTA can occupy resources needed
+// by an unscheduled producer CTA. Completion of this kernel on the same stream
+// is the publication barrier for every winning GPU ticket producer.
+__global__ void publish_kernel(
+    const int64_t* ids, int count, int64_t global_rows,
+    int64_t row_start, int64_t row_end, int* dense, Counter* counter,
+    Ticket* tickets, int* status_cell, int capacity) {
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) return;
+  const int64_t id = ids[i];
+  if (id < 0 || id >= global_rows) {
+    atomicCAS(status_cell, 0, 1);  // global OOB
+    return;
+  }
+  if (id < row_start || id >= row_end) return;
+  int* entry = dense + (id - row_start);
+  if (__hip_atomic_load(entry, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0 &&
+      atomicCAS(entry, 0, -1) == 0) {
+    const int slot = atomicAdd_system(&counter->next_slot, 1);
+    if (slot >= capacity) {
+      __hip_atomic_store(entry, -2, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
+      atomicCAS(status_cell, 0, 2);  // bounded cache exhausted
+    } else {
+      tickets[slot].id = id;
+      __hip_atomic_store(&tickets[slot].state, 1,
+                         __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
+      __hip_atomic_store(entry, slot + 1,
+                         __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
+    }
+  }
+}
+
+// Phase two runs only after every phase-one lane has retired on this stream.
+// It may wait for host pread, never for an unscheduled GPU ticket producer.
+// 0 is unowned bytes, not success for invalid global IDs.
+__global__ void gather_kernel(
+    const int64_t* ids, int count, int64_t global_rows,
+    int64_t row_start, int64_t row_end, const int* dense,
+    Ticket* tickets, const uint8_t* mapped_rows, uint8_t* output,
+    int output_token_stride_rows, int* status_cell,
+    unsigned long long timeout_ticks) {
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= count) return;
+  uint8_t* out = output +
+      (static_cast<size_t>(i / 24) * output_token_stride_rows + i % 24) * kRowBytes;
+  const int64_t id = ids[i];
+  int error = 0;
+  if (id < 0 || id >= global_rows) {
+    error = 1;
+  } else if (id >= row_start && id < row_end) {
+    const int encoded = __hip_atomic_load(dense + (id - row_start),
+                                           __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT);
+    if (encoded == -2) error = 2;
+    else if (encoded <= 0) error = 3;  // producer failed to publish
+    else {
+      const int slot = encoded - 1;
+      const auto deadline = static_cast<unsigned long long>(wall_clock64()) + timeout_ticks;
+      int state = 0;
+      do {
+        state = __hip_atomic_load(&tickets[slot].state,
+                                  __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
+        if (state == 2 || state == -1 || state == -2) break;
+      } while (static_cast<unsigned long long>(wall_clock64()) < deadline);
+      if (state == -1) error = 4;
+      else if (state != 2) {
+        // A late worker cannot turn a timed-out slot valid.
+        while (state == 1 || state == 3) {
+          const int prior = atomicCAS_system(&tickets[slot].state, state, -2);
+          if (prior == state) { state = -2; break; }
+          state = prior;
+        }
+        if (state == -1) error = 4;
+        else if (state != 2) error = 5;
+      }
+      if (!error) {
+        const uint8_t* row = mapped_rows + static_cast<size_t>(slot) * kRowBytes;
+        for (int j = 0; j < kRowBytes; ++j) out[j] = row[j];
+      }
+    }
+  }
+  if (error || id < row_start || id >= row_end) {
+    for (int j = 0; j < kRowBytes; ++j) out[j] = 0;
+  }
+  if (error) atomicCAS(status_cell, 0, error);
+}
+
+class Cache {
+ public:
+  const int64_t global_rows;
+  const int64_t row_start;
+  const int64_t row_end;
+  const int capacity;
+  const bool packed;
+  const uint64_t weight_offset;
+  const uint64_t scale_offset;
+  int wfd = -1;
+  int sfd = -1;
+  std::unique_ptr<Registered> rows;
+  std::unique_ptr<Registered> controls;
+  std::unique_ptr<Registered> counter_mem;
