+    controls = std::make_unique<Registered>(ticket_bytes);
+    counter_mem = std::make_unique<Registered>(sizeof(Counter));
+    tickets = static_cast<Ticket*>(controls->host);
+    counter = static_cast<Counter*>(counter_mem->host);
