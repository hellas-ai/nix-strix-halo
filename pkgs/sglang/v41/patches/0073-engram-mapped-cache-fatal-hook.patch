+    def gather_into(
+        self, ids: torch.Tensor, rows: torch.Tensor,
+        status_word: torch.Tensor, *, wait_ms: int
+    ) -> None:
+        if (
+            ids.device != self.device or ids.dtype != torch.int64
+            or ids.ndim != 2 or ids.shape[1] != 24
+            or not ids.is_contiguous()
