index 0000000..6660ada
--- /dev/null
+++ b/sglang/kernels/ops/layernorm/native_routed_add.py
@@ -0,0 +1,74 @@
+"""In-place ``routed_fp32 += shared_bf16`` for gfx1151 decode rows.
+
+The torch form mixes FP32 and BF16 operands, so ATen launches
+``vectorized_templated_elementwise_kernel``.  Its HIP launch geometry is 512
+threads x 32 elements per block, i.e. one partial block for any decode batch,
+and the partial block loads every element through a dynamic-dtype
+``fetch_and_cast`` (about 50 us for [1, 5120]).  This kernel performs the same
+single IEEE FP32 addition ``routed + float(shared)`` per element, so the result
+is bitwise identical, and spreads it over ordinary vectorized blocks.
+"""
+
+import logging
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+logger = logging.getLogger(__name__)
+
+_ENV_DISABLE = "SGLANG_DSV41_NATIVE_ROUTED_ADD"
+MAX_ELEMENTS = 16 * 5120
+_GFX1151 = {}
+_FAILED = False
+
+
+@triton.jit
+def _add_bf16_into_fp32(Y, S, N, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    ok = offs < N
+    y = tl.load(Y + offs, mask=ok, other=0.0)
+    s = tl.load(S + offs, mask=ok, other=0.0).to(tl.float32)
+    tl.store(Y + offs, y + s, mask=ok)
+
+
+def _is_gfx1151(device: torch.device) -> bool:
+    key = device.index if device.index is not None else torch.cuda.current_device()
+    cached = _GFX1151.get(key)
+    if cached is None:
+        cached = bool(torch.version.hip) and (
+            torch.cuda.get_device_properties(key).gcnArchName.split(":")[0] == "gfx1151"
+        )
+        _GFX1151[key] = cached
+    return cached
+
+
+def native_routed_add_(routed: torch.Tensor, shared: torch.Tensor) -> bool:
+    """``routed += shared`` in place; False (nothing done) when not applicable."""
+    if (
+        routed.dtype != torch.float32
+        or shared.dtype != torch.bfloat16
+        or routed.shape != shared.shape
+        or not 0 < routed.numel() <= MAX_ELEMENTS
+        or not routed.is_cuda
+        or shared.device != routed.device
+        or not routed.is_contiguous()
+        or not shared.is_contiguous()
+        or os.environ.get(_ENV_DISABLE, "1") == "0"
+        or not _is_gfx1151(routed.device)
+    ):
+        return False
+    global _FAILED
+    if _FAILED:
+        return False
+    n = routed.numel()
+    try:
+        _add_bf16_into_fp32[(triton.cdiv(n, 1024),)](
+            routed, shared, n, 1024, num_warps=4, num_stages=1, enable_fp_fusion=False
+        )
+    except Exception:  # e.g. a Triton compile failure: never take the service down
+        _FAILED = True
+        logger.exception("native routed add failed; keeping the torch add")
+        return False
+    return True
