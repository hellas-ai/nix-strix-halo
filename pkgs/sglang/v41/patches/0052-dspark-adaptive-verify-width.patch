+    config = with_phase(
+        get_exec().graph.cuda_graph_config,
+        Phase.DECODE,
+        bs=list(batch_sizes),
+        max_bs=max(batch_sizes),
+    )
+    with get_exec().graph.override(
+        cuda_graph_config=config,
+        cuda_graph_bs_decode=list(batch_sizes),
+    ):
+        yield
+
