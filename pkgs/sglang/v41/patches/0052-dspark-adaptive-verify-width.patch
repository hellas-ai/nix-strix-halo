+            self.model_runner.attn_backend = state.attn_backend
+            self.model_runner.decode_cuda_graph_runner = state.graph_runner
+        self.model_runner.capture_tail_hooks = self._base_capture_tail_hooks + (
+            [state.epilogue.capture_hook] if state.epilogue is not None else []
+        )
+
+    def _capture_adaptive_verify(self):
+        # Scheduler has already captured the initial width-4 target runner.
+        memory_before = get_available_gpu_memory(self.device, self.gpu_id)
+        started = time.perf_counter()
+        initial = self._verify_state
+        initial.attn_backend = self.model_runner.attn_backend
+        initial.graph_runner = self.model_runner.decode_cuda_graph_runner
+        workspace = self.model_runner.init_new_workspace
+        try:
+            with (
+                get_spec().override(speculative_num_draft_tokens=2),
+                _decode_capture_config([1, 2, 4]),
+            ):
+                state = self._build_verify_state(2, 4)
+                state.attn_backend = self.model_runner._get_attention_backend(
+                    init_new_workspace=True
+                )
+                # Graph variants read the runner's backend, and every tail hook
+                # runs during capture: install only this width's epilogue.
+                self._apply_verify_state(state)
+                state.graph_runner = DecodeCudaGraphRunner(
+                    self.model_runner,
+                    attn_backend=state.attn_backend,
+                    speculative_num_draft_tokens=state.width,
+                )
+                self._verify_states[state.width] = state
+        finally:
+            self.model_runner.init_new_workspace = workspace
+            self._apply_verify_state(initial)
+        extra_memory = memory_before - get_available_gpu_memory(
+            self.device, self.gpu_id
+        )
+        self._additional_graph_memory_usage["target_verify"] = extra_memory
+        self._additional_graph_time_usage["target_verify"] = (
+            time.perf_counter() - started
+        )
+        logger.info(
+            "Adaptive DSpark target graphs: width=4 bs=[1,2]; width=2 bs=[1,2,4]; "
+            "additional state memory=%.2f GB",
+            extra_memory,
+        )
 
