+
+def _adaptive_verify_width(batch_size: int) -> int:
+    if not 0 <= batch_size <= 4:
+        raise ValueError("Adaptive DSpark supports at most four decode requests")
+    return 4 if batch_size <= 2 else 2
+
+
+def _slice_draft_block(block: DraftBlockResult, width: int) -> DraftBlockResult:
+    gamma = width - 1
+    if block.draft_tokens.shape[1] == gamma:
+        return block
+    return DraftBlockResult(
+        draft_tokens=block.draft_tokens[:, :gamma].contiguous(),
+        corrected_logits=(
+            None
+            if block.corrected_logits is None
+            else block.corrected_logits[:, :gamma].contiguous()
+        ),
+        greedy_mask=block.greedy_mask,
+        temperatures=block.temperatures,
+    )
+
+
+def _slice_verify_window(window: VerifyWindow, width: int) -> VerifyWindow:
+    if window.positions_2d.shape[1] == width:
+        return window
+    locations = window.verify_cache_loc_2d[:, :width].contiguous()
+    return VerifyWindow(
+        positions_2d=window.positions_2d[:, :width].contiguous(),
+        verify_cache_loc=locations.reshape(-1),
+        verify_cache_loc_2d=locations,
+    )
+
+
+@contextmanager
