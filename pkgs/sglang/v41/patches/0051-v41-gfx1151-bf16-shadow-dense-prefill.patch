+def dequant_group32_activation_to_bf16(
+    q: torch.Tensor, scale: torch.Tensor
+) -> torch.Tensor:
+    """Exact bf16 copy of a per-32 UE8M0-scaled FP8 activation (one pass).
+
+    Uses the same integer E4M3FN decoder as the GEMV and prefill kernels, so the
+    operand values equal what `_w8a8_block_fp8_matmul` multiplies.
+    """
+    assert q.dim() == 2 and q.stride(1) == 1 and q.dtype == torch.float8_e4m3fn
+    m, k = q.shape
+    assert k % 32 == 0 and tuple(scale.shape) == (m, k // 32), (q.shape, scale.shape)
+    assert q.stride(0) % 32 == 0 or m <= 1, q.stride()
+    assert scale.dtype == torch.float32
+    out = torch.empty((m, k), dtype=torch.bfloat16, device=q.device)
+    if m:
+        block = 1024
+        _dequant_e4m3fn_group32_bf16[(m, triton.cdiv(k, block))](
+            q,
+            scale,
+            out,
+            k,
+            q.stride(0),
+            scale.stride(0),
+            scale.stride(1),
+            out.stride(0),
+            BLOCK=block,
+            num_warps=4,
+        )
+    return out
+
