+            )
+            return output.view(*input.shape[:-1], self.shadow.shape[0])
+        return self.fallback(
+            input=input,
+            weight=weight,
+            block_size=block_size,
+            weight_scale=weight_scale,
+            input_scale=input_scale,
+            bias=bias,
+        )
+
