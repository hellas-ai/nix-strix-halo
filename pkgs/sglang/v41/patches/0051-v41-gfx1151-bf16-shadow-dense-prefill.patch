+def maybe_build_dsv41_bf16_shadow(layer, method) -> None:
+    """Keep an exact bf16 copy of one dense FP8 weight for large-M prefill GEMMs.
+
+    Opt-in via SGLANG_DSV41_BF16_SHADOW_MIN_M; a no-op when unset. Costs
+    2 bytes per weight element on top of the FP8 copy decode keeps using
+    (3.83 GB per TP4 rank for the seven dense shapes of V4.1-Flash). Only layers
+    whose `w8a8_block_fp8_linear` is the V4.1 UE8M0 `triton_w8a8_block_fp8_linear`
+    partial qualify; the method's callable is wrapped, nothing else changes.
+    """
+    if not dsv41_bf16_shadow_min_m():
+        return
+    block_linear = method.w8a8_block_fp8_linear
+    if isinstance(block_linear, Dsv41Bf16ShadowLinear):  # weights reloaded
+        block_linear = block_linear.fallback
+    weight = layer.weight
+    scale = getattr(layer, "weight_scale_inv", None)
+    if (
+        not _is_hip
+        or method.use_mxfp8
+        or method.block_fp8_as_mxfp8
+        or scale is None
+        or method.weight_block_size is None
+        or list(method.weight_block_size) != [32, 32]
+        or getattr(layer, "keep_plain_weight_layout", False)
+        or getattr(block_linear, "func", None) is not triton_w8a8_block_fp8_linear
+        or getattr(block_linear, "keywords", {}).get("act_scale_ue8m0") is not True
+        or weight.dtype != torch.float8_e4m3fn
+        or weight.dim() != 2
+        or tuple(weight.shape) not in GFX1151_V41_DENSE_SHAPES
+        or scale.dtype != torch.float32
+        or tuple(scale.shape) != (weight.shape[0] // 32, weight.shape[1] // 32)
+        or not weight.is_cuda
+        or torch.cuda.get_device_properties(weight.device).gcnArchName.split(":")[0]
+        != "gfx1151"
+    ):
+        return
+    if not block_fp8_scale_is_power_of_two(scale.data):
+        # Non-UE8M0 scales would round when folded into bf16: keep the FP8 path.
+        logger.warning(
+            "dsv41 bf16 shadow skipped for %s: block scales are not powers of two",
+            tuple(weight.shape),
+        )
+        return
+    layer.dsv41_bf16_shadow = None  # drop a previous copy before allocating
+    shadow = dequant_block_fp8_weight_to_bf16(weight.data, scale.data, [32, 32])
+    layer.dsv41_bf16_shadow = shadow
+    method.w8a8_block_fp8_linear = Dsv41Bf16ShadowLinear(block_linear, shadow, weight)
+    built = _DSV41_SHADOW_BUILT
+    built["layers"] += 1
+    built["bytes"] += shadow.numel() * 2
+    shape = tuple(weight.shape)
+    if shape not in built["shapes"] or built["layers"] % 64 == 0:
+        built["shapes"].add(shape)
+        logger.info(
+            "dsv41 bf16 shadow (M >= %d): %s built; %d layers, %.2f GB so far",
+            dsv41_bf16_shadow_min_m(),
+            shape,
+            built["layers"],
+            built["bytes"] / 2**30,
+        )
