+@functools.lru_cache(maxsize=1)
+def dsv41_bf16_shadow_min_m() -> int:
+    """Smallest row count that takes the bf16 shadow GEMM; 0 (default) disables it.
+
+    Read once. A `SGLANG_DSV41_` variable, so it is part of the Mooncake cache
+    namespace: KV pages written with shadow numerics never mix with FP8 ones.
+    """
+    return max(0, int(os.environ.get("SGLANG_DSV41_BF16_SHADOW_MIN_M", "0") or "0"))
+
