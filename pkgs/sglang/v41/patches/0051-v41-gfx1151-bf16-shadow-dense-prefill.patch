+class Dsv41Bf16ShadowLinear:
+    """Per-layer `w8a8_block_fp8_linear` that sends large-M calls to a bf16 GEMM.
+
+    Installed by `maybe_build_dsv41_bf16_shadow` over the layer's existing
+    `triton_w8a8_block_fp8_linear` partial, which stays the path for every row
+    count below SGLANG_DSV41_BF16_SHADOW_MIN_M (decode, speculative verify, tails).
+    The activation quantizer is the one the fallback runs, so both paths see the
+    same FP8 operands. The expanded operands are exact in bf16 and the products
+    exact in FP32; only the accumulation order differs from the generic kernel.
+    """
+
+    def __init__(self, fallback, shadow: torch.Tensor, weight: torch.Tensor):
+        self.fallback = fallback
+        self.shadow = shadow
+        self.__name__ = "dsv41_bf16_shadow_linear"
+        # The shadow belongs to this exact storage. Other callers hand the method's
+        # callable different weights (e.g. the DSpark draft's stacked wkv): those
+        # must never see this layer's shadow.
+        self._weight_ptr = weight.data_ptr()
+        self._weight_shape = tuple(weight.shape)
+
+    def __call__(
+        self,
+        input,
+        weight,
+        block_size,
+        weight_scale,
+        input_scale=None,
+        bias=None,
+    ):
+        if (
+            weight.data_ptr() != self._weight_ptr
+            or tuple(weight.shape) != self._weight_shape
+        ):
+            return self.fallback(
+                input=input,
+                weight=weight,
+                block_size=block_size,
+                weight_scale=weight_scale,
+                input_scale=input_scale,
+                bias=bias,
+            )
+        if input_scale is None:
+            input_2d = input.view(-1, input.shape[-1])
+            output_dtype = input_2d.dtype
+            threshold = dsv41_bf16_shadow_min_m()
+            if (
+                not threshold
+                or input_2d.shape[0] < threshold
+                or output_dtype != torch.bfloat16
+                # The fallback owns quantization during capture. Do not add an
+                # unused quantizer to the graph before handing it the raw input.
+                or torch.cuda.is_current_stream_capturing()
+            ):
+                return self.fallback(
+                    input=input,
+                    weight=weight,
+                    block_size=block_size,
+                    weight_scale=weight_scale,
+                    input_scale=input_scale,
+                    bias=bias,
+                )
+            q_input, x_scale = sglang_per_token_group_quant_fp8(
+                input_2d, block_size[1], scale_ue8m0=True
