+        else:
+            q_input = input.view(-1, input.shape[-1])
+            x_scale, output_dtype = input_scale, torch.bfloat16
+        if dsv41_bf16_shadow_applies(
+            self.shadow, q_input, x_scale, block_size, output_dtype, bias
