+def dequant_block_fp8_weight_to_bf16(
+    weight: torch.Tensor, scale: torch.Tensor, block_size: List[int]
+) -> torch.Tensor:
+    """Exact bf16 copy of a block-scaled FP8 weight.
+
+    E4M3FN values have a 4-bit significand, so value * 2^k is exact in FP32 and
+    in bf16 (8-bit significand, FP32 exponent range) for the UE8M0 power-of-two
+    scales of the V4.1 checkpoint. Chunked over rows to bound the FP32 temporary.
+    """
+    n, k = weight.shape
+    block_n, block_k = block_size
+    assert n % block_n == 0 and k % block_k == 0, (weight.shape, block_size)
+    assert tuple(scale.shape) == (n // block_n, k // block_k), (
+        scale.shape,
+        weight.shape,
+    )
+    out = torch.empty((n, k), dtype=torch.bfloat16, device=weight.device)
+    rows = max(block_n, (1 << 24) // k // block_n * block_n)
+    for lo in range(0, n, rows):
+        hi = min(n, lo + rows)
+        w = weight[lo:hi].to(torch.float32).view(-1, block_n, k // block_k, block_k)
+        s = scale[lo // block_n : hi // block_n].to(torch.float32)
+        out[lo:hi] = (w * s.view(-1, 1, k // block_k, 1)).view(hi - lo, k).to(
+            torch.bfloat16
+        )
+    return out
+
+
+def block_fp8_scale_is_power_of_two(scale: torch.Tensor) -> bool:
+    """True when every scale is a finite, nonzero power of two (zero mantissa)."""
+    bits = scale.to(torch.float32).contiguous().view(torch.int32)
+    exponent = (bits >> 23) & 0xFF
+    return bool(
+        ((bits & 0x7FFFFF) == 0).all().item()
+        and (exponent != 0).all().item()
+        and (exponent != 0xFF).all().item()
+    )
+
+
+# K and the row strides are multiples of 32 (asserted by the wrapper), so their
+# divisibility specialization is one constant state and keeps the 8-byte loads and
+# 16-byte stores. The scale strides (K / 32, or 1 when transposed) are the ones
+# that would otherwise split the cache per shape.
+@triton.jit(do_not_specialize=["stride_sm", "stride_sg"])
+def _dequant_e4m3fn_group32_bf16(
+    Q,
+    S,
+    OUT,
+    K,
+    stride_qm,
+    stride_sm,
+    stride_sg,
+    stride_om,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    col = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = col < K
+    value = _e4m3fn_to_fp32(
+        tl.load(Q + row * stride_qm + col, mask=mask, other=0.0)
+    )
+    scale = tl.load(S + row * stride_sm + (col // 32) * stride_sg, mask=mask, other=1.0)
+    tl.store(OUT + row * stride_om + col, (value * scale).to(tl.bfloat16), mask=mask)
+
