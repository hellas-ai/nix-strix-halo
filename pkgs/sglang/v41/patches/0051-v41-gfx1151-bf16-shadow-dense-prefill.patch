+# The seven dense FP8 shapes of one TP4 rank (wqkv_a, wq_b, wo_b, shared
+# gate_up, shared down, Engram wkv, indexer wq_b). Mirrors the literal set in
+# `_use_gfx1151_fp8_prefill_cast` (kept literal there because tests/prefill-dispatch.py
+# execs that function alone); tests/bf16-shadow-cpu.py asserts the two stay equal.
+GFX1151_V41_DENSE_SHAPES = frozenset(
+    {
+        (1792, 5120),
+        (8192, 1280),
+        (5120, 2048),
+        (1152, 5120),
+        (5120, 576),
+        (25600, 6144),
+        (4096, 1280),
+    }
+)
+
