+def dsv41_bf16_shadow_applies(
+    shadow, q_input, x_scale, block_size, output_dtype, bias
+) -> bool:
+    """Gate for the bf16 shadow GEMM: large M only, exactly the generic kernel's inputs."""
+    threshold = dsv41_bf16_shadow_min_m()
+    return (
+        bool(threshold)
+        and shadow is not None
+        and q_input.shape[0] >= threshold
+        and list(block_size) == [32, 32]
+        and bias is None
+        and output_dtype == torch.bfloat16
+        and q_input.dtype == torch.float8_e4m3fn
+        and x_scale.dtype == torch.float32
+        and q_input.dim() == 2
+        and q_input.stride(1) == 1
+        and tuple(x_scale.shape) == (q_input.shape[0], q_input.shape[1] // 32)
+        and shadow.shape[1] == q_input.shape[1]
+        and q_input.device == shadow.device
+        and not torch.cuda.is_current_stream_capturing()
+    )
+
