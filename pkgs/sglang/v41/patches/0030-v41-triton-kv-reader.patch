 # gfx942/MI300/MI325 stores e4m3fnuz (bias 8);
 # gfx950/MI350 and CUDA store OCP e4m3fn (bias 7).
 _KV_FP8_TY = tl.float8e4b8 if is_gfx942_supported() else tl.float8e4nv
+
+
+def _v41_cache_layout(*caches: torch.Tensor) -> bool:
+    """Only the paged V41 FP8 pair is supported by the new reader."""
+    widths = tuple(cache.shape[-1] for cache in caches)
+    if 288 in widths:
+        raise ValueError("Triton sparse attention does not support V41 FP4 caches")
+    if 528 not in widths:
+        return False  # Preserve the existing V4 reader/validation path.
+    if any(width != 528 for width in widths):
+        raise ValueError("Triton V41 requires matching FP8 main/extra layouts")
+    for cache in caches:
+        if (cache.ndim != 4 or cache.shape[2] != 1 or cache.element_size() != 1
+                or cache.stride(-1) != 1 or cache.stride(1) != 528
+                or cache.stride(0) < cache.shape[1] * 528):
+            raise ValueError("Triton V41 requires a byte-backed paged [P,S,1,528] view")
+    return True


