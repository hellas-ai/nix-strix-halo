+# ----------------------------------------------------------------------------------------------
+# prefill (opt-in, SGLANG_DSV41_PREFILL_GLUE=1): the same P and E kernels for the 17..2047-row prefill calls. They are bitwise the installed torch
+# sequences at any row count (per-element arithmetic, one scale per 32-value group); only the launch shape differs: one program per 32 groups
+# (P) or per route row and 16 groups (E) instead of the decode shapes (one warp, 8 and 2 groups), which are launch-bound at 1536 rows.
+# ----------------------------------------------------------------------------------------------
+PREFILL_GLUE = os.environ.get("SGLANG_DSV41_PREFILL_GLUE") == "1"
+_PREFILL_P_GROUPS, _PREFILL_E_GROUPS = 32, 16
+
+
+def prefill_glue_supported(hidden_states, w13, w2, topk_weights, topk_ids, routed_scaling_factor, swiglu_limit) -> bool:
+    x = hidden_states
+    return (
+        PREFILL_GLUE and x.ndim == 2 and x.shape[0] >= 17 and x.shape[1] == HIDDEN and x.dtype == torch.bfloat16 and x.is_contiguous()
+        and x.device.type == "cuda" and _is_gfx1151(x.device.index if x.device.index is not None else torch.cuda.current_device())
+        and swiglu_limit == 10 and (routed_scaling_factor is None or isinstance(routed_scaling_factor, (int, float)))
+        and tuple(w13.shape) == (NUM_EXPERTS, N_GATE_UP, HIDDEN // 2) and tuple(w2.shape) == (NUM_EXPERTS, N_DOWN, INTER // 2)
+        and topk_weights.dtype == torch.float32 and topk_weights.is_contiguous() and tuple(topk_weights.shape) == (x.shape[0], TOPK)
+    )
+
+
+def prefill_operand(x):
+    """== `_official_routed_operand(x)`: group-32 E4M3/E8M0 quantise then dequantise to bf16."""
+    out = torch.empty_like(x)
+    groups = x.shape[0] * (HIDDEN // GROUP)
+    _prep_operand[(triton.cdiv(groups, _PREFILL_P_GROUPS),)](x, out, groups, _PREFILL_P_GROUPS, EPS, FP8_MAX,
+                                                              num_warps=4, num_stages=1, enable_fp_fusion=False)
+    return out
+
+
+def prefill_swiglu(gu, topk_weights, factor):
+    """gu bf16 [M, 6, 1152] contiguous -> bf16 [M*6, 576]: clamp, silu*up, route scale, bf16, group-32 quantise-dequantise."""
+    m = gu.shape[0]
+    a2 = torch.empty((m * TOPK, INTER), dtype=torch.bfloat16, device=gu.device)
+    _swiglu_operand[(m * TOPK, triton.cdiv(INTER // GROUP, _PREFILL_E_GROUPS))](
+        gu, topk_weights, topk_weights, a2, 1.0 if factor is None else float(factor),
+        INTER, _PREFILL_E_GROUPS, 10.0, 0, EPS, FP8_MAX, num_warps=2, num_stages=1, enable_fp_fusion=False)
+    return a2
+
+
