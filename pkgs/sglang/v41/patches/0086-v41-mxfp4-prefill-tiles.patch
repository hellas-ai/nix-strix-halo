+# Opt-in prefill tiles for the V4.1 TP4 routed experts (SGLANG_DSV41_MXFP4_PREFILL_TILES=1).
+#
+# Measured at the real shapes (E=384, top-6, w13 N=1152 K=5120, w2 N=5120 K=576) with real routing:
+#   gate/up   M=128   BM16 BN256 BK64 (the AITER default) 9.5-10 ms   BM16 BN64 BK256 w4 s2 wpe0 2.4 ms
+#             M=1536  BM32 BN128 BK128 (the n128k128 guard)  10.8-11.9 ms   BM32 BN64 BK256 w4 s2 wpe0 8.8 ms
+#             M=1792  BM32 BN256 BK64 (guard is M==1536 only) 24.8 ms   BM32 BN64 BK256 ... 9.6 ms
+#   down      M=128   BM16 BN256 BK64 1.32 ms   BM16 BN128 BK64 w4 s2 wpe1 1.11 ms (M>=512: unchanged)
+# The K loop and the N tile change but the k-order of every output element does not, so results are bit-identical to the guarded tiles.
+# sparse_moe_config cannot apply its own BN64/BK256 tile to V4.1 because one config drives both GEMMs and the down GEMM has K=576.
+_PREFILL_TILES = os.environ.get("SGLANG_DSV41_MXFP4_PREFILL_TILES") == "1"
+
+
+def _v41_tp4_prefill_shape(arch, num_tokens, top_k, num_experts, hidden_size, intermediate_size) -> bool:
+    return (
+        arch == "gfx1151"
+        and num_tokens >= 64
+        and (top_k, num_experts, hidden_size, intermediate_size) == (6, 384, 5120, 576)
+    )
+
+
+def down_moe_config(
+    config: dict,
+    arch: str,
+    num_tokens: int,
+    top_k: int,
+    num_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> dict:
+    """Down-projection tile: only the sparse (BM16) case, where the default BN256 tile is 16% slower than BN128."""
+    if (
+        _PREFILL_TILES
+        and _v41_tp4_prefill_shape(arch, num_tokens, top_k, num_experts, hidden_size, intermediate_size)
+        and (config.get("BLOCK_SIZE_M"), config.get("BLOCK_SIZE_N"), config.get("BLOCK_SIZE_K")) == (16, 256, 64)
+    ):
+        return {**config, "BLOCK_SIZE_N": 128, "num_warps": 4, "num_stages": 2, "waves_per_eu": 1}
+    return config
+
+
 def gate_up_moe_config(
