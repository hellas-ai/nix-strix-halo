+@triton.jit
+def _safe_scale_pair(QS, KS, row0, row1, page, off, live, qs_stride,
+                     BLOCK: tl.constexpr):
+    heads = tl.arange(0, 32)
+    groups = tl.arange(0, 4)
+    qe0 = tl.load(QS + row0 * qs_stride + groups[None, :] * 64
+                  + (heads[:, None] % 16) * 4 + heads[:, None] // 16).to(tl.int32)
+    qe1 = tl.load(QS + row1 * qs_stride + groups[None, :] * 64
+                  + (heads[:, None] % 16) * 4 + heads[:, None] // 16).to(tl.int32)
