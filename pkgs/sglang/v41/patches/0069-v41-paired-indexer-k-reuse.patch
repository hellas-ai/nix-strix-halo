+        + off[None, :] * 16 + dim[:, None] // 2,
+        mask=live[None, :], other=0,
+    ).to(tl.int32)
+    k = _e2m1_bf16((kb >> ((dim[:, None] % 2) * 4)) & 15)
+    ke = tl.load(
+        KS + page.to(tl.int64) * 256 + GROUP * 64
+        + (off % 16) * 4 + off // 16,
+        mask=live, other=127,
+    ).to(tl.int32)
+    return k, ke
+
+
+@triton.jit
+def _row_group_dot(Q, QS, row, k, ke, q_stride, qs_stride,
+                   GROUP, BLOCK: tl.constexpr):
+    head = tl.arange(0, 32)
+    dim = tl.arange(0, 32)
+    qb = tl.load(
+        Q + row * q_stride + head[:, None] * 64
+        + GROUP * 16 + dim[None, :] // 2,
+    ).to(tl.int32)
+    q = _e2m1_bf16((qb >> ((dim[None, :] % 2) * 4)) & 15)
+    dot = tl.floor(tl.dot(q, k) * 4.0 + 0.5) * 0.25
+    qe = tl.load(
+        QS + row * qs_stride + GROUP * 64
+        + (head % 16) * 4 + head // 16,
+    ).to(tl.int32)
+    qscale = (qe << 23).to(tl.float32, bitcast=True)
+    kscale = (ke << 23).to(tl.float32, bitcast=True)
+    return dot * (qscale[:, None] * kscale[None, :])
