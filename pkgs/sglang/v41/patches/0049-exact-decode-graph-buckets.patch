+++ b/sglang/srt/layers/graph_bucket_policy.py
@@ -0,0 +1,71 @@
+"""Which decode graph bucket lists the file-backed Engram graphs accept.
+
+The qualified default is a power-of-two prefix ladder: [1], [1,2], [1,2,4] or
+[1,2,4,8].  A batch between two captured sizes then replays the next larger
+bucket and its padding rows are computed (and, before the live-row mask, routed
+to experts) like any other row.
+
+``SGLANG_DSV41_EXACT_GRAPH_BUCKETS=1`` additionally admits the exact ladders
+[1..n], 1 <= n <= 8: every raw batch size 1..n has a graph of its own size, so
+no replay ever carries padding rows.  Exact ladders are never inferred from any
+other setting; with the variable unset every function below reproduces the
+installed behaviour.  Row counts are capped by the callers (the Engram stagers
+hold at most eight token rows).
+
+Pure Python on purpose: the CPU regressions load this file by path.
+"""
+
+import os
+
+ENV_EXACT_BUCKETS = "SGLANG_DSV41_EXACT_GRAPH_BUCKETS"
+MAX_EXACT_BS = 8
+LEGACY_PREFIX_LADDERS = ([1], [1, 2], [1, 2, 4], [1, 2, 4, 8])
+
+_OFF = ("", "0", "false", "off", "no")
+
+
+def exact_graph_buckets_enabled() -> bool:
+    """True when the operator explicitly asked for exact [1..n] graph buckets."""
+    return os.environ.get(ENV_EXACT_BUCKETS, "").strip().lower() not in _OFF
+
+
+def is_exact_ladder(capture_bs) -> bool:
+    """capture_bs == [1, 2, ..., n] with 1 <= n <= MAX_EXACT_BS."""
+    buckets = list(capture_bs)
+    return 1 <= len(buckets) <= MAX_EXACT_BS and buckets == list(
+        range(1, len(buckets) + 1)
+    )
+
+
+def engram_capture_bs_allowed(capture_bs) -> bool:
+    """Whether the Engram graph stagers may serve exactly this capture list."""
+    buckets = list(capture_bs)
+    if buckets in [list(ladder) for ladder in LEGACY_PREFIX_LADDERS]:
+        return True
+    return exact_graph_buckets_enabled() and is_exact_ladder(buckets)
+
+
+def prestage_capture_bs(max_bs: int, capture_bs=None) -> tuple:
+    """The prestage's bucket tuple for the runner's capture list.
+
+    ``capture_bs=None`` is the installed derivation (power-of-two prefix up to
+    ``max_bs``, which must itself be 1/2/4/8).  An explicit list must be one the
+    runner accepts and must end at ``max_bs``; a legacy ladder gives the same
+    tuple the installed derivation does.
+    """
+    if capture_bs is None:
+        if max_bs not in (1, 2, 4, 8):
+            raise ValueError("Engram graph prestage requires max_bs 1, 2, 4, or 8")
+        return tuple(bs for bs in (1, 2, 4, 8) if bs <= max_bs)
+    buckets = tuple(int(bs) for bs in capture_bs)
+    if (
+        not engram_capture_bs_allowed(buckets)
+        or buckets[-1] != max_bs
+        or not 1 <= max_bs <= MAX_EXACT_BS
+    ):
+        raise ValueError(
+            "Engram graph prestage requires a prefix [1]/[1,2]/[1,2,4]/[1,2,4,8] "
+            f"capture list (or an exact [1..n] list when {ENV_EXACT_BUCKETS}=1) "
+            "that ends at max_bs"
+        )
+    return buckets
