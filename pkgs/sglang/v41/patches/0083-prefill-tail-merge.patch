+def _read_tail_merge_rows() -> int:
+    """SGLANG_PREFILL_TAIL_MERGE_ROWS: 0 (default) keeps every chunk at the chunk size."""
+    value = os.environ.get("SGLANG_PREFILL_TAIL_MERGE_ROWS", "").strip()
+    if not value:
+        return 0
+    try:
+        rows = int(value)
+    except ValueError:
+        raise ValueError(
+            f"SGLANG_PREFILL_TAIL_MERGE_ROWS must be a non-negative integer, got {value!r}"
+        ) from None
+    if rows < 0:
+        raise ValueError(f"SGLANG_PREFILL_TAIL_MERGE_ROWS must be >= 0, got {rows}")
+    return rows
+
+
+# A prompt that ends a few rows past a chunk boundary pays a whole extra forward
+# for them (weight streaming, ~5.4K launches, 80 collectives) and runs a row count
+# the tuned tiles do not cover. With this set, the rows past the last full chunk
+# ride with it when there are at most this many: one forward of up to
+# chunk + rows instead of two.
+TAIL_MERGE_ROWS = _read_tail_merge_rows()
+
+
+def tail_merge_fits(
+    rows: int,
+    limit: int,
+    merge_rows: int,
+    budget: Optional[int],
+    first_in_batch: bool,
+) -> bool:
+    """Whether the `rows - limit` rows after this chunk should join it.
+
+    `rows` is what the request still has to extend, `limit` the rows this chunk
+    could take, `budget` the batch's whole remaining chunk budget. Only the first
+    request of a batch merges, and only with an uncapped chunk, so a batch never
+    grows past chunk + merge_rows and a memory-capped chunk keeps its cap.
+    """
+    return (
+        merge_rows > 0
+        and first_in_batch
+        and budget is not None
+        and limit == budget
+        and 0 < rows - limit <= merge_rows
+    )
+
+
 # Threshold for in-batch prefix cache.
