 import triton.language as tl
 
 
+# Length- and pool-dependent arguments. WIDTH, PAGE_COLS and PAGES used to be
+# `tl.constexpr`, so Triton JIT-compiled a new variant (about 1.4 s on a 2.5 GHz
+# Strix host, on every rank in lockstep) each time the guarded page table grew
+# by 4096 positions: 36 variants in one qualification campaign, ~39 s inside a
+# single cold 61K prefill, and up to ~256 at a 1M-token context window. As
+# runtime integers they only bound loops and masks, so the arithmetic is the
+# same. `do_not_specialize` also keeps Triton from splitting the cache on
+# divisibility by 16 or equality with 1 of these values (pt_stride equals
+# PAGE_COLS for the guarded table), so one variant serves every length.
+_LENGTH_ARGS = ["pt_stride", "WIDTH", "PAGE_COLS", "PAGES"]
+# Long prefills score the logits block in row chunks and pass `lengths[rows]` (and
+# the other per-row inputs) sliced at arbitrary row offsets, so a pointer is
+# 16-byte aligned for some chunks and not others: a second variant per width.
+# These are only read through scalar/gather loads, so alignment is no benefit
+# (the amdgcn instruction mix is identical with and without the assumption).
+_ROW_POINTER_ARGS = ["Q", "QS", "W", "PT", "LENS"]
+
+
 def use_gfx1151_indexer(device: torch.device) -> bool:
     return bool(torch.version.hip) and (
         torch.cuda.get_device_properties(device).gcnArchName.split(":")[0] == "gfx1151"
