+"""AMD Triton MXFP4 MoE fallback.
+
+This keeps routed-expert weights in their checkpoint-native packed E2M1/E8M0
+layout.  It is intentionally W4A16: decode-sized activations are cheap to read
+as BF16, while expanding the 138 GiB routed-expert weight set to FP8 is not.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+import torch.nn.functional as F
+import triton.language as tl
+
+
+def _run_mxfp4_gemm(
+    a: torch.Tensor,
+    weight: torch.Tensor,
+    output: torch.Tensor,
+    weight_mx_scale: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    sorted_token_ids: torch.Tensor,
+    expert_ids: torch.Tensor,
+    num_tokens_post_padded: torch.Tensor,
+    *,
+    config: dict,
+    top_k: int,
+    mul_routed_weight: bool,
+) -> None:
+    if a.shape == (2, 5120) and top_k == 6 and not mul_routed_weight:
+        from sglang.kernels.ops.gemm.dsv41_mxfp4_gate_up import try_gate_up_live_rows
+
+        if try_gate_up_live_rows(
+            a, weight, output, weight_mx_scale, topk_ids,
+            config, top_k, mul_routed_weight,
+        ):
+            return
+
+    from aiter.ops.triton.moe.moe_op_mxfp4 import fused_moe_mxfp4
+
+    num_experts = weight.shape[0]
+    # The checkpoint's E8M0 tensors carry the real per-1x32 scales.  These
+    # scalar operands are separate optional multipliers in AITER's wrapper.
+    a_scale = torch.ones(1, dtype=torch.float32, device=a.device)
+    b_scale = torch.ones(num_experts, dtype=torch.float32, device=a.device)
+    fused_moe_mxfp4(
+        a,
+        weight.view(torch.uint8),
+        output,
+        a_scale,
+        b_scale,
+        None,
+        weight_mx_scale.view(torch.uint8),
+        topk_weights,
+        topk_ids,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        mul_routed_weight,
+        top_k,
+        False,
+        False,
+        config,
+        tl.bfloat16 if a.dtype == torch.bfloat16 else tl.float16,
+    )
+
+
+# Portable software-unpack tiles; unknown architectures retain AITER defaults.
+_SPARSE_MOE_TILE = {
+    "gfx1151": {
+        "BLOCK_SIZE_N": 64,
+        "BLOCK_SIZE_K": 256,
+        "num_warps": 4,
+        "waves_per_eu": 1,
+    },
+}
+
+
+def sparse_moe_config(
+    config: dict,
+    arch: str,
+    num_tokens: int,
+    top_k: int,
+    num_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> dict:
+    """Avoid padding sparse expert assignments to a dense prefill tile."""
+    tokens_per_expert = (num_tokens * top_k) // max(num_experts, 1)
+    if tokens_per_expert >= 16:
+        return config
+
+    if config["BLOCK_SIZE_M"] > 16:
+        config = {**config, "BLOCK_SIZE_M": 16}
+
+    tile = _SPARSE_MOE_TILE.get(arch)
+    if tile is None:
+        return config
+    # One config drives both GEMMs: w13 is (N=2*inter, K=hidden) and w2 is
+    # (N=hidden, K=inter). Keep EVEN_K true and the N tiles whole on both, or
+    # the kernel falls to its masked path and the geometry stops being the one
+    # that was measured.
+    block_n, block_k = tile["BLOCK_SIZE_N"], tile["BLOCK_SIZE_K"]
+    if hidden_size % block_k or intermediate_size % block_k:
+        return config
+    if hidden_size % block_n or (2 * intermediate_size) % block_n:
+        return config
+    return {**config, **tile}
+
+
+def gate_up_moe_config(
+    config: dict,
+    arch: str,
+    num_tokens: int,
+    top_k: int,
+    num_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> dict:
+    """Avoid the wrapped half N tile in native TP4 C2 gate/up only."""
+    expected = {
+        "BLOCK_SIZE_M": 16, "BLOCK_SIZE_N": 256, "BLOCK_SIZE_K": 64,
+        "GROUP_SIZE_M": 8, "num_warps": 8, "num_stages": 2,
+        "waves_per_eu": 0, "matrix_instr_nonkdim": 16, "kpack": 1,
+    }
+    if (
+        arch == "gfx1151"
+        and (num_tokens, top_k, num_experts, hidden_size, intermediate_size)
+        == (2, 6, 384, 5120, 576)
+        and all(config.get(key) == value for key, value in expected.items())
+    ):
+        return {**config, "BLOCK_SIZE_N": 128}
+    return config
+
+
+def fused_experts_mxfp4(
+    hidden_states: torch.Tensor,
+    w13_weight: torch.Tensor,
+    w2_weight: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    w13_weight_scale: torch.Tensor,
+    w2_weight_scale: torch.Tensor,
+    *,
+    activation: str,
+    is_gated: bool,
+    inplace: bool,
+    no_combine: bool,
+    apply_router_weight_on_input: bool,
+    routed_scaling_factor: Optional[float],
+    swiglu_limit: Optional[float],
+) -> torch.Tensor:
+    """Run canonical W4A16 routed experts through AITER's Triton consumer."""
+    from aiter.ops.triton.utils._triton.arch_info import get_arch
+    from aiter.ops.triton.utils.moe_config_utils import get_optimal_moe_config
+
+    from sglang.srt.layers.moe.moe_runner.triton_utils.moe_align_block_size import (
+        moe_align_block_size,
+    )
+
+    if hidden_states.shape[0] == 0:
+        if no_combine:
+            return hidden_states.new_empty(
+                (0, topk_ids.shape[1], w2_weight.shape[1])
+            )
+        return hidden_states
+
+    assert hidden_states.dtype in (torch.bfloat16, torch.float16)
+    assert activation == "silu" and is_gated
+    assert topk_ids.dtype == torch.int32
+    assert topk_weights.dtype == torch.float32
+    assert w13_weight.ndim == w2_weight.ndim == 3
+    assert w13_weight.shape[0] == w2_weight.shape[0]
+    assert w13_weight.shape[2] * 2 == hidden_states.shape[1]
+    assert w2_weight.shape[2] * 2 == w13_weight.shape[1] // 2
+    assert w13_weight_scale.shape == (
+        w13_weight.shape[0],
+        w13_weight.shape[1],
+        hidden_states.shape[1] // 32,
+    )
+    assert w2_weight_scale.shape == (
+        w2_weight.shape[0],
+        w2_weight.shape[1],
+        (w13_weight.shape[1] // 2) // 32,
+    )
+
+    num_tokens = hidden_states.shape[0]
+    top_k = topk_ids.shape[1]
+    num_experts = w13_weight.shape[0]
+    intermediate_size = w13_weight.shape[1] // 2
+    config = get_optimal_moe_config(
+        hidden_states.dtype,
+        use_mxfp4=True,
+        M=num_tokens,
+    )
+    config = sparse_moe_config(
+        config,
+        get_arch(),
+        num_tokens,
+        top_k,
+        num_experts,
+        hidden_states.shape[1],
+        intermediate_size,
+    )
+    sorted_token_ids, expert_ids, num_tokens_post_padded = moe_align_block_size(
+        topk_ids, config["BLOCK_SIZE_M"], num_experts
+    )
+
+    gate_up = torch.empty(
+        (num_tokens, top_k, 2 * intermediate_size),
+        dtype=hidden_states.dtype,
+        device=hidden_states.device,
+    )
+    gate_up_config = config
+    if hidden_states.dtype == torch.bfloat16 and not apply_router_weight_on_input:
+        gate_up_config = gate_up_moe_config(
+            config, get_arch(), num_tokens, top_k, num_experts,
+            hidden_states.shape[1], intermediate_size,
+        )
+    _run_mxfp4_gemm(
+        hidden_states,
+        w13_weight,
+        gate_up,
+        w13_weight_scale,
+        topk_weights,
+        topk_ids,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        config=gate_up_config,
+        top_k=top_k,
+        mul_routed_weight=apply_router_weight_on_input,
+    )
+
+    gate, up = gate_up.chunk(2, dim=-1)
+    if swiglu_limit is not None:
+        assert swiglu_limit == 10
+        gate = gate.clamp(max=swiglu_limit)
+        up = up.clamp(min=-swiglu_limit, max=swiglu_limit)
+    activated = (F.silu(gate) * up).reshape(
+        num_tokens * top_k, intermediate_size
+    )
+    del gate_up
+
+    routed_output = torch.empty(
+        (num_tokens, top_k, w2_weight.shape[1]),
+        dtype=hidden_states.dtype,
+        device=hidden_states.device,
+    )
+    # sorted_token_ids addresses flattened token/expert assignments here.
+    # top_k=1 is therefore required for the already-expanded activation.
+    _run_mxfp4_gemm(
+        activated,
+        w2_weight,
+        routed_output,
+        w2_weight_scale,
+        topk_weights,
+        topk_ids,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        config=config,
+        top_k=1,
+        mul_routed_weight=not apply_router_weight_on_input,
+    )
+    if no_combine:
+        if routed_scaling_factor is not None:
+            routed_output.mul_(routed_scaling_factor)
+        return routed_output
+
+    combined = routed_output.sum(dim=1)
+    if routed_scaling_factor is not None:
+        combined.mul_(routed_scaling_factor)
+    if inplace:
+        hidden_states.copy_(combined)
+        return hidden_states
+    return combined
