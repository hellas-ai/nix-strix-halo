+def _never_raises(method):
+    """The record is observational: a bug in it must not stop the scheduler.
+
+    The first exception is logged with its traceback and switches the recorder
+    off; later hook calls return immediately.
+    """
+
+    @functools.wraps(method)
+    def guarded(self, *args, **kwargs):
+        if self.failed:
+            return None
+        try:
+            return method(self, *args, **kwargs)
+        except Exception:
+            self.failed = True
+            logger.exception("scheduler timing record disabled after an error")
+            return None
+
+    return guarded
+
