+def glm53_draft_temperatures(sampling_info) -> torch.Tensor:
+    """GLM-5.3 campaign (0041): the draft proposal temperature per row. Greedy requests are stored as temperature
+    1 with top_k 1, so a sampled rejection-sampling proposal would draw them at temperature 1 and lose acceptance;
+    a ~0 temperature keeps their proposal the draft argmax (q one-hot). Graph-captured sampling infos carry
+    top_k -1 and are left alone (the graph runner copies the adjusted temperatures in)."""
+    temperatures = sampling_info.temperatures
+    top_ks = getattr(sampling_info, "top_ks", None)
+    if top_ks is None or top_ks.shape[0] != temperatures.shape[0]:
+        return temperatures
+    return torch.where(
+        top_ks.view(-1, 1) == 1, torch.full_like(temperatures, 1e-5), temperatures
+    )
+
