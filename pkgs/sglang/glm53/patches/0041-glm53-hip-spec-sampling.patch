+def _glm53_hip_spec_sampling_enabled() -> bool:
+    import os
+
+    return os.environ.get("SGLANG_GLM53_HIP_SPEC_SAMPLING", "1") != "0"
+
+
+def _glm53_hip_chain_target_probs(
+    next_token_logits: torch.Tensor,
+    sampling_info: SamplingBatchInfo,
+    draft_token_num: int,
+) -> torch.Tensor:
+    """GLM-5.3 campaign (0041): verify-row target distributions on HIP without
+    sgl_kernel's CUDA renorm ops: temperature softmax, then top-k / top-p / min-p
+    on one descending sort (the semantics of the torch sampler), renormalised.
+    Greedy rows (top_k 1) become one-hot on their argmax."""
+    import torch.nn.functional as F
+
+    rows = lambda t: torch.repeat_interleave(t, draft_token_num, dim=0)
+    probs = F.softmax(
+        next_token_logits.float() / rows(sampling_info.temperatures), dim=-1
+    )
+    if not (
+        sampling_info.need_top_k_sampling
+        or sampling_info.need_top_p_sampling
+        or sampling_info.need_min_p_sampling
+    ):
+        return probs
+    probs_sort, probs_idx = probs.sort(dim=-1, descending=True)
+    if sampling_info.need_top_k_sampling:
+        top_ks = rows(sampling_info.top_ks)
+        probs_sort.masked_fill_(
+            torch.arange(probs.shape[-1], device=probs.device).view(1, -1)
+            >= top_ks.view(-1, 1),
+            0.0,
+        )
+    if sampling_info.need_top_p_sampling:
+        probs_sum = torch.cumsum(probs_sort, dim=-1)
+        probs_sort.masked_fill_(
+            (probs_sum - probs_sort) > rows(sampling_info.top_ps).view(-1, 1), 0.0
+        )
+    if sampling_info.need_min_p_sampling:
+        probs_sort.masked_fill_(
+            probs_sort < (probs_sort[:, :1] * rows(sampling_info.min_ps).view(-1, 1)),
+            0.0,
+        )
+    probs_sort.div_(probs_sort.sum(dim=-1, keepdim=True))
+    return torch.zeros_like(probs).scatter_(-1, probs_idx, probs_sort)
+
+
