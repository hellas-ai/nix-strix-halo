+def glm53_draft_topk(probs: torch.Tensor, topk: int):
+    """Keep deterministic HIP chain proposals identical before each forward.
+
+    GroupCoordinator.broadcast uses the captured pynccl communicator in graph
+    capture, as in sample_draft_proposal. Trees and other devices stay unchanged.
+    """
+    topk_p, topk_index = fast_topk(probs, topk, dim=-1)
+    if _is_hip and topk == 1:
+        from sglang.srt.distributed import get_tp_group
+
+        group = get_tp_group()
+        if group.world_size > 1:
+            group.broadcast(topk_index, src=0)
+            topk_p = probs.gather(1, topk_index)
+    return topk_p, topk_index
+
