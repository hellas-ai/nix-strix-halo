+
+def _glm53_dflash_verify_widths(block_size: int) -> Optional[List[int]]:
+    """GLM-5.3 campaign (0042): DFlash verify width per running-request count, e.g. "8,4,4,2" (batch sizes past the
+    list reuse its last entry). The draft still proposes the whole block (one forward whatever the width); only the
+    first `width` block tokens (bonus + width - 1 drafts) go through the target verify. Unset: the whole block."""
+    raw = os.environ.get(GLM53_DFLASH_VERIFY_WIDTHS_ENV, "").strip()
+    if not raw:
+        return None
+    try:
+        widths = [int(part) for part in raw.split(",") if part.strip()]
+    except ValueError as e:
+        raise ValueError(f"{GLM53_DFLASH_VERIFY_WIDTHS_ENV}={raw!r}: expected integers") from e
+    # Width 1 would verify only the bonus token, which the selector's sampling verify cannot express.
+    if not widths or any(width < 2 or width > block_size for width in widths):
+        raise ValueError(
+            f"{GLM53_DFLASH_VERIFY_WIDTHS_ENV}={raw!r}: widths must be in 2..{block_size} (the block size)"
+        )
+    return widths
+
+
+def _glm53_width_for(widths: List[int], batch_size: int) -> int:
+    return widths[min(max(batch_size, 1), len(widths)) - 1]
+
