+# SPDX-License-Identifier: Apache-2.0
+"""Single-launch RMSNorm and fused add+RMSNorm Triton kernels for ROCm without vLLM/AITER.
+
+Without vLLM's custom ops and with SGLANG_USE_AITER=0, ``RMSNorm.forward_hip`` falls back to ``forward_native``:
+about eleven kernels per norm with a residual (casts to fp32, add, cast back, pow, mean, eps add, rsqrt and two
+multiplies). These kernels do the same fp32 math in one pass per row, in the same order as ``forward_native``:
+s = x (+ residual), residual_out = s cast back, rstd = rsqrt(mean(s * s) + eps), out = ((s * rstd) * weight) cast to
+the output dtype. The row reduction order differs from torch's, so results can differ in the last bits.
+Opt-in: SGLANG_ROCM_TRITON_RMSNORM=1.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _rmsnorm_kernel(
+    x_ptr,
+    w_ptr,
+    out_ptr,
+    res_ptr,
+    res_out_ptr,
+    n_cols,
+    stride_x,
+    stride_r,
+    eps,
+    HAS_RESIDUAL: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    row = tl.program_id(0)
+    cols = tl.arange(0, BLOCK_N)
+    mask = cols < n_cols
+    s = tl.load(x_ptr + row * stride_x + cols, mask=mask, other=0.0).to(tl.float32)
+    if HAS_RESIDUAL:
+        r = tl.load(res_ptr + row * stride_r + cols, mask=mask, other=0.0).to(tl.float32)
+        s = s + r
+        tl.store(res_out_ptr + row * n_cols + cols, s.to(res_out_ptr.dtype.element_ty), mask=mask)
+    var = tl.sum(s * s, axis=0) / n_cols
+    rstd = tl.math.rsqrt(var + eps)
+    w = tl.load(w_ptr + cols, mask=mask, other=0.0).to(tl.float32)
+    out = (s * rstd) * w
+    tl.store(out_ptr + row * n_cols + cols, out.to(out_ptr.dtype.element_ty), mask=mask)
+
+
+def _num_warps(block_n: int) -> int:
+    if block_n >= 4096:
+        return 16
+    if block_n >= 1024:
+        return 8
+    return 4
+
+
+def rmsnorm(x: torch.Tensor, weight: torch.Tensor, eps: float, out_dtype: torch.dtype,
+            residual: torch.Tensor = None):
+    """RMSNorm over the last dim; with ``residual``, returns (normed, x + residual), both in ``out_dtype``
+    (forward_native casts the pre-norm sum to the original dtype too)."""
+    n = x.shape[-1]
+    x2 = x.reshape(-1, n)
+    m = x2.shape[0]
+    out = torch.empty((m, n), dtype=out_dtype, device=x.device)
+    block_n = triton.next_power_of_2(n)
+    if residual is None:
+        _rmsnorm_kernel[(m,)](x2, weight, out, x2, x2, n, x2.stride(0), 0, eps,
+                              HAS_RESIDUAL=False, BLOCK_N=block_n, num_warps=_num_warps(block_n))
+        return out.reshape(x.shape)
+    r2 = residual.reshape(-1, n)
+    res_out = torch.empty((m, n), dtype=out_dtype, device=x.device)
+    _rmsnorm_kernel[(m,)](x2, weight, out, r2, res_out, n, x2.stride(0), r2.stride(0), eps,
+                          HAS_RESIDUAL=True, BLOCK_N=block_n, num_warps=_num_warps(block_n))
+    return out.reshape(x.shape), res_out.reshape(x.shape)
