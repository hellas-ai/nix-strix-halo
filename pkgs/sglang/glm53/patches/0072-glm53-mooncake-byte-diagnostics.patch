+    def _diagnostic_transfer_bytes(self, phase: str, transfer: PoolTransfer) -> None:
+        """Opt-in content-free hashes of the exact device spans passed to I/O.
+
+        Construct uint8 views into registered Torch storage, never dereference
+        a GPU pointer from Python or copy an entire pool. The worker calls this
+        after its producer event; restore calls it after synchronous I/O returns.
+        """
+        if not getattr(self, "verify_bytes", False):
+            return
+        pool = self.pools[transfer.name]
+        keys, _ = self.storage._get_hybrid_page_component_keys(
+            list(transfer.keys), transfer
+        )
+        keys = self.storage._tag_keys(keys)
+        pointers, sizes = pool.get_page_buffer_meta(transfer.host_indices)
+        if len(pointers) != len(keys):
+            pointers, sizes = self.storage._pack_multi_buffer_meta(keys, pointers, sizes)
+        if not (len(keys) == len(pointers) == len(sizes)):
+            raise ValueError("Diagnostic object metadata cardinality mismatch")
+        allocations = {}
+        for buffer in pool.get_hybrid_pool_buffer():
+            storage = buffer.untyped_storage()
+            base, size = int(storage.data_ptr()), int(storage.nbytes())
+            allocations[(base, size)] = (storage, buffer.device)
+        for ordinal, (key, ptrs, lens) in enumerate(zip(keys, pointers, sizes)):
+            if isinstance(ptrs, int):
+                ptrs, lens = [ptrs], [lens]
+            if len(ptrs) != len(lens):
+                raise ValueError("Diagnostic span metadata cardinality mismatch")
+            digest = hashlib.sha256()
+            for pointer, size in zip(ptrs, lens):
+                matches = [(base, storage, device)
+                           for (base, capacity), (storage, device) in allocations.items()
+                           if base <= pointer and pointer + size <= base + capacity]
+                if len(matches) != 1:
+                    raise ValueError("Diagnostic pointer is outside registered storage")
+                base, storage, device = matches[0]
+                span = torch.empty(0, dtype=torch.uint8, device=device).set_(
+                    storage, pointer - base, (size,), (1,)
+                )
+                digest.update(span.cpu().numpy().tobytes())
+            logger.info("Mooncake direct byte verification: %s", json.dumps({
+                "phase": phase, "pool": str(transfer.name), "object": ordinal,
+                "key_sha256": hashlib.sha256(key.encode()).hexdigest(),
+                "bytes": sum(lens), "segments": len(lens),
+                "sha256": digest.hexdigest(),
+                "indices": int(transfer.host_indices.numel()),
+            }, sort_keys=True, separators=(",", ":")))
 
