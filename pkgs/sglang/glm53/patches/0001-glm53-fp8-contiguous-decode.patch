+@triton.jit
+def widen_e4m3fn_to_fp32(x):
+    bits = x.to(tl.uint8, bitcast=True).to(tl.uint32)
+    magnitude = bits & 0x7F
+    normal = (magnitude << 20) + 0x3C000000
+    subnormal = ((magnitude & 7).to(tl.float32) * 0.001953125).to(
+        tl.uint32, bitcast=True
+    )
+    value = tl.where(magnitude < 8, subnormal, normal)
+    value = tl.where(magnitude == 0x7F, 0x7FC00000, value).to(tl.uint32)
+    value = value | ((bits & 0x80) << 24)
+    return value.to(tl.float32, bitcast=True)
+
