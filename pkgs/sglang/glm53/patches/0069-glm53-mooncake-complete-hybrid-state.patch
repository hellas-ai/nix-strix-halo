+class PackedDSADevicePoolEntry(DevicePoolEntry):
+    """One logical object spanning independently allocated physical KV pages.
+
+    A compressed index page belongs to the first physical token page in each
+    ``physical_page_size * index_kpool`` logical span. Never assume the physical
+    pages within a logical radix page are adjacent in memory.
+    """
+
+    def __init__(self, *, logical_page_size, physical_page_size, index_kpool=1,
+                 indexer=False, **kwargs):
+        super().__init__(page_size=physical_page_size, rows_are_pages=indexer,
+                         **kwargs)
+        self.page_size = logical_page_size
+        self.physical_page_size = physical_page_size
+        self.index_kpool = index_kpool
+        self.indexer = indexer
+        if logical_page_size % (physical_page_size * index_kpool):
+            raise ValueError("Packed DSA linker requires whole packed-index spans")
+
+    def get_page_buffer_meta(self, indices):
+        slots = indices.detach().to(device="cpu", dtype=torch.int64).flatten()
+        if slots.numel() % self.page_size:
+            raise ValueError("Packed DSA linker requires complete logical pages")
+        physical = slots.reshape(-1, self.physical_page_size)
+        starts = physical[:, 0]
+        if torch.any(starts.remainder(self.physical_page_size)) or not torch.equal(
+            physical, starts[:, None] + self._page_offsets
+        ):
+            raise ValueError("Packed DSA linker requires aligned physical pages")
+        pages = starts.reshape(-1, self.page_size // self.physical_page_size)
+        if self.indexer:
+            pages = pages[:, ::self.index_kpool] // self.physical_page_size
+        ptrs, sizes = [], []
+        for rows in pages.tolist():
+            for component in self.buffer_meta:
+                for base, stride, size in component:
+                    for row in rows:
+                        if row < 0 or row + self._row_span > self._row_count:
+                            raise ValueError("Packed DSA linker row outside allocation")
+                        ptrs.append(base + row * stride)
+                        sizes.append(size)
+        return ptrs, sizes
+
+    def prepare_locations(self, indices):
+        raise RuntimeError("Packed DSA requires transactional whole-object restore")
+
