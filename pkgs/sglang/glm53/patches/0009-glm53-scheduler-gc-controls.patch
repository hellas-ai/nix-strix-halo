+def _glm53_scheduler_gc_setup(tp_rank: int) -> None:
+    """Opt-in GC controls for scheduler processes (spawned, so --gc-threshold in the launcher does not reach them).
+
+    SGLANG_GLM53_GC_THRESHOLD="a,b,c" sets gc thresholds here; SGLANG_GLM53_GC_LOG_SECS=s logs every collection that
+    takes longer than s seconds with its generation and the object counts.
+    """
+    import gc as _gc
+    import time as _time
+
+    threshold = os.environ.get("SGLANG_GLM53_GC_THRESHOLD")
+    if threshold:
+        _gc.set_threshold(*[int(v) for v in threshold.split(",")])
+        logger.info(f"TP{tp_rank} scheduler gc thresholds {_gc.get_threshold()}")
+    log_secs = os.environ.get("SGLANG_GLM53_GC_LOG_SECS")
+    if log_secs:
+        limit = float(log_secs)
+        start = {}
+
+        def _cb(phase, info):
+            gen = info.get("generation")
+            if phase == "start":
+                start[gen] = _time.perf_counter()
+            elif phase == "stop" and gen in start:
+                took = _time.perf_counter() - start.pop(gen)
+                if took > limit:
+                    logger.warning(
+                        f"TP{tp_rank} scheduler gc gen{gen} took {took:.3f}s collected={info.get('collected')} "
+                        f"counts={_gc.get_count()} frozen={_gc.get_freeze_count()}"
+                    )
+
+        _gc.callbacks.append(_cb)
+
+
 def run_scheduler_process(
     server_args: ServerArgs,
     port_args: PortArgs,
