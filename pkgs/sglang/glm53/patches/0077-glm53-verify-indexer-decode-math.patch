+    def _get_verify_logits_head_gate(self, x, q_scale, width):
+        if not is_hip() or __import__("os").environ.get("SGLANG_GLM53_VERIFY_DECODE_MATH", "0") != "1":
+            return self._get_logits_head_gate(x, q_scale)
+        # Keep the FP32 projection's reduction geometry equal to DECODE.
+        # Rows are request-major; process each speculative position across the
+        # same request batch, then restore request-major order. Call the existing
+        # compiled gate on contiguous inputs, just as ordinary decode does.
+        assert width > 0 and x.shape[0] % width == 0
+        if width == 1:
+            return self._get_logits_head_gate(x, q_scale)
+        gates = [self._get_logits_head_gate(
+            x[step::width].contiguous(), q_scale[step::width].contiguous())
+            for step in range(width)]
+        return torch.stack(gates, dim=1).flatten(0, 1)
 
