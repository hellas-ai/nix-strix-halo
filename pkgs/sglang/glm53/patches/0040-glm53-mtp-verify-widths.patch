+GLM53_MTP_VERIFY_WIDTHS_ENV = "SGLANG_GLM53_MTP_VERIFY_WIDTHS"
+
+
+def glm53_mtp_verify_widths() -> list[int] | None:
+    """GLM-5.3 campaign (0040): fixed verify width per running-request count.
+
+    ``SGLANG_GLM53_MTP_VERIFY_WIDTHS="4,4,2,2"`` verifies 4 tokens per request
+    (3 chained MTP drafts) while one or two requests decode, 2 tokens (1 draft)
+    at three or four; batch sizes past the list reuse its last entry. Width 1
+    verifies only the bonus token (no drafting; draft-extend keeps the MTP KV
+    warm). Each width is a static adaptive-spec slot (steps = width - 1, one
+    candidate per slot, so the EMA never moves it); unset keeps the stock path.
+    """
+    raw = os.environ.get(GLM53_MTP_VERIFY_WIDTHS_ENV, "").strip()
+    if not raw:
+        return None
+    try:
+        widths = [int(part) for part in raw.split(",") if part.strip()]
+    except ValueError as e:
+        raise ValueError(
+            f"{GLM53_MTP_VERIFY_WIDTHS_ENV}={raw!r}: expected comma-separated "
+            "positive integers, one verify width per batch size 1, 2, ..."
+        ) from e
+    if not widths or any(width < 1 for width in widths):
+        raise ValueError(
+            f"{GLM53_MTP_VERIFY_WIDTHS_ENV}={raw!r}: widths must be >= 1"
+        )
+    return widths
+
+
+def _glm53_static_width_config(widths: list[int]) -> dict[str, dict]:
+    return {
+        str(batch_size): {
+            "candidate_steps": [width - 1],
+            "up_hysteresis": 0.0,
+            "down_hysteresis": 0.0,
+            "ceiling_coeff": 0,
+        }
+        for batch_size, width in enumerate(widths, start=1)
+    }
+
+
