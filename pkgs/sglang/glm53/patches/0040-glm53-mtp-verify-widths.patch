+def _maybe_enable_glm53_verify_widths(server_args: ServerArgs) -> None:
+    """GLM-5.3 campaign (0040): SGLANG_GLM53_MTP_VERIFY_WIDTHS turns on the adaptive
+    runtime-state machinery with one fixed verify width per batch size (see
+    adaptive_spec_params.glm53_mtp_verify_widths). The widest entry sizes every
+    pool and the scheduler's KV reservation, so it must be the startup state."""
+    from sglang.srt.speculative.adaptive_spec_params import (
+        GLM53_MTP_VERIFY_WIDTHS_ENV,
+        glm53_mtp_verify_widths,
+    )
+
+    widths = glm53_mtp_verify_widths()
+    cfg = resolving_view(server_args)
+    if widths is None or cfg.speculative_algorithm is None:
+        return
+    if cfg.speculative_algorithm != "EAGLE":
+        logger.warning(
+            "%s applies to NEXTN/EAGLE only; ignored for speculative_algorithm=%s",
+            GLM53_MTP_VERIFY_WIDTHS_ENV,
+            cfg.speculative_algorithm,
+        )
+        return
+    if cfg.speculative_adaptive_config is not None:
+        raise ValueError(
+            f"{GLM53_MTP_VERIFY_WIDTHS_ENV} and --speculative-adaptive-config are "
+            "mutually exclusive"
+        )
+    max_steps = max(widths) - 1
+    if cfg.speculative_num_steps is None:
+        declare_resolution(
+            server_args,
+            "_maybe_enable_glm53_verify_widths",
+            speculative_num_steps=max_steps,
+        )
+    elif cfg.speculative_num_steps != max_steps:
+        raise ValueError(
+            f"{GLM53_MTP_VERIFY_WIDTHS_ENV}={widths}: the widest verify ({max(widths)}) "
+            f"must equal --speculative-num-steps + 1 "
+            f"({cfg.speculative_num_steps} + 1): it sizes the pools and KV reservation"
+        )
+    if (
+        cfg.speculative_num_draft_tokens is not None
+        and cfg.speculative_num_draft_tokens != max_steps + 1
+    ):
+        raise ValueError(
+            f"{GLM53_MTP_VERIFY_WIDTHS_ENV}={widths} needs "
+            f"--speculative-num-draft-tokens {max_steps + 1} (got "
+            f"{cfg.speculative_num_draft_tokens})"
+        )
+    if cfg.speculative_eagle_topk not in (None, 1):
+        raise ValueError(f"{GLM53_MTP_VERIFY_WIDTHS_ENV} requires --speculative-eagle-topk 1")
+    declare_resolution(
+        server_args,
+        "_maybe_enable_glm53_verify_widths",
+        speculative_adaptive=True,
+    )
+    logger.info(
+        "GLM-5.3 MTP verify width per running-request count %s (steps %s)",
+        widths,
+        [width - 1 for width in widths],
+    )
+
