+@triton.jit
+def _gfx1151_block_fp8_gemv_rows(
+    A,
+    B,
+    C,
+    As,
+    Bs,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    KG: tl.constexpr,
+):
+    # One independent vector program per token: exactly the decode K reduction
+    # and scale order, with only input/output row addresses changed.
+    token = tl.program_id(1)
+    A += token * K
+    As += token * (K // 128)
+    C += token * N
+    rows = tl.program_id(0) * BLOCK_N + tl.arange(0, BLOCK_N)
+    offsets = tl.arange(0, KG * 128)
+    groups = tl.arange(0, KG)
+    acc = tl.zeros((BLOCK_N,), tl.float32)
+    for start in range(0, K // 128, KG):
+        k = start * 128 + offsets
+        a = tl.load(A + k)
+        b = tl.load(B + rows[:, None] * K + k[None, :])
+        a = widen_e4m3fn_to_fp32(a)
+        b = widen_e4m3fn_to_fp32(b)
+        a = a.to(tl.float32).reshape(KG, 128)
+        b = b.to(tl.float32).reshape(BLOCK_N, KG, 128)
+        dots = tl.sum(a[None, :, :] * b, axis=2)
+        scales_a = tl.load(As + start + groups)
+        scales_b = tl.load(
+            Bs + (rows // 128)[:, None] * (K // 128) + start + groups[None, :]
+        )
+        for g in tl.static_range(KG):
+            dot = tl.gather(dots, tl.full((BLOCK_N, 1), g, tl.int32), axis=1).reshape(
+                BLOCK_N
+            )
+            scale_a = tl.sum(tl.where(groups == g, scales_a, 0), axis=0)
+            scale_b = tl.gather(
+                scales_b, tl.full((BLOCK_N, 1), g, tl.int32), axis=1
+            ).reshape(BLOCK_N)
+            acc += dot * scale_a * scale_b
+    tl.store(C + rows, acc.to(C.dtype.element_ty))
+
+
